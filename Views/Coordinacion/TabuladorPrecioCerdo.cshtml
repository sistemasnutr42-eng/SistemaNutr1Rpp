                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button id="btnGuardarConfiguracion"
                        type="button"
                        class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Guardar nueva versión
                </button>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            const formCalculo =
                document.getElementById("formCalculo");

            const btnCalcular =
                document.getElementById("btnCalcular");

            const btnGuardarCotizacion =
                document.getElementById("btnGuardarCotizacion");

            const btnGuardarConfiguracion =
                document.getElementById("btnGuardarConfiguracion");

            const messageBox =
                document.getElementById("messageBox");

            const tbodyTabulador =
                document.getElementById("tbodyTabulador");

            let ultimoResultado = null;

            function numero(valor) {
                if (valor === null ||
                    valor === undefined ||
                    valor === "")
                    return null;

                const n = Number(valor);

                return Number.isFinite(n)
                    ? n
                    : null;
            }

            function dinero(valor) {
                if (valor === null ||
                    valor === undefined ||
                    !Number.isFinite(Number(valor)))
                    return "—";

                return new Intl.NumberFormat(
                    "es-MX",
                    {
                        style: "currency",
                        currency: "MXN",
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                ).format(Number(valor));
            }

            function numeroFormato(
                valor,
                decimales = 2) {

                if (valor === null ||
                    valor === undefined ||
                    !Number.isFinite(Number(valor)))
                    return "—";

                return new Intl.NumberFormat(
                    "es-MX",
                    {
                        minimumFractionDigits: decimales,
                        maximumFractionDigits: decimales
                    }
                ).format(Number(valor));
            }

            function mostrarMensaje(
                mensaje,
                tipo) {

                if (!messageBox)
                    return;

                messageBox.textContent =
                    mensaje;

                messageBox.className =
                    `message-box ${tipo === "success"
                        ? "success"
                        : "error"} show`;

                window.setTimeout(() => {
                    messageBox.classList.remove("show");
                }, 5000);
            }

            function tokenDe(form) {
                return form
                    ?.querySelector(
                        'input[name="__RequestVerificationToken"]')
                    ?.value ?? "";
            }

            function construirPayloadCalculo() {
                return {
                    pedidoID:
                        numero(
                            document.getElementById("PedidoID")?.value),

                    pedidoDetalleID:
                        numero(
                            document.getElementById("PedidoDetalleID")?.value),

                    fechaCotizacion:
                        document.getElementById("FechaCotizacion")
                            ?.value || null,

                    numeroCerdos:
                        numero(
                            document.getElementById("NumeroCerdos")?.value)
                        || 0,

                    pesoOfrecidoKg:
                        numero(
                            document.getElementById("PesoOfrecidoKg")?.value)
                        || 0,

                    pesoRealKg:
                        numero(
                            document.getElementById("PesoRealKg")?.value),

                    numeroCerdosReales:
                        numero(
                            document.getElementById("NumeroCerdosReales")?.value),

                    fleteTotal:
                        numero(
                            document.getElementById("FleteTotal")?.value)
                        || 0
                };
            }

            function mostrarResultado(resultado) {
                ultimoResultado =
                    resultado;

                const pesoOfrecido =
                    Number(resultado.pesoOfrecidoKg ?? 0);

                const pesoReal =
                    resultado.pesoRealKg !== null &&
                        resultado.pesoRealKg !== undefined
                        ? Number(resultado.pesoRealKg)
                        : null;

                const diferenciaPeso =
                    pesoReal !== null
                        ? pesoReal - pesoOfrecido
                        : null;

                const precioOfrecido =
                    Number(
                        resultado.precioDestinoCalculadoKg ?? 0);

                const precioAjustadoDestino =
                    resultado.precioDestinoRealKg !== null &&
                        resultado.precioDestinoRealKg !== undefined
                        ? Number(resultado.precioDestinoRealKg)
                        : precioOfrecido;

                const precioAjustadoOrigen =
                    resultado.precioOrigenRealKg !== null &&
                        resultado.precioOrigenRealKg !== undefined
                        ? Number(resultado.precioOrigenRealKg)
                        : Number(
                            resultado.precioOrigenCalculadoKg ?? 0);

                const kilosEstimados =
                    Number(resultado.kilosEstimados ?? 0);

                const ajusteTotal =
                    (precioAjustadoDestino -
                        precioOfrecido) *
                    kilosEstimados;

                document.getElementById(
                    "rPesoOfrecido").textContent =
                    `${numeroFormato(
                        pesoOfrecido,
                        2)} kg`;

                document.getElementById(
                    "rPesoReal").textContent =
                    pesoReal !== null
                        ? `${numeroFormato(
                            pesoReal,
                            2)} kg`
                        : "—";

                document.getElementById(
                    "rDiferenciaPeso").textContent =
                    diferenciaPeso !== null
                        ? `${diferenciaPeso > 0 ? "+" : ""}${numeroFormato(
                            diferenciaPeso,
                            2)} kg`
                        : "—";

                document.getElementById(
                    "rPrecioOfrecidoDestino").textContent =
                    dinero(precioOfrecido);

                document.getElementById(
                    "rPrecioAjustadoDestino").textContent =
                    dinero(precioAjustadoDestino);

                document.getElementById(
                    "rPrecioAjustadoOrigen").textContent =
                    dinero(precioAjustadoOrigen);

                document.getElementById(
                    "rKilosEstimados").textContent =
                    `${numeroFormato(
                        resultado.kilosEstimados,
                        3)} kg`;

                document.getElementById(
                    "rFleteCerdo").textContent =
                    dinero(
                        resultado.fletePorCerdo);

                document.getElementById(
                    "rFleteKg").textContent =
                    dinero(
                        resultado.fletePorKgEstimado);

                document.getElementById(
                    "rImporteDestino").textContent =
                    dinero(
                        resultado.importeDestinoEstimado);

                document.getElementById(
                    "rImporteOrigen").textContent =
                    dinero(
                        resultado.importeOrigenEstimado);

                document.getElementById(
                    "rAjusteTotal").textContent =
                    `${ajusteTotal > 0 ? "+" : ""}${dinero(
                        ajusteTotal)}`;

                const cardAjuste =
                    document.getElementById(
                        "cardAjusteTotal");

                if (cardAjuste) {
                    cardAjuste.classList.remove(
                        "negative",
                        "warning",
                        "adjusted");

                    cardAjuste.classList.add(
                        ajusteTotal < 0
                            ? "negative"
                            : ajusteTotal > 0
                                ? "adjusted"
                                : "warning");
                }

                document.getElementById(
                    "rPrecioMercado").textContent =
                    dinero(
                        resultado.precioMercadoKg);

                document.getElementById(
                    "rDiferenciaMercado").textContent =
                    resultado.diferenciaVsMercadoKg !== null &&
                        resultado.diferenciaVsMercadoKg !== undefined
                        ? `${resultado.diferenciaVsMercadoKg > 0
                            ? "+"
                            : ""}${dinero(
                                resultado.diferenciaVsMercadoKg)}`
                        : "—";

                document.getElementById(
                    "rDiferenciaMercadoPct").textContent =
                    resultado.diferenciaVsMercadoPorcentaje !== null &&
                        resultado.diferenciaVsMercadoPorcentaje !== undefined
                        ? `${resultado.diferenciaVsMercadoPorcentaje > 0
                            ? "+"
                            : ""}${numeroFormato(
                                resultado.diferenciaVsMercadoPorcentaje,
                                2)}%`
                        : "—";

                const marketStatus =
                    document.getElementById(
                        "marketStatus");

                if (resultado.precioMercadoKg === null ||
                    resultado.precioMercadoKg === undefined) {

                    marketStatus.className =
                        "market-status neutral";

                    marketStatus.textContent =
                        "No existe precio de mercado disponible para comparar.";
                }
                else if (
                    resultado.diferenciaVsMercadoKg < 0) {

                    marketStatus.className =
                        "market-status negative";

                    marketStatus.textContent =
                        `El precio ajustado está ${dinero(
                            Math.abs(
                                resultado.diferenciaVsMercadoKg)
                        )}/kg por debajo del mercado.`;
                }
                else if (
                    resultado.diferenciaVsMercadoKg > 0) {

                    marketStatus.className =
                        "market-status positive";

                    marketStatus.textContent =
                        `El precio ajustado está ${dinero(
                            resultado.diferenciaVsMercadoKg
                        )}/kg por arriba del mercado.`;
                }
                else {
                    marketStatus.className =
                        "market-status neutral";

                    marketStatus.textContent =
                        "El precio ajustado coincide con el precio de mercado.";
                }

                if (btnGuardarCotizacion)
                    btnGuardarCotizacion.disabled =
                        false;
            }

            function renderFilas(filas) {
                if (!tbodyTabulador)
                    return;

                tbodyTabulador.innerHTML =
                    "";

                (filas || []).forEach(fila => {
                    const tr =
                        document.createElement("tr");

                    if (fila.esPesoBase)
                        tr.classList.add(
                            "base-row");

                    const diferenciaMercado =
                        fila.diferenciaDestinoMercadoKg;

                    const claseMercado =
                        diferenciaMercado === null ||
                            diferenciaMercado === undefined
                            ? "diff-neutral"
                            : diferenciaMercado > 0
                                ? "diff-positive"
                                : diferenciaMercado < 0
                                    ? "diff-negative"
                                    : "diff-neutral";

                    const claseAjuste =
                        fila.ajusteTotal > 0
                            ? "diff-positive"
                            : fila.ajusteTotal < 0
                                ? "diff-negative"
                                : "diff-neutral";

                    tr.innerHTML = `
                                <td>
                                    <strong>
                                        ${numeroFormato(fila.pesoKg, 2)} kg
                                    </strong>
                                    ${fila.esPesoBase
                            ? '<span class="badge-base">BASE</span>'
                            : ''}
                                </td>

                                <td>
                                    ${fila.diferenciaPesoKg > 0 ? "+" : ""}
                                    ${numeroFormato(fila.diferenciaPesoKg, 2)}
                                </td>

                                <td class="${claseAjuste}">
                                    ${fila.ajusteTotal > 0 ? "+" : ""}
                                    ${dinero(fila.ajusteTotal)}
                                </td>

                                <td class="price-cell">
                                    ${dinero(fila.precioDestinoKg)}
                                </td>

                                <td class="price-cell">
                                    ${dinero(fila.precioOrigenKg)}
                                </td>

                                <td>
                                    ${dinero(fila.precioMercadoKg)}
                                </td>

                                <td class="${claseMercado}">
                                    ${diferenciaMercado === null ||
                            diferenciaMercado === undefined
                            ? "—"
                            : `${diferenciaMercado > 0
                                ? "+"
                                : ""}${dinero(
                                    diferenciaMercado)}`}
                                </td>
                            `;

                    tbodyTabulador.appendChild(
                        tr);
                });
            }

            formCalculo?.addEventListener(
                "submit",
                async event => {

                    event.preventDefault();

                    const payload =
                        construirPayloadCalculo();

                    if (payload.numeroCerdos <= 0) {
                        mostrarMensaje(
                            "El número de cerdos debe ser mayor a cero.",
                            "error");
                        return;
                    }

                    if (payload.pesoOfrecidoKg <= 0) {
                        mostrarMensaje(
                            "El peso ofrecido debe ser mayor a cero.",
                            "error");
                        return;
                    }

                    const original =
                        btnCalcular.innerHTML;

                    btnCalcular.disabled =
                        true;

                    btnCalcular.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Calculando...';

                    try {
                        const response =
                            await fetch(
                                '@Url.Action("CalcularTabuladorPrecioCerdo", "Coordinacion")',
                                {
                                    method: "POST",
                                    credentials: "same-origin",
                                    headers: {
                                        "Content-Type": "application/json",
                                        "RequestVerificationToken":
                                            tokenDe(formCalculo)
                                    },
                                    body: JSON.stringify(
                                        payload)
                                });

                        let data = null;

                        try {
                            data =
                                await response.json();
                        }
                        catch {
                        }

                        if (!response.ok ||
                            !data?.ok) {

                            throw new Error(
                                data?.mensaje ??
                                "No fue posible realizar el cálculo.");
                        }

                        mostrarResultado(
                            data.resultado);

                        renderFilas(
                            data.filas);
                    }
                    catch (error) {
                        mostrarMensaje(
                            error?.message ??
                            "Ocurrió un error al calcular.",
                            "error");
                    }
                    finally {
                        btnCalcular.disabled =
                            false;

                        btnCalcular.innerHTML =
                            original;
                    }
                });

            btnGuardarCotizacion?.addEventListener(
                "click",
                async () => {

                    if (!ultimoResultado) {
                        mostrarMensaje(
                            "Primero realiza el cálculo de la cotización.",
                            "error");
                        return;
                    }

                    const payloadBase =
                        construirPayloadCalculo();

                    const payload = {
                        pedidoID:
                            payloadBase.pedidoID,

                        pedidoDetalleID:
                            payloadBase.pedidoDetalleID,

                        cotizacionRastroID:
                            numero(
                                document.getElementById(
                                    "CotizacionRastroID")?.value),

                        tabuladorPrecioCerdoID:
                            ultimoResultado
                                .tabuladorPrecioCerdoID,

                        fechaCotizacion:
                            payloadBase.fechaCotizacion,

                        numeroCerdos:
                            payloadBase.numeroCerdos,

                        pesoOfrecidoKg:
                            payloadBase.pesoOfrecidoKg,

                        pesoRealKg:
                            payloadBase.pesoRealKg,

                        fleteTotal:
                            payloadBase.fleteTotal,

                        numeroCerdosReales:
                            payloadBase.numeroCerdosReales,

                        observaciones:
                            document.getElementById(
                                "Observaciones")
                                ?.value
                                ?.trim() || null,

                        guardarCotizacion: true
                    };

                    const original =
                        btnGuardarCotizacion.innerHTML;

                    btnGuardarCotizacion.disabled =
                        true;

                    btnGuardarCotizacion.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';

                    try {
                        const response =
                            await fetch(
                                '@Url.Action("GuardarCotizacionRastro", "Coordinacion")',
                                {
                                    method: "POST",
                                    credentials: "same-origin",
                                    headers: {
                                        "Content-Type": "application/json",
                                        "RequestVerificationToken":
                                            tokenDe(formCalculo)
                                    },
                                    body: JSON.stringify(
                                        payload)
                                });

                        let data = null;

                        try {
                            data =
                                await response.json();
                        }
                        catch {
                        }

                        if (!response.ok ||
                            !data?.ok) {

                            throw new Error(
                                data?.mensaje ??
                                "No fue posible guardar la cotización.");
                        }

                        mostrarMensaje(
                            data.mensaje ??
                            "Cotización guardada correctamente.",
                            "success");

                        if (data.cotizacionRastroID) {
                            document.getElementById(
                                "CotizacionRastroID").value =
                                data.cotizacionRastroID;
                        }
                    }
                    catch (error) {
                        mostrarMensaje(
                            error?.message ??
                            "Ocurrió un error al guardar.",
                            "error");
                    }
                    finally {
                        btnGuardarCotizacion.disabled =
                            false;

                        btnGuardarCotizacion.innerHTML =
                            original;
                    }
                });

            btnGuardarConfiguracion?.addEventListener(
                "click",
                async () => {

                    const form =
                        document.getElementById(
                            "formConfiguracion");

                    const payload = {
                        tabuladorPrecioCerdoID: null,

                        codigo:
                            document.getElementById(
                                "CfgCodigo")
                                ?.value
                                ?.trim() || "",

                        nombre:
                            document.getElementById(
                                "CfgNombre")
                                ?.value
                                ?.trim() || "",

                        vigenciaDesde:
                            document.getElementById(
                                "CfgVigenciaDesde")
                                ?.value || null,

                        vigenciaHasta:
                            document.getElementById(
                                "CfgVigenciaHasta")
                                ?.value || null,

                        pesoBaseKg:
                            numero(
                                document.getElementById(
                                    "CfgPesoBase")?.value)
                            || 0,

                        precioBaseDestinoKg:
                            numero(
                                document.getElementById(
                                    "CfgPrecioBase")?.value)
                            || 0,

                        ajustePorKg:
                            numero(
                                document.getElementById(
                                    "CfgAjuste")?.value)
                            || 0,

                        pesoMinimoKg:
                            numero(
                                document.getElementById(
                                    "CfgPesoMinimo")?.value)
                            || 0,

                        pesoMaximoKg:
                            numero(
                                document.getElementById(
                                    "CfgPesoMaximo")?.value)
                            || 0,

                        ajustarSobrePesoBase: false,

                        monedaCodigo: "MXN",

                        activo: true
                    };

                    const original =
                        btnGuardarConfiguracion.innerHTML;

                    btnGuardarConfiguracion.disabled =
                        true;

                    btnGuardarConfiguracion.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin me-1"></i> Guardando...';

                    try {
                        const response =
                            await fetch(
                                '@Url.Action("GuardarConfiguracionTabuladorPrecioCerdo", "Coordinacion")',
                                {
                                    method: "POST",
                                    credentials: "same-origin",
                                    headers: {
                                        "Content-Type": "application/json",
                                        "RequestVerificationToken":
                                            tokenDe(form)
                                    },
                                    body: JSON.stringify(
                                        payload)
                                });

                        let data = null;

                        try {
                            data =
                                await response.json();
                        }
                        catch {
                        }

                        if (!response.ok ||
                            !data?.ok) {

                            throw new Error(
                                data?.mensaje ??
                                "No fue posible guardar la configuración.");
                        }

                        mostrarMensaje(
                            data.mensaje ??
                            "Configuración guardada correctamente.",
                            "success");

                        const modal =
                            bootstrap.Modal.getInstance(
                                document.getElementById(
                                    "modalConfiguracion"));

                        modal?.hide();

                        window.setTimeout(() => {
                            window.location.reload();
                        }, 700);
                    }
                    catch (error) {
                        mostrarMensaje(
                            error?.message ??
                            "Ocurrió un error al guardar la configuración.",
                            "error");
                    }
                    finally {
                        btnGuardarConfiguracion.disabled =
                            false;

                        btnGuardarConfiguracion.innerHTML =
                            original;
                    }
                });

        })();
    </script>
}