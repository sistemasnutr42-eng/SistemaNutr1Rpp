@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Text.Json
@model SistemaNutri.Models.CoordinacionPrecioMercadoCerdoPaginaVm

@{
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
    ViewData["Title"] = "Precio de mercado del cerdo";

    var precioActual = Model?.PrecioActual;
    var captura = Model?.Captura ?? new SistemaNutri.Models.CoordinacionPrecioMercadoCerdoCapturaVm
    {
        Fecha = DateTime.Today
    };

    var resumen = Model?.Resumen ?? new SistemaNutri.Models.CoordinacionPrecioMercadoCerdoResumenVm
    {
        Anio = DateTime.Today.Year
    };

    var filtros = Model?.Filtros ?? new SistemaNutri.Models.CoordinacionPrecioMercadoCerdoFiltroVm
    {
        Anio = DateTime.Today.Year
    };

    var historico = Model?.Historico
        ?? new List<SistemaNutri.Models.CoordinacionPrecioMercadoCerdoHistoricoVm>();

    var historicoReciente = historico
        .OrderByDescending(x => x.Fecha)
        .Take(10)
        .ToList();

    var datosGrafica = historico
        .OrderBy(x => x.Fecha)
        .Select(x => new
        {
            fecha = x.Fecha.ToString("yyyy-MM-dd"),
            etiqueta = x.Fecha.ToString("dd/MM"),
            precio = x.PrecioKg
        })
        .ToList();

    var jsonGrafica = JsonSerializer.Serialize(datosGrafica);

    var existePrecioHoy =
        precioActual != null &&
        precioActual.EsPrecioDelDia;

    var fechaPrecioActual = precioActual?.Fecha;

    var variacionAnual = resumen.VariacionAnual;
    var variacionAnualPorcentaje = resumen.VariacionAnualPorcentaje;

    string ClaseVariacion(decimal? valor)
    {
        if (!valor.HasValue || valor.Value == 0)
            return "neutral";

        return valor.Value > 0 ? "positive" : "negative";
    }

    string IconoVariacion(decimal? valor)
    {
        if (!valor.HasValue || valor.Value == 0)
            return "fa-minus";

        return valor.Value > 0
            ? "fa-arrow-trend-up"
            : "fa-arrow-trend-down";
    }
}

