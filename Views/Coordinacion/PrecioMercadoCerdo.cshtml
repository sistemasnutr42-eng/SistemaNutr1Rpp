<div class="price-page">

    <div class="price-header">
        <div class="price-header-main">
            <div class="price-eyebrow">
                <i class="fa-solid fa-piggy-bank"></i>
                Coordinación · Rastro · Precios
            </div>

            <h1 class="price-title">Precio de mercado del cerdo</h1>

            <p class="price-subtitle">
                Captura el precio diario obtenido por llamada, consulta su evolución
                y conserva el histórico utilizado como referencia para Rastro.
            </p>
        </div>

        <div class="header-actions">
            <a asp-controller="Coordinacion"
               asp-action="PedidosRastro"
               class="btn-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                Rastro
            </a>

            <a asp-controller="Coordinacion"
               asp-action="HistoricoPrecioMercadoCerdo"
               asp-route-anio="@resumen.Anio"
               class="btn-primary">
                <i class="fa-solid fa-clock-rotate-left"></i>
                Histórico completo
            </a>
        </div>
    </div>

    @if (precioActual == null)
    {
        <div class="status-banner warning">
            <div class="status-main">
                <div class="status-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div>
                    <h2 class="status-title">
                        No existe precio de mercado registrado
                    </h2>

                    <p class="status-text">
                        Captura el primer precio diario para comenzar el histórico.
                    </p>
                </div>
            </div>
        </div>
    }
    else if (!existePrecioHoy)
    {
        <div class="status-banner warning">
            <div class="status-main">
                <div class="status-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>

                <div>
                    <h2 class="status-title">
                        Precio de hoy pendiente de actualizar
                    </h2>

                    <p class="status-text">
                        El último precio disponible corresponde al
                        <strong>@precioActual.Fecha.ToString("dd/MM/yyyy")</strong>.
                        Captura el precio de hoy cuando se realice la llamada.
                    </p>
                </div>
            </div>

            <div class="status-price">
                @precioActual.PrecioKg.ToString("C2")
                <small style="font-size:.7rem;font-weight:700;">/kg</small>
            </div>
        </div>
    }
    else
    {
        <div class="status-banner success">
            <div class="status-main">
                <div class="status-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <div>
                    <h2 class="status-title">
                        Precio del día actualizado
                    </h2>

                    <p class="status-text">
                        Registrado para hoy,
                        <strong>@precioActual.Fecha.ToString("dd/MM/yyyy")</strong>.
                        @if (!string.IsNullOrWhiteSpace(precioActual.ContactoReferencia))
                        {
                            <span>
                                Referencia:
                                <strong>@precioActual.ContactoReferencia</strong>.
                            </span>
                        }
                    </p>
                </div>
            </div>

            <div class="status-price">
                @precioActual.PrecioKg.ToString("C2")
                <small style="font-size:.7rem;font-weight:700;">/kg</small>
            </div>
        </div>
    }

    <section class="summary-grid">

        <div class="summary-card">
            <div class="summary-label">
                <i class="fa-solid fa-calendar-day"></i>
                Precio actual
            </div>

            <div class="summary-value">
                @(precioActual != null
                    ? precioActual.PrecioKg.ToString("C2")
                    : "—")
            </div>

            <div class="summary-note">
                @(precioActual != null
                    ? precioActual.Fecha.ToString("dd/MM/yyyy")
                    : "Sin información")
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">
                <i class="fa-solid fa-arrow-down"></i>
                Mínimo @resumen.Anio
            </div>

            <div class="summary-value">
                @(resumen.PrecioMinimo?.ToString("C2") ?? "—")
            </div>

            <div class="summary-note">
                Menor precio registrado
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">
                <i class="fa-solid fa-arrow-up"></i>
                Máximo @resumen.Anio
            </div>

            <div class="summary-value">
                @(resumen.PrecioMaximo?.ToString("C2") ?? "—")
            </div>

            <div class="summary-note">
                Mayor precio registrado
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">
                <i class="fa-solid fa-chart-simple"></i>
                Promedio @resumen.Anio
            </div>

            <div class="summary-value">
                @(resumen.PrecioPromedio?.ToString("C2") ?? "—")
            </div>

            <div class="summary-note">
                @resumen.DiasCapturados días registrados
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">
                <i class="fa-solid @IconoVariacion(variacionAnual)"></i>
                Variación anual
            </div>

            <div class="summary-value @ClaseVariacion(variacionAnual)">
                @if (variacionAnual.HasValue)
                {
                    <text>
                        @(variacionAnual.Value > 0 ? "+" : "")
                        @variacionAnual.Value.ToString("C2")
                    </text>
                }
                else
                {
                    <text>—</text>
                }
            </div>

            <div class="summary-note">
                @if (variacionAnualPorcentaje.HasValue)
                {
                    <text>
                        @(variacionAnualPorcentaje.Value > 0 ? "+" : "")
                        @variacionAnualPorcentaje.Value.ToString("N2")%
                        vs. inicio del año
                    </text>
                }
                else
                {
                    <text>Sin referencia suficiente</text>
                }
            </div>
        </div>

    </section>

    <div class="workspace-grid">

        <section class="panel">

            <div class="panel-header">
                <div class="panel-title-wrap">
                    <div class="panel-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div>
                        <h2 class="panel-title">
                            @(captura.EsEdicion
                                ? "Actualizar precio del día"
                                : "Capturar precio del día")
                        </h2>

                        <p class="panel-subtitle">
                            Precio obtenido mediante llamada de referencia.
                        </p>
                    </div>
                </div>
            </div>

            <div class="panel-body">

                <form id="formPrecioMercado">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="PrecioMercadoCerdoID"
                           value="@captura.PrecioMercadoCerdoID" />

                    <input type="hidden"
                           id="EsEdicion"
                           value="@captura.EsEdicion.ToString().ToLowerInvariant()" />

                    <div class="form-grid">

                        <div class="form-field">
                            <label for="Fecha">
                                Fecha
                            </label>

                            <input id="Fecha"
                                   type="date"
                                   class="form-control-price"
                                   value="@captura.Fecha.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="form-field">
                            <label for="PrecioKg">
                                Precio por kg
                            </label>

                            <div class="money-wrap">
                                <span class="money-prefix">$</span>

                                <input id="PrecioKg"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       class="form-control-price"
                                       value="@(captura.PrecioKg > 0 ? captura.PrecioKg.ToString("0.00", CultureInfo.InvariantCulture) : "")"
                                       placeholder="0.00"
                                       required />

                                <span class="money-suffix">
                                    /kg
                                </span>
                            </div>
                        </div>

                        <div class="form-field full">
                            <label for="ContactoReferencia">
                                Persona consultada
                            </label>

                            <input id="ContactoReferencia"
                                   type="text"
                                   maxlength="150"
                                   class="form-control-price"
                                   value="@captura.ContactoReferencia"
                                   placeholder="Nombre o referencia de la persona a quien se llamó" />

                            <div class="field-help">
                                Permite saber de dónde se obtuvo el precio utilizado ese día.
                            </div>
                        </div>

                        <div class="form-field full">
                            <label for="Observaciones">
                                Observaciones
                            </label>

                            <textarea id="Observaciones"
                                      maxlength="500"
                                      class="form-control-price"
                                      placeholder="Información adicional de la llamada o del precio">@captura.Observaciones</textarea>
                        </div>

                        <div id="bloqueMotivoCambio"
                             class="form-field full"
                             style="display:@(captura.EsEdicion ? "block" : "none")">

                            <label for="MotivoCambio">
                                Motivo del cambio
                            </label>

                            <textarea id="MotivoCambio"
                                      maxlength="500"
                                      class="form-control-price"
                                      placeholder="Indica por qué se está corrigiendo el precio registrado">@captura.MotivoCambio</textarea>
                        </div>

                        @if (captura.EsEdicion)
                        {
                            <div class="edit-notice">
                                <i class="fa-solid fa-circle-info"></i>
                                Ya existe un precio registrado para esta fecha.
                                Si modificas el importe, el cambio quedará registrado
                                en el historial de auditoría.
                            </div>
                        }

                    </div>

                    <div class="form-actions">
                        <button id="btnGuardarPrecio"
                                type="submit"
                                class="btn-save">

                            <i class="fa-solid fa-floppy-disk"></i>

                            <span>
                                @(captura.EsEdicion
                                    ? "Actualizar precio"
                                    : "Guardar precio")
                            </span>
                        </button>
                    </div>

                </form>

            </div>

        </section>

        <section class="panel">

            <div class="panel-header">
                <div class="panel-title-wrap">

                    <div class="panel-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <div>
                        <h2 class="panel-title">
                            Evolución del precio · @resumen.Anio
                        </h2>

                        <p class="panel-subtitle">
                            Tendencia de los precios registrados en el periodo consultado.
                        </p>
                    </div>

                </div>
            </div>

            <div class="panel-body">

                <div id="chartContainer"
                     class="chart-wrap">

                    <div id="chartTooltip"
                         class="chart-tooltip"></div>

                    <svg id="priceChart"
                         viewBox="0 0 900 310"
                         preserveAspectRatio="none"
                         role="img"
                         aria-label="Gráfica histórica del precio de mercado"></svg>

                </div>

            </div>

        </section>

    </div>

    <section class="panel filters-panel">

        <div class="panel-header">
            <div class="panel-title-wrap">

                <div class="panel-icon">
                    <i class="fa-solid fa-filter"></i>
                </div>

                <div>
                    <h2 class="panel-title">
                        Consultar periodo
                    </h2>

                    <p class="panel-subtitle">
                        Filtra la información mostrada en la gráfica y el histórico reciente.
                    </p>
                </div>

            </div>
        </div>

        <form method="get"
              asp-controller="Coordinacion"
              asp-action="PrecioMercadoCerdo"
              class="filters-form">

            <div>
                <label for="Anio">
                    Año
                </label>

                <select id="Anio"
                        name="Anio"
                        class="filter-control">

                    <option value="">Todos</option>

                    @foreach (var anio in Model.AniosDisponibles)
                    {
                        if (filtros.Anio == anio)
                        {
                            <option value="@anio" selected>
                                @anio
                            </option>
                        }
                        else
                        {
                            <option value="@anio">
                                @anio
                            </option>
                        }
                    }

                </select>
            </div>

            <div>
                <label for="Mes">
                    Mes
                </label>

                <select id="Mes"
                        name="Mes"
                        class="filter-control">

                    <option value="">Todos</option>

                    @for (var mes = 1; mes <= 12; mes++)
                    {
                        var nombreMes =
                            CultureInfo
                                .GetCultureInfo("es-MX")
                                .DateTimeFormat
                                .GetMonthName(mes);

                        nombreMes =
                            CultureInfo
                                .GetCultureInfo("es-MX")
                                .TextInfo
                                .ToTitleCase(nombreMes);

                        if (filtros.Mes == mes)
                        {
                            <option value="@mes" selected>
                                @nombreMes
                            </option>
                        }
                        else
                        {
                            <option value="@mes">
                                @nombreMes
                            </option>
                        }
                    }

                </select>
            </div>

            <div>
                <label for="FechaDesde">
                    Desde
                </label>

                <input id="FechaDesde"
                       name="FechaDesde"
                       type="date"
                       class="filter-control"
                       value="@filtros.FechaDesde?.ToString("yyyy-MM-dd")" />
            </div>

            <div>
                <label for="FechaHasta">
                    Hasta
                </label>

                <input id="FechaHasta"
                       name="FechaHasta"
                       type="date"
                       class="filter-control"
                       value="@filtros.FechaHasta?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="filter-actions">

                <a asp-controller="Coordinacion"
                   asp-action="PrecioMercadoCerdo"
                   class="btn-clear">

                    <i class="fa-solid fa-rotate-left"></i>
                    Limpiar
                </a>

                <button type="submit"
                        class="btn-filter">

                    <i class="fa-solid fa-filter"></i>
                    Aplicar
                </button>

            </div>

        </form>

    </section>

    <section class="panel">

        <div class="panel-header">

            <div class="panel-title-wrap">

                <div class="panel-icon">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>

                <div>
                    <h2 class="panel-title">
                        Histórico reciente
                    </h2>

                    <p class="panel-subtitle">
                        Últimos precios registrados dentro del periodo consultado.
                    </p>
                </div>

            </div>

            <strong style="color:#607286;font-size:.8rem;">
                @historico.Count registro@(historico.Count == 1 ? "" : "s")
            </strong>

        </div>

        @if (historicoReciente.Count == 0)
        {
            <div class="empty-state">

                <i class="fa-solid fa-chart-line"></i>

                <h3>
                    No hay precios registrados
                </h3>

                <p>
                    Captura el precio diario o cambia los filtros de consulta.
                </p>

            </div>
        }
        else
        {
            <div class="history-table-wrap">

                <table class="history-table">

                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Día</th>
                            <th>Precio/kg</th>
                            <th>Precio anterior</th>
                            <th>Variación</th>
                            <th>Fuente</th>
                            <th>Persona consultada</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in historicoReciente)
                        {
                            var claseVariacion =
                                ClaseVariacion(item.VariacionPrecio);

                            <tr>

                                <td>
                                    <strong>
                                        @item.Fecha.ToString("dd/MM/yyyy")
                                    </strong>
                                </td>

                                <td>
                                    @item.DiaSemana
                                </td>

                                <td class="price-cell">
                                    @item.PrecioKg.ToString("C2")
                                </td>

                                <td>
                                    @(item.PrecioAnterior?.ToString("C2") ?? "—")
                                </td>

                                <td>

                                    <span class="variation-badge @claseVariacion">

                                        <i class="fa-solid @IconoVariacion(item.VariacionPrecio)"></i>

                                        @if (item.VariacionPrecio.HasValue)
                                        {
                                            <text>
                                                @(item.VariacionPrecio.Value > 0 ? "+" : "")
                                                @item.VariacionPrecio.Value.ToString("C2")

                                                @if (item.VariacionPorcentaje.HasValue)
                                                {
                                                    <span>
                                                        (
                                                        @(item.VariacionPorcentaje.Value > 0 ? "+" : "")
                                                        @item.VariacionPorcentaje.Value.ToString("N2")%
                                                        )
                                                    </span>
                                                }
                                            </text>
                                        }
                                        else
                                        {
                                            <text>Sin referencia</text>
                                        }

                                    </span>

                                </td>

                                <td>
                                    <span class="source-badge">
                                        <i class="fa-solid fa-phone"></i>
                                        @(string.IsNullOrWhiteSpace(item.FuenteCodigo)
                                            ? "Llamada"
                                            : item.FuenteCodigo)
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.ContactoReferencia)
                                        ? "—"
                                        : item.ContactoReferencia)
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="history-footer">

                <span class="history-footer-text">
                    Se muestran los últimos @historicoReciente.Count registros.
                </span>

                <a asp-controller="Coordinacion"
                   asp-action="HistoricoPrecioMercadoCerdo"
                   asp-route-anio="@filtros.Anio"
                   asp-route-mes="@filtros.Mes"
                   asp-route-fechaDesde="@filtros.FechaDesde?.ToString("yyyy-MM-dd")"
                   asp-route-fechaHasta="@filtros.FechaHasta?.ToString("yyyy-MM-dd")"
                   class="history-link">

                    Ver histórico completo
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>
        }

    </section>

</div>

<div id="messageBox"
     class="message-box"></div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            const datosGrafica = @Html.Raw(jsonGrafica);

            const form = document.getElementById("formPrecioMercado");
            const btnGuardar = document.getElementById("btnGuardarPrecio");
            const messageBox = document.getElementById("messageBox");

            const fechaInput = document.getElementById("Fecha");
            const precioInput = document.getElementById("PrecioKg");
            const contactoInput = document.getElementById("ContactoReferencia");
            const observacionesInput = document.getElementById("Observaciones");
            const motivoInput = document.getElementById("MotivoCambio");
            const bloqueMotivo = document.getElementById("bloqueMotivoCambio");
            const esEdicionInput = document.getElementById("EsEdicion");

            const token =
                form?.querySelector('input[name="__RequestVerificationToken"]')
                    ?.value ?? "";

            function mostrarMensaje(mensaje, tipo) {
                if (!messageBox)
                    return;

                messageBox.textContent = mensaje;
                messageBox.className =
                    `message-box ${tipo === "success" ? "success" : "error"} show`;

                window.setTimeout(() => {
                    messageBox.classList.remove("show");
                }, 5000);
            }

            function numero(valor) {
                const n = Number(valor);
                return Number.isFinite(n) ? n : 0;
            }

            if (fechaInput) {
                fechaInput.addEventListener("change", () => {
                    const hoy = new Date();
                    const hoyTexto =
                        `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, "0")}-${String(hoy.getDate()).padStart(2, "0")}`;

                    const esMismaFecha =
                        fechaInput.value === hoyTexto &&
                        esEdicionInput?.value === "true";

                    if (bloqueMotivo) {
                        bloqueMotivo.style.display =
                            esMismaFecha ? "block" : "none";
                    }
                });
            }

            form?.addEventListener("submit", async e => {
                e.preventDefault();

                const precioKg = numero(precioInput?.value);

                if (!fechaInput?.value) {
                    mostrarMensaje(
                        "Selecciona la fecha del precio.",
                        "error");
                    return;
                }

                if (precioKg <= 0) {
                    mostrarMensaje(
                        "El precio por kilogramo debe ser mayor a cero.",
                        "error");
                    return;
                }

                const payload = {
                    precioMercadoCerdoID:
                        document.getElementById("PrecioMercadoCerdoID")?.value
                            ? Number(document.getElementById("PrecioMercadoCerdoID").value)
                            : null,

                    fecha: fechaInput.value,
                    precioKg: precioKg,
                    contactoReferencia:
                        contactoInput?.value?.trim() || null,
                    observaciones:
                        observacionesInput?.value?.trim() || null,
                    motivoCambio:
                        motivoInput?.value?.trim() || null,
                    esEdicion:
                        esEdicionInput?.value === "true"
                };

                btnGuardar.disabled = true;

                const textoOriginal =
                    btnGuardar.innerHTML;

                btnGuardar.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';

                try {
                    const response = await fetch(
                        '@Url.Action("GuardarPrecioMercadoCerdo", "Coordinacion")',
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": token
                            },
                            body: JSON.stringify(payload)
                        });

                    let data = null;

                    try {
                        data = await response.json();
                    } catch {
                        data = null;
                    }

                    if (!response.ok || !data?.ok) {
                        throw new Error(
                            data?.mensaje ??
                            "No fue posible guardar el precio.");
                    }

                    mostrarMensaje(
                        data.mensaje ??
                        "Precio guardado correctamente.",
                        "success");

                    window.setTimeout(() => {
                        window.location.reload();
                    }, 800);
                }
                catch (error) {
                    mostrarMensaje(
                        error?.message ??
                        "Ocurrió un error al guardar.",
                        "error");
                }
                finally {
                    btnGuardar.disabled = false;
                    btnGuardar.innerHTML = textoOriginal;
                }
            });

            function dibujarGrafica() {
                const svg =
                    document.getElementById("priceChart");

                const container =
                    document.getElementById("chartContainer");

                const tooltip =
                    document.getElementById("chartTooltip");

                if (!svg || !container)
                    return;

                svg.innerHTML = "";

                if (!Array.isArray(datosGrafica) ||
                    datosGrafica.length === 0) {

                    svg.style.display = "none";

                    const vacio =
                        document.createElement("div");

                    vacio.className = "chart-empty";

                    vacio.innerHTML = `
                        <i class="fa-solid fa-chart-line"></i>
                        <strong>Sin datos para graficar</strong>
                        <span>Captura precios o modifica el periodo de consulta.</span>
                    `;

                    container.appendChild(vacio);

                    return;
                }

                const width = 900;
                const height = 310;

                const left = 55;
                const right = 24;
                const top = 20;
                const bottom = 42;

                const chartWidth =
                    width - left - right;

                const chartHeight =
                    height - top - bottom;

                const valores =
                    datosGrafica.map(x => Number(x.precio));

                let min =
                    Math.min(...valores);

                let max =
                    Math.max(...valores);

                if (min === max) {
                    min -= 1;
                    max += 1;
                }

                const margen =
                    Math.max((max - min) * .15, .50);

                min -= margen;
                max += margen;

                const ns =
                    "http://www.w3.org/2000/svg";

                function crearElemento(nombre, atributos = {}) {
                    const el =
                        document.createElementNS(ns, nombre);

                    Object.entries(atributos)
                        .forEach(([key, value]) =>
                            el.setAttribute(key, value));

                    return el;
                }

                function xPos(index) {
                    if (datosGrafica.length === 1)
                        return left + chartWidth / 2;

                    return left +
                        (index / (datosGrafica.length - 1)) *
                        chartWidth;
                }

                function yPos(valor) {
                    return top +
                        ((max - valor) / (max - min)) *
                        chartHeight;
                }

                for (let i = 0; i <= 4; i++) {
                    const y =
                        top + (chartHeight / 4) * i;

                    const valor =
                        max - ((max - min) / 4) * i;

                    svg.appendChild(
                        crearElemento("line", {
                            x1: left,
                            x2: width - right,
                            y1: y,
                            y2: y,
                            stroke: "#e9eef3",
                            "stroke-width": "1"
                        }));

                    const texto =
                        crearElemento("text", {
                            x: left - 9,
                            y: y + 4,
                            "text-anchor": "end",
                            fill: "#8795a6",
                            "font-size": "11"
                        });

                    texto.textContent =
                        "$" + valor.toFixed(2);

                    svg.appendChild(texto);
                }

                const puntos =
                    datosGrafica.map((item, index) => ({
                        x: xPos(index),
                        y: yPos(Number(item.precio)),
                        item
                    }));

                const pathData =
                    puntos
                        .map((p, index) =>
                            `${index === 0 ? "M" : "L"} ${p.x} ${p.y}`)
                        .join(" ");

                const areaData =
                    `${pathData}
                     L ${puntos[puntos.length - 1].x} ${top + chartHeight}
                     L ${puntos[0].x} ${top + chartHeight}
                     Z`;

                svg.appendChild(
                    crearElemento("path", {
                        d: areaData,
                        fill: "rgba(0,88,143,.07)",
                        stroke: "none"
                    }));

                svg.appendChild(
                    crearElemento("path", {
                        d: pathData,
                        fill: "none",
                        stroke: "#00588f",
                        "stroke-width": "3",
                        "stroke-linecap": "round",
                        "stroke-linejoin": "round"
                    }));

                const maxEtiquetas = 8;
                const salto =
                    Math.max(
                        1,
                        Math.ceil(datosGrafica.length / maxEtiquetas));

                puntos.forEach((p, index) => {
                    const circulo =
                        crearElemento("circle", {
                            cx: p.x,
                            cy: p.y,
                            r: "4.5",
                            fill: "#ffffff",
                            stroke: "#00588f",
                            "stroke-width": "2.5",
                            style: "cursor:pointer"
                        });

                    circulo.addEventListener("mouseenter", ev => {
                        if (!tooltip)
                            return;

                        tooltip.innerHTML =
                            `<strong>${p.item.etiqueta}</strong> · $${Number(p.item.precio).toFixed(2)}/kg`;

                        tooltip.style.display = "block";

                        const containerRect =
                            container.getBoundingClientRect();

                        const circleRect =
                            ev.target.getBoundingClientRect();

                        tooltip.style.left =
                            `${circleRect.left - containerRect.left + circleRect.width / 2}px`;

                        tooltip.style.top =
                            `${circleRect.top - containerRect.top}px`;
                    });

                    circulo.addEventListener("mouseleave", () => {
                        if (tooltip)
                            tooltip.style.display = "none";
                    });

                    svg.appendChild(circulo);

                    if (index % salto === 0 ||
                        index === puntos.length - 1) {

                        const texto =
                            crearElemento("text", {
                                x: p.x,
                                y: height - 14,
                                "text-anchor": "middle",
                                fill: "#8795a6",
                                "font-size": "10.5"
                            });

                        texto.textContent =
                            p.item.etiqueta;

                        svg.appendChild(texto);
                    }
                });
            }

            dibujarGrafica();
        })();
    </script>
}