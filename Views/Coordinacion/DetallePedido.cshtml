    <section class="detail-section">
        <div class="section-head">
            <div class="section-head-left">
                <span class="section-icon"><i class="fa-solid fa-calendar-days"></i></span>
                <div>
                    <h2 class="section-title">Programación</h2>
                    <div class="section-help">Fechas, ruta y cantidades programadas para las partidas del pedido.</div>
                </div>
            </div>
            <span class="section-count">@programacion.Count</span>
        </div>

        @if (programacion.Count == 0)
        {
            <div class="empty-section">
                <i class="fa-regular fa-calendar"></i>
                El pedido todavía no tiene programación registrada.
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="detail-table programacion">
                    <thead>
                        <tr>
                            <th>Programación</th>
                            <th>Partida</th>
                            <th>Origen</th>
                            <th>Producción</th>
                            <th>Entrega</th>
                            <th>Cantidad</th>
                            <th>Ruta</th>
                            <th>Secuencia</th>
                            <th>Remisión</th>
                            <th>Estatus</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in programacion)
                        {
                            var renglon = detalles.FirstOrDefault(x => x.PedidoDetalleID == p.PedidoDetalleID)?.Renglon;
                            <tr>
                                <td>
                                    <div class="cell-main">#@p.ProgramacionID</div>
                                    <div class="cell-sub">@p.Anio · Semana @(p.Semana?.ToString() ?? "—") · V@p.Version</div>
                                </td>
                                <td>@(renglon.HasValue ? $"Renglón {renglon.Value}" : $"Detalle #{p.PedidoDetalleID}")</td>
                                <td>@(string.IsNullOrWhiteSpace(p.CentroOrigen) ? "—" : p.CentroOrigen)</td>
                                <td>@(p.FechaProduccion?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>
                                    <div class="cell-main">@p.FechaEntregaProgramada.ToString("dd/MM/yyyy")</div>
                                    @if (p.HoraEntregaProgramada.HasValue)
                                    {
                                        <div class="cell-sub">@p.HoraEntregaProgramada.Value.ToString(@"hh\:mm")</div>
                                    }
                                </td>
                                <td>@FormatoCantidad(p.CantidadProgramada)</td>
                                <td>
                                    <div class="cell-main">@(string.IsNullOrWhiteSpace(p.Ruta) ? "—" : p.Ruta)</div>
                                    @if (p.FechaRuta.HasValue)
                                    {
                                        <div class="cell-sub">@p.FechaRuta.Value.ToString("dd/MM/yyyy") @(p.HoraSalidaProgramada.HasValue? p.HoraSalidaProgramada.Value.ToString(@"hh\:mm") : "")</div>
                                    }
                                </td>
                                <td>@(p.SecuenciaEntrega?.ToString() ?? "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(p.ReferenciaRemision) ? "—" : p.ReferenciaRemision)</td>
                                <td>
                                    <span class="program-status">@p.EstatusDetalle</span>
                                    <div class="cell-sub">@p.EstatusProgramacion</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="detail-section">
        <div class="section-head">
            <div class="section-head-left">
                <span class="section-icon"><i class="fa-solid fa-rotate"></i></span>
                <div>
                    <h2 class="section-title">Solicitudes de cambio</h2>
                    <div class="section-help">Cambios, reprogramaciones o cancelaciones registradas sobre el pedido.</div>
                </div>
            </div>
            <span class="section-count">@solicitudesCambio.Count</span>
        </div>

        @if (solicitudesCambio.Count == 0)
        {
            <div class="empty-section">
                <i class="fa-solid fa-check"></i>
                No existen solicitudes de cambio registradas.
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="detail-table cambios">
                    <thead>
                        <tr>
                            <th>Folio cambio</th>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Motivo</th>
                            <th>Estatus</th>
                            <th>Fuera de tiempo</th>
                            <th>Resolución</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in solicitudesCambio)
                        {
                            <tr>
                                <td>#@c.SolicitudCambioID</td>
                                <td>@c.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@c.TipoCambio</td>
                                <td class="text-wrap">@c.Motivo</td>
                                <td><span class="small-badge @EstadoSolicitudClase(c.EstatusCodigo)">@c.Estatus</span></td>
                                <td>@(c.EsFueraDeTiempo ? "Sí" : "No")</td>
                                <td class="text-wrap">
                                    @if (c.FechaResolucion.HasValue)
                                    {
                                        <div class="cell-main">@c.FechaResolucion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                        @if (!string.IsNullOrWhiteSpace(c.ObservacionesResolucion))
                                        {
                                            <div class="cell-sub">@c.ObservacionesResolucion</div>
                                        }
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(c.DatosAnteriores) || !string.IsNullOrWhiteSpace(c.DatosNuevos))
                                    {
                                        <details class="json-details">
                                            <summary>Ver cambios</summary>
                                            @if (!string.IsNullOrWhiteSpace(c.DatosAnteriores))
                                            {
                                                <div class="cell-sub">Anterior</div>
                                                <div class="json-box">@c.DatosAnteriores</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(c.DatosNuevos))
                                            {
                                                <div class="cell-sub" style="margin-top:6px;">Nuevo</div>
                                                <div class="json-box">@c.DatosNuevos</div>
                                            }
                                        </details>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="detail-section">
        <div class="section-head">
            <div class="section-head-left">
                <span class="section-icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
                <div>
                    <h2 class="section-title">Historial</h2>
                    <div class="section-help">Trazabilidad de creación y cambios de estatus del pedido.</div>
                </div>
            </div>
            <span class="section-count">@historial.Count</span>
        </div>
        <div class="section-body">
            @if (historial.Count == 0)
            {
                <div class="empty-section">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    No hay movimientos registrados.
                </div>
            }
            else
            {
                <div class="history-list">
                    @foreach (var h in historial.OrderByDescending(x => x.FechaEvento))
                    {
                        <div class="history-item">
                            <div class="history-date">
                                @h.FechaEvento.ToString("dd/MM/yyyy")<br />
                                @h.FechaEvento.ToString("HH:mm")
                            </div>
                            <div class="history-dot-wrap"><span class="history-dot"></span></div>
                            <div>
                                <div class="history-event">@h.Evento</div>
                                @if (!string.IsNullOrWhiteSpace(h.EstatusAnterior) || !string.IsNullOrWhiteSpace(h.EstatusNuevo))
                                {
                                    <div class="history-text">
                                        @(string.IsNullOrWhiteSpace(h.EstatusAnterior) ? "Inicio" : h.EstatusAnterior)
                                        <i class="fa-solid fa-arrow-right" style="font-size:.55rem;margin:0 4px;"></i>
                                        @(string.IsNullOrWhiteSpace(h.EstatusNuevo) ? "—" : h.EstatusNuevo)
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(h.Observaciones))
                                {
                                    <div class="history-text">@h.Observaciones</div>
                                }
                            <div class="history-user">
                                @(string.IsNullOrWhiteSpace(h.UsuarioNombreSnapshot)
                                                            ? h.UsuarioID.HasValue ? $"Usuario #{h.UsuarioID}" : "Sistema"
                                                            : h.UsuarioNombreSnapshot)
                        </div>
                        @if (!string.IsNullOrWhiteSpace(h.DatosAdicionales))
                                {
                                    <details class="json-details">
                                        <summary>Datos adicionales</summary>
                                        <div class="json-box">@h.DatosAdicionales</div>
                                    </details>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>

@if (!esFinal)
{
    <div id="modalEstatus" class="modal-backdrop-custom" aria-hidden="true">
        <div class="modal-box-custom" role="dialog" aria-modal="true" aria-labelledby="modalEstatusTitulo">
            <div class="modal-head-custom">
                <h3 id="modalEstatusTitulo" class="modal-title-custom">Cambiar estatus del pedido</h3>
                <button type="button" id="btnCerrarModal" class="modal-close" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body-custom">
                <div class="modal-field">
                    <label for="NuevoEstatusCodigo">Nuevo estatus</label>
                    <select id="NuevoEstatusCodigo" class="modal-control">
                        <option value="">Selecciona...</option>
                        @if (estatusCodigo != "BORRADOR")
                        {
                            <option value="BORRADOR">Borrador</option>
                        }
                        @if (estatusCodigo != "RECIBIDO")
                        {
                            <option value="RECIBIDO">Recibido</option>
                        }
                        @if (estatusCodigo != "PENDIENTE_VALIDACION")
                        {
                            <option value="PENDIENTE_VALIDACION">Pendiente de validación</option>
                        }
                        @if (estatusCodigo != "PENDIENTE_PROGRAMAR")
                        {
                            <option value="PENDIENTE_PROGRAMAR">Pendiente de programar</option>
                        }
                        @if (estatusCodigo != "PROGRAMADO")
                        {
                            <option value="PROGRAMADO">Programado</option>
                        }
                        @if (estatusCodigo != "EN_PROCESO")
                        {
                            <option value="EN_PROCESO">En proceso</option>
                        }
                        @if (estatusCodigo != "ATENDIDO")
                        {
                            <option value="ATENDIDO">Atendido</option>
                        }
                        @if (estatusCodigo != "CERRADO")
                        {
                            <option value="CERRADO">Cerrado</option>
                        }
                        @if (estatusCodigo != "CANCELADO")
                        {
                            <option value="CANCELADO">Cancelado</option>
                        }
                    </select>
                    <div class="field-note" style="margin-top:5px;color:#98A2B3;font-size:.61rem;">
                        El cambio quedará registrado en el historial del pedido.
                    </div>
                </div>
                <div class="modal-field">
                    <label for="ObservacionesEstatus">Observaciones</label>
                    <textarea id="ObservacionesEstatus" maxlength="1000" class="modal-control" placeholder="Motivo o comentario del cambio..."></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" id="btnCancelarModal" class="btn-secondary">Cancelar</button>
                <button type="button" id="btnGuardarEstatus" class="btn-main">
                    <i class="fa-solid fa-check"></i>
                    Guardar cambio
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const pedidoId = @pedido.PedidoID;
            const cambiarEstatusUrl = '@Url.Action("CambiarEstatus", "Coordinacion")';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const modal = document.getElementById('modalEstatus');
            const btnAbrir = document.getElementById('btnAbrirEstatus');
            const btnCerrar = document.getElementById('btnCerrarModal');
            const btnCancelar = document.getElementById('btnCancelarModal');
            const btnGuardar = document.getElementById('btnGuardarEstatus');
            const estatusSelect = document.getElementById('NuevoEstatusCodigo');
            const observaciones = document.getElementById('ObservacionesEstatus');
            const pageMessage = document.getElementById('pageMessage');

            function abrirModal() {
                if (!modal) return;
                modal.classList.add('open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                setTimeout(() => estatusSelect?.focus(), 20);
            }

            function cerrarModal() {
                if (!modal) return;
                modal.classList.remove('open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            function mostrarError(texto) {
                if (!pageMessage) return;
                pageMessage.className = 'page-message error';
                pageMessage.textContent = texto;
                pageMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            function bloquear(bloqueado) {
                if (!btnGuardar) return;
                btnGuardar.disabled = bloqueado;
                btnGuardar.innerHTML = bloqueado
                    ? '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...'
                    : '<i class="fa-solid fa-check"></i> Guardar cambio';
            }

            async function cambiarEstatus() {
                const nuevoEstatusCodigo = estatusSelect?.value || '';
                if (!nuevoEstatusCodigo) {
                    alert('Selecciona el nuevo estatus.');
                    estatusSelect?.focus();
                    return;
                }

                bloquear(true);

                try {
                    const response = await fetch(cambiarEstatusUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            pedidoID: pedidoId,
                            nuevoEstatusCodigo: nuevoEstatusCodigo,
                            observaciones: observaciones?.value?.trim() || null
                        })
                    });

                    let data = null;
                    try { data = await response.json(); } catch { }

                    if (!response.ok || !data?.ok) {
                        throw new Error(data?.mensaje || `No fue posible cambiar el estatus (${response.status}).`);
                    }

                    window.location.reload();
                } catch (error) {
                    cerrarModal();
                    mostrarError(error?.message || 'No fue posible cambiar el estatus del pedido.');
                    bloquear(false);
                }
            }

            btnAbrir?.addEventListener('click', abrirModal);
            btnCerrar?.addEventListener('click', cerrarModal);
            btnCancelar?.addEventListener('click', cerrarModal);
            btnGuardar?.addEventListener('click', cambiarEstatus);

            modal?.addEventListener('click', event => {
                if (event.target === modal) cerrarModal();
            });

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && modal?.classList.contains('open')) cerrarModal();
            });
        })();
    </script>
}
