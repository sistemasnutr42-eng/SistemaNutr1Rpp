            color: #3538CD;
            font-size: .61rem;
            font-weight: 800
        }

        .solicitud-solicitado {
            background: #EAF5FC;
            color: #0B6FAF
        }

        .solicitud-revision {
            background: #FFF4E5;
            color: #B54708
        }

        .solicitud-autorizado, .solicitud-aplicado {
            background: #ECF8E8;
            color: #347526
        }

        .solicitud-rechazado, .solicitud-cancelado {
            background: #FEECEC;
            color: #B42318
        }

        .solicitud-general {
            background: #F2F4F7;
            color: #475467
        }

        .empty-section {
            padding: 28px 16px;
            text-align: center;
            color: #98A2B3;
            font-size: .7rem
        }

            .empty-section i {
                display: block;
                margin-bottom: 7px;
                font-size: 1.05rem
            }

        .history-list {
            position: relative
        }

        .history-item {
            position: relative;
            display: grid;
            grid-template-columns: 145px 18px 1fr;
            gap: 10px;
            padding: 0 0 15px
        }

            .history-item:last-child {
