            }

        .history-date {
            padding-top: 1px;
            color: #667085;
            font-size: .63rem;
            text-align: right
        }

        .history-dot-wrap {
            position: relative;
            display: flex;
            justify-content: center
        }

        .history-dot {
            position: relative;
            z-index: 2;
            width: 9px;
            height: 9px;
            margin-top: 4px;
            border-radius: 50%;
            background: var(--coord-primary)
        }

        .history-dot-wrap:after {
            content: "";
            position: absolute;
            top: 13px;
            bottom: -7px;
            width: 1px;
            background: #E4E7EC
        }

        .history-item:last-child .history-dot-wrap:after {
            display: none
