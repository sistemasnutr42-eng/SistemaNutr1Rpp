        }

        .prioridad-urgente {
            background: #FEECEC;
            color: #B42318
        }

        .prioridad-alta {
            background: #FFF4E5;
            color: #B54708
        }

        .prioridad-normal {
            background: #F2F4F7;
            color: #475467
        }

        .prioridad-baja {
            background: #ECF8E8;
            color: #347526
        }

        .meta-strip {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
            margin-bottom: 16px;
            padding: 10px 0;
            border-top: 1px solid var(--coord-border);
            border-bottom: 1px solid var(--coord-border)
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #667085;
            font-size: .68rem
        }

            .meta-item i {
                color: #98A2B3
            }

            .meta-item strong {
                color: #344054;
                font-weight: 800
            }

        .detail-section {
            margin-bottom: 16px;
            border: 1px solid var(--coord-border);
            border-radius: 11px;
