        }

        .status-badge, .priority-badge, .late-badge, .small-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            white-space: nowrap;
            font-size: .62rem;
            font-weight: 800
        }

        .status-badge, .priority-badge {
            padding: 5px 8px
        }

        .late-badge {
            padding: 5px 8px;
