        }

        .table-wrap {
            width: 100%;
            overflow-x: auto
        }

        .detail-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0
        }

            .detail-table thead th {
                padding: 9px 9px;
                border-bottom: 1px solid #E7EBF0;
                background: #FBFCFD;
                color: #667085;
                font-size: .6rem;
                font-weight: 850;
                text-transform: uppercase;
                letter-spacing: .02em;
                white-space: nowrap
            }

            .detail-table tbody td {
