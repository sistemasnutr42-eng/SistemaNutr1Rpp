@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@model SistemaNutri.Models.CoordinacionPedidoDetallePaginaVm

@{
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";

    var pedido = Model?.Pedido ?? new SistemaNutri.Models.CoordinacionPedidoEncabezadoVm();
    var detalles = Model?.Detalles ?? new List<SistemaNutri.Models.CoordinacionPedidoDetalleRenglonVm>();
    var programacion = Model?.Programacion ?? new List<SistemaNutri.Models.CoordinacionPedidoProgramacionVm>();
    var solicitudesCambio = Model?.SolicitudesCambio ?? new List<SistemaNutri.Models.CoordinacionSolicitudCambioVm>();
    var historial = Model?.Historial ?? new List<SistemaNutri.Models.CoordinacionPedidoHistorialVm>();

    var tipoCodigo = (pedido.TipoPedidoCodigo ?? string.Empty).Trim().ToUpperInvariant();
    var estatusCodigo = (pedido.EstatusCodigo ?? string.Empty).Trim().ToUpperInvariant();
    var esFinal = estatusCodigo == "CERRADO" || estatusCodigo == "CANCELADO";

    string AccionVolver() => tipoCodigo switch
    {
        "DOSIS" => "PedidosDosis",
        "HEMBRAS" => "PedidosHembras",
        "SEMENTALES" => "PedidosSementales",
        "RASTRO" => "PedidosRastro",
        _ => "Pedidos"
    };

    string TipoIcono() => tipoCodigo switch
    {
        "DOSIS" => "fa-solid fa-flask-vial",
        "HEMBRAS" => "fa-solid fa-venus",
        "SEMENTALES" => "fa-solid fa-mars",
        "RASTRO" => "fa-solid fa-truck-fast",
        _ => "fa-solid fa-box"
    };

    string EstatusClase(string? codigo) => (codigo ?? string.Empty).Trim().ToUpperInvariant() switch
    {
        "BORRADOR" => "estado-borrador",
        "RECIBIDO" => "estado-recibido",
        "PENDIENTE_VALIDACION" => "estado-pendiente",
        "PENDIENTE_PROGRAMAR" => "estado-pendiente",
        "PROGRAMADO" => "estado-programado",
        "EN_PROCESO" => "estado-proceso",
        "ATENDIDO" => "estado-atendido",
        "CERRADO" => "estado-cerrado",
        "CANCELADO" => "estado-cancelado",
        _ => "estado-general"
    };

    string PrioridadClase(string? codigo) => (codigo ?? string.Empty).Trim().ToUpperInvariant() switch
    {
        "URGENTE" => "prioridad-urgente",
        "ALTA" => "prioridad-alta",
        "BAJA" => "prioridad-baja",
        _ => "prioridad-normal"
    };

    string FormatoCantidad(decimal valor)
    {
        return valor == decimal.Truncate(valor)
            ? valor.ToString("N0", CultureInfo.GetCultureInfo("es-MX"))
            : valor.ToString("N3", CultureInfo.GetCultureInfo("es-MX")).TrimEnd('0').TrimEnd('.');
    }

    string FormatoNullable(decimal? valor, string sufijo = "")
    {
        if (!valor.HasValue) return "—";
        return $"{FormatoCantidad(valor.Value)}{sufijo}";
    }

    string DireccionDestino()
    {
        if (pedido.ClienteUbicacionID.HasValue)
        {
            return string.Join(", ", new[] { pedido.DireccionCliente, pedido.MunicipioCliente, pedido.EstadoCliente }
                .Where(x => !string.IsNullOrWhiteSpace(x)));
        }
        if (pedido.CentroDestinoID.HasValue)
        {
            return string.Join(", ", new[] { pedido.DireccionCentro, pedido.MunicipioCentro, pedido.EstadoCentro }
                .Where(x => !string.IsNullOrWhiteSpace(x)));
        }
        return string.Empty;
    }

    string TextoImportacion(bool? valor) => !valor.HasValue ? "—" : valor.Value ? "Sí" : "No";

    string EstadoSolicitudClase(string? codigo) => (codigo ?? string.Empty).Trim().ToUpperInvariant() switch
    {
        "SOLICITADO" => "solicitud-solicitado",
        "EN_REVISION" => "solicitud-revision",
        "AUTORIZADO" => "solicitud-autorizado",
        "RECHAZADO" => "solicitud-rechazado",
        "APLICADO" => "solicitud-aplicado",
        "CANCELADO" => "solicitud-cancelado",
        _ => "solicitud-general"
    };

    ViewData["Title"] = $"Pedido {pedido.Folio}";
}

@Html.AntiForgeryToken()

@section Estilos {
