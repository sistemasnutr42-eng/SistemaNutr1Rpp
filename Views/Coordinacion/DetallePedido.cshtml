            color: #3538CD
        }

        .estado-proceso {
            background: #F4F0FF;
            color: #6941C6
        }

        .estado-atendido, .estado-cerrado {
            background: #ECF8E8;
            color: #347526
        }

        .estado-cancelado {
            background: #FEECEC;
