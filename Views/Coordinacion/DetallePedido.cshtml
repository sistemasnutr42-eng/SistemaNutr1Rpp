        .section-icon {
            width: 30px;
            height: 30px;
            min-width: 30px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--coord-primary-soft);
            color: var(--coord-primary);
            font-size: .73rem
        }

        .section-title {
            margin: 0;
            color: #344054;
            font-size: .82rem;
            font-weight: 850
        }

        .section-help {
            margin-top: 2px;
            color: #98A2B3;
            font-size: .61rem
        }

        .section-count {
