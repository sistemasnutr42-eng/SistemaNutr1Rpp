            }

            .detail-table.hembras {
                min-width: 1300px
            }

            .detail-table.sementales {
                min-width: 1250px
            }

            .detail-table.rastro {
                min-width: 1050px
            }

            .detail-table.general {
                min-width: 950px
            }

            .detail-table.programacion {
                min-width: 1180px
            }

            .detail-table.cambios {
                min-width: 1000px
            }

        .cell-main {
            color: #344054;
            font-weight: 750
        }

        .cell-sub {
            margin-top: 3px;
            color: #98A2B3;
            font-size: .61rem;
            line-height: 1.35
        }

        .text-wrap {
            white-space: normal;
            min-width: 170px;
            max-width: 300px
        }

        .program-status {
            display: inline-flex;
            align-items: center;
            padding: 4px 7px;
            border-radius: 999px;
