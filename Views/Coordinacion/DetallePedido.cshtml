        .history-event {
            color: #344054;
            font-size: .7rem;
            font-weight: 800
        }

        .history-text {
            margin-top: 3px;
            color: #667085;
            font-size: .65rem;
            line-height: 1.4
        }

        .history-user {
            margin-top: 4px;
            color: #98A2B3;
            font-size: .61rem
        }

        details.json-details {
            margin-top: 6px
        }

            details.json-details summary {
                cursor: pointer;
                color: var(--coord-primary);
                font-size: .62rem;
                font-weight: 750
            }

        .json-box {
            margin-top: 5px;
            padding: 7px 8px;
            border: 1px solid #E4E7EC;
            border-radius: 7px;
            background: #F8FAFC;
            color: #475467;
            font-size: .61rem;
            line-height: 1.45;
            white-space: pre-wrap;
            overflow-wrap: anywhere
        }

        .modal-backdrop-custom {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1055;
            background: rgba(16,24,40,.48);
            padding: 18px;
            align-items: center;
            justify-content: center
        }

            .modal-backdrop-custom.open {
                display: flex
            }

        .modal-box-custom {
            width: min(520px,100%);
            border-radius: 12px;
            background: #fff;
            box-shadow: 0 24px 60px rgba(16,24,40,.22);
            overflow: hidden
        }

        .modal-head-custom {
            padding: 13px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #EEF1F4
        }

        .modal-title-custom {
            margin: 0;
            color: #344054;
            font-size: .86rem;
            font-weight: 850
        }

        .modal-close {
            width: 31px;
            height: 31px;
            border: 0;
            border-radius: 7px;
            background: #F2F4F7;
            color: #667085
        }

        .modal-body-custom {
            padding: 15px
        }

        .modal-field {
            margin-bottom: 12px
        }

            .modal-field:last-child {
                margin-bottom: 0
            }

            .modal-field label {
                display: block;
                margin-bottom: 5px;
                color: #475467;
                font-size: .65rem;
                font-weight: 800
            }

        .modal-control {
            width: 100%;
            min-height: 38px;
            border: 1px solid #DCE2E8;
            border-radius: 8px;
            padding: 8px 10px;
            outline: none;
            color: #344054;
            font-size: .72rem
        }

        textarea.modal-control {
            min-height: 90px;
            resize: vertical
        }

        .modal-control:focus {
            border-color: #0B6FAF;
            box-shadow: 0 0 0 3px rgba(11,111,175,.07)
        }

        .modal-actions {
            padding: 12px 15px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            border-top: 1px solid #EEF1F4;
            background: #FBFCFD
        }

        .page-message {
            display: none;
            margin-bottom: 12px;
            padding: 9px 11px;
            border-radius: 8px;
            font-size: .7rem;
            font-weight: 700
        }

            .page-message.error {
                display: block;
                border: 1px solid #FECACA;
                background: #FEF2F2;
                color: #B42318
            }

        @@media(max-width:1000px) {
            .info-grid {
                grid-template-columns: repeat(2,minmax(0,1fr))
            }

            .info-item.span-4 {
                grid-column: 1/-1
            }
        }

        @@media(max-width:720px) {
            .detalle-header {
                flex-direction: column
            }

            .header-actions {
                width: 100%
            }

            .btn-main, .btn-secondary, .btn-danger {
                flex: 1
            }

            .info-grid {
                grid-template-columns: 1fr
            }

            .info-item.span-2, .info-item.span-4 {
                grid-column: auto
            }

            .history-item {
                grid-template-columns: 1fr
            }

            .history-date {
                text-align: left
            }

            .history-dot-wrap {
                display: none
            }
        }
    </style>
}

<div class="detalle-page">
    <div class="detalle-header">
        <div>
            <div class="detalle-eyebrow">
                <i class="@TipoIcono()"></i>
                Coordinación · @pedido.TipoPedido
            </div>
            <div class="detalle-title-row">
                <h1 class="detalle-title">@pedido.Folio</h1>
                <span class="status-badge @EstatusClase(pedido.EstatusCodigo)">
                    @if (!string.IsNullOrWhiteSpace(pedido.ColorHex))
                    {
                        <span style="width:6px;height:6px;border-radius:50%;background:@pedido.ColorHex;display:inline-block;"></span>
                    }
                    @pedido.Estatus
                </span>
                <span class="priority-badge @PrioridadClase(pedido.PrioridadCodigo)">@pedido.Prioridad</span>
                @if (pedido.FueraDeTiempo)
                {
                    <span class="late-badge"><i class="fa-regular fa-clock"></i>Fuera de tiempo</span>
                }
            </div>
            <p class="detalle-subtitle">
                @(string.IsNullOrWhiteSpace(pedido.Cliente) ? "Pedido interno" : pedido.Cliente)
                @if (!string.IsNullOrWhiteSpace(pedido.Destino))
                {
                    <text> · @pedido.Destino</text>
                }
            </p>
        </div>

        <div class="header-actions">

            <a asp-controller="Coordinacion"
               asp-action="@AccionVolver()"
               class="btn-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                Regresar
            </a>

            @if (tipoCodigo == "RASTRO" && !esFinal)
            {
                <a asp-controller="Coordinacion"
                   asp-action="TabuladorPrecioCerdo"
                   asp-route-pedidoId="@pedido.PedidoID"
                   class="btn-main">
                    <i class="fa-solid fa-calculator"></i>
                    Cotizar
                </a>
            }

            @if (!esFinal)
            {
                <button type="button"
                        id="btnAbrirEstatus"
                        class="btn-main">
                    <i class="fa-solid fa-arrow-right-arrow-left"></i>
                    Cambiar estatus
                </button>
            }

        </div>
    </div>

    <div id="pageMessage" class="page-message"></div>

    <div class="meta-strip">
        <div class="meta-item"><i class="fa-regular fa-calendar"></i><span>Solicitud <strong>@pedido.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</strong></span></div>
        <div class="meta-item"><i class="fa-regular fa-calendar-check"></i><span>Requerida <strong>@(pedido.FechaRequerida?.ToString("dd/MM/yyyy") ?? "Sin definir")</strong></span></div>
        <div class="meta-item"><i class="fa-solid fa-arrow-right-to-bracket"></i><span>Origen <strong>@pedido.Origen</strong></span></div>
        <div class="meta-item"><i class="fa-solid fa-building"></i><span>Empresa <strong>@pedido.Empresa</strong></span></div>
        @if (!string.IsNullOrWhiteSpace(pedido.ReferenciaExterna))
        {
            <div class="meta-item"><i class="fa-solid fa-hashtag"></i><span>Referencia <strong>@pedido.ReferenciaExterna</strong></span></div>
        }
    </div>

    <section class="detail-section">
        <div class="section-head">
            <div class="section-head-left">
                <span class="section-icon"><i class="fa-solid fa-file-lines"></i></span>
                <div>
                    <h2 class="section-title">Datos generales</h2>
                    <div class="section-help">Información de origen, cliente y destino del pedido.</div>
                </div>
            </div>
        </div>
        <div class="section-body">
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Tipo de pedido</div>
                    <div class="info-value">@pedido.TipoPedido</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Cliente</div>
                    <div class="info-value">@(string.IsNullOrWhiteSpace(pedido.Cliente) ? "—" : pedido.Cliente)</div>
                    @if (!string.IsNullOrWhiteSpace(pedido.RazonSocial) && !string.Equals(pedido.RazonSocial, pedido.Cliente, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="info-sub">@pedido.RazonSocial</div>
                    }
                    @if (pedido.EsBioHypor == true)
                    {
                        <div class="info-sub">Cliente BioHypor</div>
                    }
                </div>
                <div class="info-item">
                    <div class="info-label">Destino</div>
                    <div class="info-value">@(string.IsNullOrWhiteSpace(pedido.Destino) ? "—" : pedido.Destino)</div>
                    @if (!string.IsNullOrWhiteSpace(DireccionDestino()))
                    {
                        <div class="info-sub">@DireccionDestino()</div>
                    }
                </div>
                <div class="info-item">
                    <div class="info-label">Solicitante</div>
                    <div class="info-value">@(pedido.UsuarioSolicitanteID.HasValue ? $"Usuario #{pedido.UsuarioSolicitanteID}" : "—")</div>
