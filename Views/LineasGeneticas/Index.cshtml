@{
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
    ViewData["Title"] = "Líneas genéticas";
}
@Html.AntiForgeryToken()

@section Estilos {
    <style>
        :root { --p: #084F83; --pd: #062F55; --ps: #EFF6FB; --a: #58A83F; --b: #E4E9EF; --m: #667085; --ok: #347526; --okb: #ECF8E8; --w: #B54708; --wb: #FFF4E5; --e: #B42318; --eb: #FEECEC }
        .prog-page { width: 100% }
        .prog-head { display: flex; justify-content: space-between; gap: 18px; margin-bottom: 18px }
        .prog-eye { display: flex; gap: 7px; align-items: center; color: var(--a); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 5px }
        .prog-title { margin: 0; color: var(--pd); font-size: 1.55rem; font-weight: 850 }
        .prog-sub { margin: 6px 0 0; max-width: 900px; color: var(--m); font-size: .82rem; line-height: 1.5 }
        .btn { min-height: 38px; padding: 8px 13px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; font-size: .72rem; font-weight: 800; text-decoration: none; cursor: pointer }
        .btn-main { border: 1px solid var(--p); background: var(--p); color: #fff }
        .btn-main:hover { background: var(--pd); color: #fff }
        .btn-sec { border: 1px solid #DCE2E8; background: #fff; color: #475467 }
        .btn-sec:hover { background: #F8FAFC; color: var(--pd) }
        .btn-danger { border: 1px solid #FECACA; background: #fff; color: var(--e) }
        .btn:disabled { opacity: .58; cursor: not-allowed }
        .panel { border: 1px solid var(--b); border-radius: 11px; background: #fff; overflow: hidden; margin-bottom: 16px }
        .panel-head { min-height: 46px; padding: 10px 13px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid #EEF1F4; background: #FBFCFD; flex-wrap: wrap }
        .panel-left { display: flex; align-items: center; gap: 9px }
        .panel-icon { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: var(--ps); color: var(--p); font-size: .73rem }
        .panel-title { margin: 0; color: #344054; font-size: .82rem; font-weight: 850 }
        .panel-help { margin-top: 2px; color: #98A2B3; font-size: .61rem }
        .pill { display: inline-flex; align-items: center; padding: 4px 7px; border-radius: 999px; background: #F2F4F7; color: #475467; font-size: .61rem; font-weight: 800 }
        .toolbar { padding: 10px 12px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; border-bottom: 1px solid #EEF1F4; background: #FBFCFD }
        .toolbar .sp { flex: 1 }
        .control { width: 100%; min-height: 36px; border: 1px solid #DCE2E8; border-radius: 8px; background: #fff; color: #344054; padding: 7px 10px; outline: none; font-size: .72rem }
        .control:focus { border-color: #0B6FAF; box-shadow: 0 0 0 3px rgba(11,111,175,.07) }
        .search { position: relative; width: min(320px,100%) }
        .search i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #98A2B3; font-size: .68rem }
        .search .control { padding-left: 30px }
        .filter { width: auto; min-width: 150px }
        .msg { display: none; margin-bottom: 12px; padding: 10px 12px; border-radius: 9px; font-size: .7rem; font-weight: 700; line-height: 1.45 }
        .msg.error { display: block; border: 1px solid #FECACA; background: #FEF2F2; color: var(--e) }
        .msg.ok { display: block; border: 1px solid #ABEFC6; background: #ECFDF3; color: #067647 }
        .wrap { width: 100%; overflow-x: auto }
        .tbl { width: 100%; min-width: 820px; border-collapse: separate; border-spacing: 0 }
        .tbl th { padding: 9px 8px; border-bottom: 1px solid #E7EBF0; background: #fff; color: #667085; font-size: .59rem; font-weight: 850; text-transform: uppercase; white-space: nowrap; text-align: left }
        .tbl td { padding: 9px 8px; border-bottom: 1px solid #F0F2F4; color: #344054; font-size: .68rem; vertical-align: middle }
        .tbl tr:last-child td { border-bottom: 0 }
        .tbl tbody tr:hover { background: #FAFCFD }
        .tbl tr.off td { opacity: .6 }
        .main { font-weight: 750 }
        .sub { margin-top: 3px; color: #98A2B3; font-size: .59rem; line-height: 1.35 }
        .val { display: inline-flex; gap: 5px; align-items: center; padding: 4px 7px; border-radius: 999px; font-size: .6rem; font-weight: 800; white-space: nowrap }
        .val.ok { background: var(--okb); color: var(--ok) }
        .val.mut { background: #F2F4F7; color: #667085 }
        .al { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 999px; background: var(--ps); color: var(--p); font-size: .6rem; font-weight: 800; margin: 0 4px 4px 0 }
        .al button { border: 0; background: transparent; color: var(--p); cursor: pointer; padding: 0; font-size: .7rem; line-height: 1 }
        .rowbtn { min-height: 30px; padding: 5px 8px; border: 1px solid #DCE2E8; border-radius: 7px; background: #fff; color: #475467; font-size: .62rem; font-weight: 800; cursor: pointer; margin-right: 4px }
        .rowbtn:hover { border-color: var(--p); color: var(--p); background: var(--ps) }
        .empty { padding: 34px 18px; text-align: center; color: #98A2B3; font-size: .7rem }
        .foot { padding: 10px 13px; border-top: 1px solid #EEF1F4; background: #FBFCFD; color: #98A2B3; font-size: .62rem }
        .modal-mask { display: none; position: fixed; inset: 0; z-index: 1100; background: rgba(16,24,40,.48); padding: 18px; align-items: center; justify-content: center }
        .modal-mask.open { display: flex }
        .modal-box { width: min(560px,100%); max-height: 90vh; overflow: auto; border-radius: 12px; background: #fff; box-shadow: 0 24px 60px rgba(16,24,40,.25) }
        .modal-head { padding: 13px 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #EEF1F4 }
        .modal-title { margin: 0; color: #344054; font-size: .85rem; font-weight: 850 }
        .modal-close { width: 31px; height: 31px; border: 0; border-radius: 7px; background: #F2F4F7; color: #667085; cursor: pointer }
        .modal-body { padding: 15px }
        .modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px }
        .field label { display: block; margin-bottom: 5px; color: #475467; font-size: .64rem; font-weight: 800 }
        .field.full { grid-column: 1/-1 }
        .note { margin-top: 4px; color: #98A2B3; font-size: .6rem; line-height: 1.35 }
        .alias-box { margin-top: 14px; padding: 12px; border: 1px solid #EEF1F4; border-radius: 10px; background: #FBFCFD }
        .alias-box h4 { margin: 0 0 4px; font-size: .72rem; color: #344054 }
        .alias-add { display: flex; gap: 8px; margin-top: 8px }
        .modal-err { display: none; margin-bottom: 10px; padding: 9px 11px; border-radius: 8px; background: #FEF2F2; border: 1px solid #FECACA; color: var(--e); font-size: .66rem; font-weight: 700 }
        .modal-err.show { display: block }
        .modal-actions { padding: 12px 15px; display: flex; justify-content: flex-end; gap: 8px; border-top: 1px solid #EEF1F4; background: #FBFCFD }
        @@media(max-width:720px) { .prog-head { flex-direction: column } .modal-grid { grid-template-columns: 1fr } .btn { width: 100% } .toolbar .sp { display: none } }
    </style>
}

<div class="prog-page">
    <div class="prog-head">
        <div>
            <div class="prog-eye"><i class="fa-solid fa-dna"></i>Administración · Catálogos</div>
            <h1 class="prog-title">Líneas genéticas</h1>
            <p class="prog-sub">Registra las líneas que se usan en Dosis, Hembras y Sementales. Una línea se reconoce por su <b>código</b>, su <b>nombre</b> o sus <b>alias</b>, sin distinguir mayúsculas ni acentos. Si el Excel la escribe de otra forma, agrégala como alias para que se reconozca sola.</p>
        </div>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-sec"><i class="fa-solid fa-arrow-left"></i>Regresar</a>
    </div>

    <div id="msg" class="msg"></div>

    <section class="panel">
        <div class="panel-head">
            <div class="panel-left">
                <span class="panel-icon"><i class="fa-solid fa-dna"></i></span>
                <div>
                    <h2 class="panel-title">Catálogo de líneas</h2>
                    <div class="panel-help">Las líneas inactivas no se reconocen en nuevas importaciones, pero los pedidos que ya las usan se conservan.</div>
                </div>
            </div>
            <span id="cuenta" class="pill">0 líneas</span>
        </div>
        <div class="toolbar">
            <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input id="buscar" class="control" placeholder="Buscar por código, nombre o alias…" /></div>
            <select id="estatus" class="control filter">
                <option value="TODAS">Todas</option>
                <option value="ACTIVAS" selected>Sólo activas</option>
                <option value="INACTIVAS">Sólo inactivas</option>
            </select>
            <span class="sp"></span>
            <button type="button" id="btnNueva" class="btn btn-main"><i class="fa-solid fa-plus"></i>Nueva línea</button>
        </div>
        <div class="wrap">
            <table class="tbl">
                <thead><tr><th>Código</th><th>Nombre</th><th>Descripción</th><th>Alias</th><th>En pedidos</th><th>Estatus</th><th>Acción</th></tr></thead>
                <tbody id="tbody"></tbody>
            </table>
        </div>
        <div id="empty" class="empty" style="display:none"><i class="fa-regular fa-folder-open"></i><br />No hay líneas que coincidan con la búsqueda.</div>
        <div class="foot">El código y el nombre no pueden repetirse entre líneas, ni coincidir con un alias de otra.</div>
    </section>
</div>

<div id="modal" class="modal-mask">
    <div class="modal-box">
        <div class="modal-head">
            <h3 id="mTitulo" class="modal-title">Nueva línea</h3>
            <button type="button" class="modal-close js-cerrar" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            <div id="mErr" class="modal-err"></div>
            <input type="hidden" id="fId" />
            <div class="modal-grid">
                <div class="field"><label>Código *</label><input id="fCodigo" class="control" maxlength="60" placeholder="Ej. YK DA" /></div>
                <div class="field"><label>Nombre *</label><input id="fNombre" class="control" maxlength="200" placeholder="Ej. YORK DANISH" /></div>
                <div class="field full"><label>Descripción</label><textarea id="fDesc" class="control" maxlength="600" style="min-height:70px;resize:vertical" placeholder="Opcional"></textarea></div>
                <div class="field full"><label style="display:flex;gap:7px;align-items:center;cursor:pointer"><input type="checkbox" id="fActivo" checked /> Línea activa</label></div>
            </div>
            <div id="aliasBox" class="alias-box">
                <h4>Alias en el Excel</h4>
                <div class="note" id="aliasNota">Otras formas de escribir esta línea. Guarda la línea primero para agregar alias.</div>
                <div id="aliasLista" style="margin-top:8px"></div>
                <div class="alias-add" id="aliasAdd">
                    <input id="fAlias" class="control" maxlength="100" placeholder="Ej. YORK DA" />
                    <button type="button" id="btnAlias" class="btn btn-sec">Agregar</button>
                </div>
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-sec js-cerrar">Cerrar</button>
            <button type="button" id="btnGuardar" class="btn btn-main"><i class="fa-solid fa-check"></i>Guardar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const urls = {
                listar: '@Url.Action("Listar", "LineasGeneticas")',
                guardar: '@Url.Action("Guardar", "LineasGeneticas")',
                estatus: '@Url.Action("CambiarEstatus", "LineasGeneticas")',
                aliasGuardar: '@Url.Action("GuardarAlias", "LineasGeneticas")',
                aliasEliminar: '@Url.Action("EliminarAlias", "LineasGeneticas")'
            };
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const $ = id => document.getElementById(id);

            const get = (o, ...ks) => {
                if (!o) return null;
                for (const k of ks) {
                    if (Object.prototype.hasOwnProperty.call(o, k)) return o[k];
                    const r = Object.keys(o).find(x => x.toLowerCase() === k.toLowerCase());
                    if (r) return o[r];
                }
                return null;
            };
            const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c]));

            let lineas = [], alias = [], editando = null, timer = null;

            function mensaje(t, tipo = 'error') {
                const m = $('msg');
                if (!t) { m.className = 'msg'; m.textContent = ''; return; }
                m.className = `msg ${tipo}`; m.textContent = t;
                if (tipo === 'ok') { clearTimeout(mensaje.t); mensaje.t = setTimeout(() => mensaje(''), 4000); }
            }

            async function pedir(url, opciones) {
                const res = await fetch(url, { credentials: 'same-origin', ...opciones });
                let data = null; try { data = await res.json(); } catch { }
                if (!res.ok || !data?.ok) throw new Error(data?.mensaje || `No fue posible completar la operación (${res.status}).`);
                return data;
            }
            const post = (url, campos) => {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                Object.entries(campos).forEach(([k, v]) => { if (v !== null && v !== undefined && v !== '') fd.append(k, v); });
                return pedir(url, { method: 'POST', body: fd });
            };

            async function cargar() {
                try {
                    const qs = new URLSearchParams({ texto: $('buscar').value.trim(), estatus: $('estatus').value });
                    const d = await pedir(`${urls.listar}?${qs}`);
                    lineas = Array.isArray(d.lineas) ? d.lineas : [];
                    alias = Array.isArray(d.alias) ? d.alias : [];
                    mensaje('');
                } catch (ex) { lineas = []; alias = []; mensaje(ex.message); }
                render();
            }

            const aliasDe = id => alias.filter(a => Number(get(a, 'LineaGeneticaID')) === Number(id));

            function render() {
                $('cuenta').textContent = `${lineas.length} ${lineas.length === 1 ? 'línea' : 'líneas'}`;
                $('tbody').innerHTML = lineas.map(l => {
                    const id = get(l, 'LineaGeneticaID'), activo = !(get(l, 'Activo') === false || get(l, 'Activo') === 0);
                    const usos = Number(get(l, 'Usos')) || 0;
                    const chips = aliasDe(id).map(a => `<span class="al">${esc(get(a, 'Alias'))}</span>`).join('') || '<span class="sub">—</span>';
                    return `<tr class="${activo ? '' : 'off'}">
                        <td class="main">${esc(get(l, 'Codigo'))}</td>
                        <td>${esc(get(l, 'Nombre'))}</td>
                        <td>${esc(get(l, 'Descripcion') || '—')}</td>
                        <td>${chips}</td>
                        <td>${usos ? `${usos} ${usos === 1 ? 'detalle' : 'detalles'}` : '<span class="sub">Sin uso</span>'}</td>
                        <td><span class="val ${activo ? 'ok' : 'mut'}">${activo ? 'Activa' : 'Inactiva'}</span></td>
                        <td>
                            <button type="button" class="rowbtn js-editar" data-id="${id}"><i class="fa-solid fa-pen"></i> Editar</button>
                            <button type="button" class="rowbtn js-estatus" data-id="${id}" data-activo="${activo ? 1 : 0}" data-usos="${usos}">${activo ? 'Desactivar' : 'Activar'}</button>
                        </td></tr>`;
                }).join('');
                $('empty').style.display = lineas.length ? 'none' : 'block';
            }

            // ---------- ventana ----------
            function errModal(t) { const e = $('mErr'); e.textContent = t || ''; e.classList.toggle('show', !!t); }

            function pintarAlias() {
                const id = $('fId').value;
                const hay = !!id;
                $('aliasAdd').style.display = hay ? 'flex' : 'none';
                $('aliasNota').textContent = hay
                    ? 'Otras formas de escribir esta línea en el Excel. Se reconocen sin distinguir mayúsculas ni acentos.'
                    : 'Guarda la línea primero para poder agregar alias.';
                $('aliasLista').innerHTML = hay
                    ? (aliasDe(id).map(a => `<span class="al">${esc(get(a, 'Alias'))}<button type="button" class="js-quitar" data-id="${get(a, 'LineaAliasID')}" aria-label="Quitar alias">✕</button></span>`).join('') || '<span class="sub">Aún no tiene alias.</span>')
                    : '';
            }

            function abrir(l) {
                errModal('');
                $('fId').value = l ? get(l, 'LineaGeneticaID') : '';
                $('fCodigo').value = l ? get(l, 'Codigo') || '' : '';
                $('fNombre').value = l ? get(l, 'Nombre') || '' : '';
                $('fDesc').value = l ? get(l, 'Descripcion') || '' : '';
                $('fActivo').checked = l ? !(get(l, 'Activo') === false || get(l, 'Activo') === 0) : true;
                $('fAlias').value = '';
                $('mTitulo').textContent = l ? `Editar línea · ${get(l, 'Codigo')}` : 'Nueva línea';
                pintarAlias();
                $('modal').classList.add('open'); document.body.style.overflow = 'hidden';
                $('fCodigo').focus();
            }
            function cerrar() { $('modal').classList.remove('open'); document.body.style.overflow = ''; }

            async function guardar() {
                errModal('');
                const codigo = $('fCodigo').value.trim(), nombre = $('fNombre').value.trim();
                if (!codigo) return errModal('El código es obligatorio.');
                if (!nombre) return errModal('El nombre es obligatorio.');
                const btn = $('btnGuardar'); btn.disabled = true;
                try {
                    const d = await post(urls.guardar, {
                        lineaGeneticaId: $('fId').value, codigo, nombre,
                        descripcion: $('fDesc').value.trim(), activo: $('fActivo').checked ? 'true' : 'false'
                    });
                    const nueva = !$('fId').value;
                    await cargar();
                    if (nueva) {
                        const l = get(d, 'linea');
                        $('fId').value = get(l, 'LineaGeneticaID') || '';
                        $('mTitulo').textContent = `Editar línea · ${codigo}`;
                        pintarAlias();
                        mensaje(d.mensaje || 'Línea registrada. Ahora puedes agregarle alias.', 'ok');
                        $('fAlias').focus();
                    } else { cerrar(); mensaje(d.mensaje || 'Línea actualizada.', 'ok'); }
                } catch (ex) { errModal(ex.message); }
                finally { btn.disabled = false; }
            }

            async function agregarAlias() {
                errModal('');
                const txt = $('fAlias').value.trim();
                if (!txt) return errModal('Escribe el alias.');
                try {
                    await post(urls.aliasGuardar, { lineaGeneticaId: $('fId').value, alias: txt });
                    $('fAlias').value = '';
                    await cargar(); pintarAlias();
                } catch (ex) { errModal(ex.message); }
            }
            async function quitarAlias(id) {
                errModal('');
                try { await post(urls.aliasEliminar, { lineaAliasId: id }); await cargar(); pintarAlias(); }
                catch (ex) { errModal(ex.message); }
            }

            async function cambiarEstatus(id, activo, usos) {
                const nuevo = !activo;
                if (!nuevo && usos > 0 && !confirm(`Esta línea está en ${usos} detalle(s) de pedido. Desactivarla no los borra, pero ya no se reconocerá en nuevas importaciones. ¿Continuar?`)) return;
                try {
                    const d = await post(urls.estatus, { lineaGeneticaId: id, activo: nuevo ? 'true' : 'false' });
                    mensaje(d.mensaje || (nuevo ? 'Línea activada.' : 'Línea desactivada.'), 'ok');
                    await cargar();
                } catch (ex) { mensaje(ex.message); }
            }

            // ---------- eventos ----------
            $('btnNueva').onclick = () => abrir(null);
            $('btnGuardar').onclick = guardar;
            $('btnAlias').onclick = agregarAlias;
            $('fAlias').onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); agregarAlias(); } };
            document.querySelectorAll('.js-cerrar').forEach(b => b.onclick = cerrar);
            $('modal').onclick = e => { if (e.target === $('modal')) cerrar(); };
            document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrar(); });
            $('aliasLista').onclick = e => { const b = e.target.closest('.js-quitar'); if (b) quitarAlias(b.dataset.id); };
            $('tbody').onclick = e => {
                const ed = e.target.closest('.js-editar');
                if (ed) { abrir(lineas.find(l => String(get(l, 'LineaGeneticaID')) === ed.dataset.id)); return; }
                const es = e.target.closest('.js-estatus');
                if (es) cambiarEstatus(es.dataset.id, es.dataset.activo === '1', Number(es.dataset.usos) || 0);
            };
            $('buscar').oninput = () => { clearTimeout(timer); timer = setTimeout(cargar, 250); };
            $('estatus').onchange = cargar;

            cargar();
        })();
    </script>
}
