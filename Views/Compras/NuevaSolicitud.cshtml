@model SistemaNutri.Models.CompraViewModel

@{
    ViewData["Title"] = "Nueva Solicitud de Compra";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";

    var tipoCompraActual = string.IsNullOrWhiteSpace(Model?.TipoCompra)
        ? "Nacional"
        : Model.TipoCompra;

    var esInternacional = tipoCompraActual == "Internacional";
    var categoriasCompraInfo = ViewBag.CategoriasCompraInfo as List<SistemaNutri.Models.CategoriaCompraInfoVm>
        ?? new List<SistemaNutri.Models.CategoriaCompraInfoVm>();
}

@section Estilos {
    <link rel="stylesheet" href="~/css/compras-presentacion.css" asp-append-version="true" />
}

<div class="container-fluid compras-new">
    <section class="cn-form-hero">
        <div>
            <div class="cn-form-eyebrow"><i class="fas fa-receipt"></i> FORMULARIO DE SOLICITUD</div>
            <h1>Nueva solicitud de compra</h1>
            <p>Registra lo que necesitas y adjunta las especificaciones para agilizar la cotización.</p>
        </div>
        <div class="cn-form-index">COMPRAS <span> / SOLICITUD</span></div>
    </section>
    <nav class="cn-progress-track" aria-label="Secciones del formulario">
        <span><strong>01</strong> Datos generales</span><i class="fas fa-chevron-right"></i>
        <span><strong>02</strong> Presupuesto</span><i class="fas fa-chevron-right"></i>
        <span><strong>03</strong> Materiales y envío</span>
    </nav>
    <div class="d-flex justify-content-between align-items-center mb-3 encabezado-solicitud">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <form asp-controller="Compras"
          asp-action="NuevaSolicitud"
          method="post"
          id="formCompra"
          enctype="multipart/form-data">

        <div asp-validation-summary="All" class="text-danger"></div>
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="TipoCompra" id="hfTipoCompra" value="@tipoCompraActual" />

        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center flex-wrap gap-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary">DATOS DE LA SOLICITUD</h6>

                <div class="btn-group btn-group-toggle selector-tipo-compra" data-toggle="buttons">
                    <label id="btnTipoNacional"
                           class="btn btn-outline-primary @(esInternacional ? "" : "active")"
                           onclick="cambiarTipoCompra('Nacional')">
                        <input type="radio" name="options" id="option1" autocomplete="off" @(esInternacional ? null : "checked")> Nacional
                    </label>

                    <label id="btnTipoInternacional"
                           class="btn btn-outline-primary @(esInternacional ? "active" : "")"
                           onclick="cambiarTipoCompra('Internacional')">
                        <input type="radio" name="options" id="option2" autocomplete="off" @(esInternacional ? "checked" : null)> Internacional
                    </label>
                </div>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-xl-4 col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Empresa Solicitante</label>
                        <select asp-for="EmpresaID" class="form-control" asp-items="ViewBag.Empresas" required>
                            <option value="">-- Selecciona Empresa --</option>
                        </select>
                    </div>

                    <div class="col-xl-4 col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Categoría de compra</label>
                        <select asp-for="UrgenciaID" class="form-control" asp-items="ViewBag.Urgencias" required>
                            <option value="">-- Selecciona categoría --</option>
                        </select>
                        <small id="textoTiempoObjetivo" class="form-text text-muted">
                            Selecciona la categoría para consultar el tiempo objetivo de cotización.
                        </small>
                    </div>

                    <div class="col-xl-4 col-md-12 form-group mb-3" id="divProyecto">
                        <label class="font-weight-bold">Nombre del Proyecto</label>
                        <input asp-for="NombreProyecto"
                               id="txtNombreProyecto"
                               class="form-control"
                               placeholder="Nombre del proyecto destinado"
                               required />
                    </div>
                </div>

                <!-- Datos complementarios del flujo de Compras / Whimsical -->
                <div class="card border-0 bg-light p-3 mb-3" aria-label="Clasificación y destino">
                    <h6 class="text-primary font-weight-bold mb-3">Clasificación y destino operativo</h6>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="ClasificacionSolicitud" class="font-weight-bold">Tipo de solicitud</label>
                            <select asp-for="ClasificacionSolicitud" class="form-control" required>
                                <option value="COMPRA">Compra de materiales o servicios</option>
                                <option value="GASTO_MANTENIMIENTO">Gasto de mantenimiento</option>
                            </select>
                            <small class="text-muted">La clasificación se captura desde el inicio; el dictamen lo realiza Control Presupuestal.</small>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="DestinoEntrega" class="font-weight-bold">Destino de entrega</label>
                            <select asp-for="DestinoEntrega" class="form-control" required>
                                <option value="ALMACEN">Almacén</option>
                                <option value="GRANJA">Granja</option>
                                <option value="USUARIO">Entrega directa al solicitante</option>
                            </select>
                        </div>
                        <div class="col-md-6 form-group" id="grupoGranjaDestino"
                             style="display:@(Model?.DestinoEntrega == "GRANJA" ? "block" : "none")">
                            <label asp-for="GranjaDestino" class="font-weight-bold">Nombre de la granja</label>
                            <input asp-for="GranjaDestino" id="campoGranjaDestino" maxlength="180"
                                   class="form-control" placeholder="Ej. Granja Terrenate" />
                            <span asp-validation-for="GranjaDestino" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <div class="form-check mt-4">
                                <input asp-for="ProductoNuevo" class="form-check-input" id="campoProductoNuevo" />
                                <label asp-for="ProductoNuevo" class="form-check-label font-weight-bold">¿Se trata de un producto nuevo?</label>
                            </div>
                            <small class="text-muted">Requiere validar datos técnicos antes de licitar o cotizar.</small>
                        </div>
                        <div class="col-12 form-group" id="grupoDatosTecnicos"
                             style="display:@(Model?.ProductoNuevo == true ? "block" : "none")">
                            <label asp-for="DatosTecnicosProducto" class="font-weight-bold">Datos técnicos del producto nuevo</label>
                            <textarea asp-for="DatosTecnicosProducto" id="campoDatosTecnicos" maxlength="4000"
                                      rows="3" class="form-control"
                                      placeholder="Especificaciones, medidas, compatibilidad y requisitos a confirmar con el requisitor"></textarea>
                            <span asp-validation-for="DatosTecnicosProducto" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div id="seccionAutorizacionUrgente" class="urgent-authorization-wrapper mt-2" style="display:none;">
                    <div class="urgent-authorization-card">
                        <div class="urgent-authorization-header">
                            <div class="urgent-authorization-icon">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <div>
                                <h6 class="mb-1">Autorización de compra urgente</h6>
                                <small>
                                    Para solicitudes urgentes debes adjuntar la autorización correspondiente antes de enviar la compra.
                                </small>
                            </div>
                        </div>

                        <div class="form-group mb-0 mt-3">
                            <label asp-for="ArchivoAutorizacionUrgente" class="font-weight-bold mb-2">
                                Archivo de autorización
                                <span class="badge badge-danger ml-1">Obligatorio</span>
                            </label>

                            <input asp-for="ArchivoAutorizacionUrgente"
                                   type="file"
                                   class="form-control-file urgent-file-input"
                                   accept=".pdf,.jpg,.jpeg,.png,.webp" />

                            <span asp-validation-for="ArchivoAutorizacionUrgente"
                                  class="text-danger small d-block mt-1"></span>

                            <small class="form-text text-muted">
                                Se permiten PDF o imágenes JPG, PNG y WEBP. El comprador podrá revisar este documento desde el detalle de la solicitud.
                            </small>
                        </div>
                    </div>
                </div>

                <div id="seccionTransporteInternacional" class="transport-wrapper mt-2" style="display:none;">
                    <div class="transport-card">
                        <div class="transport-header mb-3">
                            <div class="transport-header-icon">
                                <i class="fas fa-shipping-fast"></i>
                            </div>
                            <div>
                                <h6 class="mb-1">Configuración de transporte internacional</h6>
                                <small>
                                    Indica únicamente si la compra internacional requiere logística de transporte.
                                </small>
                            </div>
                        </div>

                        <div class="row transport-grid align-items-stretch">
                            <div class="col-lg-5 mb-3 mb-lg-0">
                                <div id="panelRequiereTransporte" class="transport-panel transport-check-panel h-100">
                                    <div class="form-check transport-check mb-0">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="chkRequiereTransporte">

                                        <label class="form-check-label" for="chkRequiereTransporte">
                                            <span class="transport-label">Requiere transporte</span>
                                            <span class="transport-help d-block mt-1">
                                                Marca esta opción solamente cuando la compra necesite un tipo de transporte específico.
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-7">
                                <div id="divTransportePlaceholder" class="transport-panel transport-placeholder-panel h-100">
                                    <div class="transport-placeholder-content">
                                        <i class="fas fa-info-circle mb-2"></i>
                                        <p class="mb-1 font-weight-bold">Transporte no configurado</p>
                                        <small>
                                            Activa la casilla <strong>Requiere transporte</strong> para mostrar las opciones disponibles.
                                        </small>
                                    </div>
                                </div>

                                <div id="divTransporte" class="transport-panel transport-select-panel h-100" style="display:none;">
                                    <label class="font-weight-bold mb-2">Tipo de transporte</label>
                                    <select asp-for="TransporteID" class="form-control border-warning">
                                        <option value="">-- Selecciona el tipo de transporte --</option>
                                        <option value="1">Marítimo</option>
                                        <option value="2">Avión</option>
                                        <option value="3">Terrestre</option>
                                    </select>

                                    <small class="form-text text-muted mt-2 mb-0">
                                        Selecciona el medio logístico que se utilizará para esta compra internacional.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-12">
                        <label class="font-weight-bold">Comentarios adicionales</label>
                        <textarea asp-for="Comentarios" class="form-control" rows="2" placeholder="Detalles extras de la compra..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow mb-4 border-left-warning">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-warning">
                    <i class="fas fa-coins mr-2"></i>
                    Presupuesto de la compra
                </h6>
            </div>

            <div class="card-body">
                <div class="form-group">
                    <label asp-for="MontoPresupuestoSolicitado" class="small font-weight-bold">
                        Presupuesto aproximado o solicitado
                        <span class="badge badge-light border ml-1">Opcional</span>
                    </label>

                    <input asp-for="MontoPresupuestoSolicitado"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           placeholder="Opcional. Ej. 15000.00" />

                    <span asp-validation-for="MontoPresupuestoSolicitado"
                          class="text-danger small"></span>

                    <small class="form-text text-muted">
                        Puedes dejar este campo vacío cuando todavía no exista un monto estimado.
                        Si capturas uno, debe ser mayor a cero.
                    </small>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="FueraPresupuestoUsuario"
                           class="form-check-input"
                           type="checkbox"
                           id="chkFueraPresupuesto" />

                    <label class="form-check-label font-weight-bold" for="chkFueraPresupuesto">
                        Esta compra está fuera de presupuesto
                    </label>
                </div>

                <div id="bloqueDesviacion" style="display:none;">
                    <div class="alert alert-warning small">
                        <i class="fas fa-exclamation-triangle mr-1"></i>
                        Esta compra está fuera de presupuesto. Debes adjuntar el formato de desviación firmado y llenado correctamente.
                    </div>

                    <div class="form-group">
                        <label asp-for="ArchivoDesviacion" class="small font-weight-bold">
                            Archivo de desviación firmado
                        </label>

                        <input asp-for="ArchivoDesviacion"
                               type="file"
                               class="form-control-file"
                               accept=".pdf,.jpg,.jpeg,.png,.webp" />

                        <span asp-validation-for="ArchivoDesviacion"
                              class="text-danger small"></span>

                        <small class="form-text text-muted">
                            Se permiten PDF o imágenes JPG, PNG o WEBP.
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-light">
                <h6 class="m-0 font-weight-bold text-secondary text-uppercase">Materiales o Servicios</h6>
            </div>

            <div class="card shadow mb-4 border-left-info">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-file-excel mr-2"></i>
                        Carga masiva de productos
                    </h6>
                </div>

                <div class="card-body">
                    <div class="row align-items-end">
                        <div class="col-md-8">
                            <label class="font-weight-bold">
                                Archivo Excel o CSV
                            </label>

                            <input type="file"
                                   id="archivoCargaMasiva"
                                   class="form-control"
                                   accept=".xlsx,.xls,.csv" />

                            <small class="text-muted">
                                El archivo debe contener las columnas:
                                Nombre, Descripción, Cantidad y Unidad.
                            </small>
                        </div>

                        <div class="col-md-4 mt-3 mt-md-0">
                            <button type="button"
                                    id="btnCargarProductosArchivo"
                                    class="btn btn-info btn-block">
                                <i class="fas fa-upload mr-1"></i>
                                Cargar productos
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-3 mb-0">
                        <strong>Formato esperado:</strong>
                        Nombre | Descripción | Cantidad | Unidad
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row mb-3 bg-light p-3 rounded border">
                    <div class="col-md-3">
                        <label class="small font-weight-bold">Producto</label>
                        <input type="text"
                               id="txtMatNombre"
                               class="form-control"
                               placeholder="Ej. Laptop, monitor, cable, servicio">
                    </div>

                    <div class="col-md-4">
                        <label class="small font-weight-bold">Descripción</label>
                        <input type="text"
                               id="txtMatDescripcion"
                               class="form-control"
                               placeholder="Marca, modelo, medidas, características, etc.">
                    </div>

                    <div class="col-md-2">
                        <label class="small font-weight-bold">Cant.</label>
                        <input type="number"
                               id="txtMatCant"
                               class="form-control"
                               value="1"
                               min="1">
                    </div>

                    <div class="col-md-2">
                        <label class="small font-weight-bold">U. Medida</label>
                        <input type="text"
                               id="txtMatUnidad"
                               class="form-control"
                               placeholder="Pza, Kg, m, caja">
                    </div>

                    <div class="col-md-1 d-flex align-items-end">
                        <button type="button"
                                class="btn btn-success btn-block"
                                onclick="agregarMaterial()">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>

                <div class="alert alert-info small mb-3 archivo-referencia-ayuda">
                    <i class="fas fa-info-circle mr-1"></i>
                    Los archivos de referencia pueden ser PDF, imágenes JPG, PNG o WEBP,
                    o documentos de Excel XLS/XLSX. Si un archivo no es válido, solamente se
                    limpiará ese archivo; los productos capturados permanecerán en la tabla.
                </div>

                <table class="table table-bordered table-striped" id="tablaMateriales">
                    <thead class="text-center">
                        <tr>
                            <th>Producto</th>
                            <th>Descripción</th>
                            <th style="width: 12%">Cantidad</th>
                            <th style="width: 12%">U. Medida</th>
                            <th style="width: 22%">Archivo referencia</th>
                            <th style="width: 10%">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Materiales != null && Model.Materiales.Any())
                        {
                            for (int i = 0; i < Model.Materiales.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden"
                                               name="Materiales[@i].Nombre"
                                               value="@Model.Materiales[i].Nombre" />
                                        @Model.Materiales[i].Nombre
                                    </td>

                                    <td>
                                        <input type="hidden"
                                               name="Materiales[@i].Descripcion"
                                               value="@Model.Materiales[i].Descripcion" />
                                        @Model.Materiales[i].Descripcion
                                    </td>

                                    <td class="text-center">
                                        <input type="hidden"
                                               name="Materiales[@i].Cantidad"
                                               value="@Model.Materiales[i].Cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                        @Model.Materiales[i].Cantidad
                                    </td>

                                    <td class="text-center">
                                        <input type="hidden"
                                               name="Materiales[@i].UnidadMedida"
                                               value="@Model.Materiales[i].UnidadMedida" />
                                        @Model.Materiales[i].UnidadMedida
                                    </td>

                                    <td>
                                        <label class="btn btn-outline-primary btn-sm btn-block mb-1">
                                            <i class="fas fa-paperclip mr-1"></i>
                                            Adjuntar archivo

                                            <input type="file"
                                                   name="Materiales[@i].ArchivoReferencia"
                                                   class="d-none input-archivo-ref"
                                                   accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xls"
                                                   onchange="mostrarNombreArchivo(this)" />
                                        </label>

                                        <small class="text-muted nombre-archivo-ref d-block">
                                            @if (Model.Materiales[i].ArchivoReferencia != null)
                                            {
                                                <text>Vuelve a seleccionar: @Model.Materiales[i].ArchivoReferencia.FileName</text>
                                            }
                                            else
                                            {
                                                <text>Sin archivo seleccionado</text>
                                            }
                                        </small>

                                        <span class="text-danger small d-block"
                                              data-valmsg-for="Materiales[@i].ArchivoReferencia"
                                              data-valmsg-replace="true"></span>
                                    </td>

                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                onclick="eliminarMaterial(this)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-right pb-5">
            <button type="submit" class="btn btn-primary btn-lg shadow">
                <i class="fas fa-paper-plane mr-2"></i>Enviar Solicitud de Compra
            </button>
        </div>
    </form>
</div>

<script>
(function () {
  const destino = document.querySelector('[name="DestinoEntrega"]');
  const granja = document.getElementById('campoGranjaDestino');
  const grupoGranja = document.getElementById('grupoGranjaDestino');
  const producto = document.getElementById('campoProductoNuevo');
  const tecnicos = document.getElementById('campoDatosTecnicos');
  const grupoTecnicos = document.getElementById('grupoDatosTecnicos');
  function actualizarFlujo() {
    const esGranja = destino && destino.value === 'GRANJA';
    const esNuevo = producto && producto.checked;
    if (grupoGranja) grupoGranja.style.display = esGranja ? '' : 'none';
    if (granja) granja.required = !!esGranja;
    if (grupoTecnicos) grupoTecnicos.style.display = esNuevo ? '' : 'none';
    if (tecnicos) tecnicos.required = !!esNuevo;
  }
  if (destino) destino.addEventListener('change', actualizarFlujo);
  if (producto) producto.addEventListener('change', actualizarFlujo);
  actualizarFlujo();
})();
</script>

<style>
    .tabla-categorias-compra th {
        font-size: .78rem;
        text-transform: uppercase;
        color: #6c757d;
    }

    .tabla-categorias-compra td {
        vertical-align: top;
        font-size: .86rem;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

    <script>
        let matIndex = @(Model.Materiales?.Count ?? 0);
        const categoriasCompraInfo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    categoriasCompraInfo.ToDictionary(
                    x => x.UrgenciaID.ToString(),
                    x => new
                    {
                        x.Descripcion,
                        x.TiempoObjetivo,
                        x.Ejemplos,
                        x.RequiereAutorizacion
                    }
                    )
                    ));

        function actualizarAutorizacionUrgente() {
            const selectUrgencia = document.getElementById('UrgenciaID');
            const seccion = document.getElementById('seccionAutorizacionUrgente');
            const input = document.getElementById('ArchivoAutorizacionUrgente');

            if (!selectUrgencia || !seccion || !input) return;

            const categoria = categoriasCompraInfo[selectUrgencia.value];
            const esUrgente = categoria?.RequiereAutorizacion === true;
            const textoTiempo = document.getElementById('textoTiempoObjetivo');

            if (textoTiempo) {
                textoTiempo.innerHTML = categoria
                    ? `<i class="fas fa-clock mr-1"></i>Tiempo objetivo: <strong>${categoria.TiempoObjetivo}</strong><br><span class="text-muted">Ejemplos: ${categoria.Ejemplos}</span>`
                    : 'Selecciona la categoría para consultar el tiempo objetivo de cotización.';
            }

            seccion.style.display = esUrgente ? 'block' : 'none';
            input.required = esUrgente;

            if (!esUrgente) {
                input.value = '';
            }
        }

        function actualizarEstadoTransporte() {
            const chk = document.getElementById('chkRequiereTransporte');
            const selectTransporte = document.getElementById('TransporteID');
            const divTransporte = document.getElementById('divTransporte');
            const divPlaceholder = document.getElementById('divTransportePlaceholder');
            const panelRequiere = document.getElementById('panelRequiereTransporte');

            if (!chk || !selectTransporte || !divTransporte || !divPlaceholder || !panelRequiere) {
                return;
            }

            if (chk.checked) {
                divPlaceholder.style.display = 'none';
                divTransporte.style.display = 'block';
                selectTransporte.required = true;
                panelRequiere.classList.add('activo');
            } else {
                divTransporte.style.display = 'none';
                divPlaceholder.style.display = 'flex';
                selectTransporte.required = false;
                selectTransporte.value = '';
                panelRequiere.classList.remove('activo');
            }
        }

        function aplicarEstadoTipoCompra(tipo) {
            const esInternacional = tipo === 'Internacional';
            const seccionTransporte = document.getElementById('seccionTransporteInternacional');
            const chkRequiereTransporte = document.getElementById('chkRequiereTransporte');
            const selectTransporte = document.getElementById('TransporteID');
            const btnNacional = document.getElementById('btnTipoNacional');
            const btnInternacional = document.getElementById('btnTipoInternacional');

            document.getElementById('hfTipoCompra').value = tipo;

            if (btnNacional && btnInternacional) {
                btnNacional.classList.toggle('active', !esInternacional);
                btnInternacional.classList.toggle('active', esInternacional);
            }

            if (seccionTransporte) {
                seccionTransporte.style.display = esInternacional ? 'block' : 'none';
            }

            if (!esInternacional) {
                if (chkRequiereTransporte) {
                    chkRequiereTransporte.checked = false;
                }

                if (selectTransporte) {
                    selectTransporte.required = false;
                    selectTransporte.value = '';
                }
            }

            actualizarEstadoTransporte();

            document.getElementById('divProyecto').style.display = 'block';
            document.getElementById('txtNombreProyecto').setAttribute('required', 'required');
        }

        function cambiarTipoCompra(tipo) {
            aplicarEstadoTipoCompra(tipo);
        }

        function agregarMaterial(nombreArchivo = null, descripcionArchivo = null, cantidadArchivo = null, unidadArchivo = null) {
            const nom = nombreArchivo !== null ? nombreArchivo : $('#txtMatNombre').val();
            const descripcion = descripcionArchivo !== null ? descripcionArchivo : $('#txtMatDescripcion').val();
            const cant = cantidadArchivo !== null ? cantidadArchivo : $('#txtMatCant').val();
            const uni = unidadArchivo !== null ? unidadArchivo : $('#txtMatUnidad').val();

            const nomTexto = (nom || '').toString().trim();
            const descripcionTexto = (descripcion || '').toString().trim();
            const unidadTexto = (uni || '').toString().trim();

            const cantidadNumero = parseFloat((cant || '').toString().replace(',', '.'));

            if (!nomTexto) {
                Swal.fire('Atención', 'Ingresa el producto.', 'warning');
                return false;
            }

            if (!descripcionTexto) {
                Swal.fire('Atención', 'Ingresa la descripción del producto.', 'warning');
                return false;
            }

            if (isNaN(cantidadNumero) || cantidadNumero <= 0) {
                Swal.fire('Atención', 'Ingresa una cantidad válida.', 'warning');
                return false;
            }

            const nomSeguro = escapeHtml(nomTexto);
            const descripcionSeguro = escapeHtml(descripcionTexto);
            const uniSeguro = escapeHtml(unidadTexto);
            const cantidadSeguro = cantidadNumero.toString();

            const fila = `<tr>
                <td>
                <input type="hidden" name="Materiales[${matIndex}].Nombre" value="${nomSeguro}" />
                ${nomSeguro}
                </td>

                <td>
                <input type="hidden" name="Materiales[${matIndex}].Descripcion" value="${descripcionSeguro}" />
                ${descripcionSeguro}
                </td>

                <td class="text-center">
                <input type="hidden" name="Materiales[${matIndex}].Cantidad" value="${cantidadSeguro}" />
                ${cantidadSeguro}
                </td>

                <td class="text-center">
                <input type="hidden" name="Materiales[${matIndex}].UnidadMedida" value="${uniSeguro}" />
                ${uniSeguro}
                </td>

                <td>
                <label class="btn btn-outline-primary btn-sm btn-block mb-1">
                <i class="fas fa-paperclip mr-1"></i>
                Adjuntar archivo

                <input type="file"
                name="Materiales[${matIndex}].ArchivoReferencia"
                class="d-none input-archivo-ref"
                accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xls"
                onchange="mostrarNombreArchivo(this)" />
                </label>

                <small class="text-muted nombre-archivo-ref d-block">
                Sin archivo seleccionado
                </small>
                </td>

                <td class="text-center">
                <button type="button" class="btn btn-danger btn-sm" onclick="eliminarMaterial(this)">
                <i class="fas fa-trash"></i>
                </button>
                </td>
                </tr>`;

            $('#tablaMateriales tbody').append(fila);
            matIndex++;

            if (nombreArchivo === null) {
                $('#txtMatNombre').val('');
                $('#txtMatDescripcion').val('');
                $('#txtMatCant').val('1');
                $('#txtMatUnidad').val('');
                $('#txtMatNombre').focus();
            }

            return true;
        }

        function agregarMaterialDesdeArchivo(nombre, descripcion, cantidad, unidad) {
            nombre = (nombre || '').toString().trim();
            descripcion = (descripcion || '').toString().trim();
            unidad = (unidad || '').toString().trim();
            cantidad = (cantidad || '').toString().trim();

            if (!nombre || !descripcion || !cantidad) {
                return false;
            }

            return agregarMaterial(nombre, descripcion, cantidad, unidad);
        }

        function eliminarMaterial(boton) {
            $(boton).closest('tr').remove();
            reindexarMateriales();
        }

        function reindexarMateriales() {
            let contador = 0;

            $('#tablaMateriales tbody tr').each(function() {
                $(this).find('input').each(function() {
                    let name = $(this).attr('name');

                    if (!name) return;

                    if (name.includes('Nombre'))
                        $(this).attr('name', `Materiales[${contador}].Nombre`);

                    if (name.includes('Descripcion'))
                        $(this).attr('name', `Materiales[${contador}].Descripcion`);

                    if (name.includes('Cantidad'))
                        $(this).attr('name', `Materiales[${contador}].Cantidad`);

                    if (name.includes('UnidadMedida'))
                        $(this).attr('name', `Materiales[${contador}].UnidadMedida`);

                    if (name.includes('ArchivoReferencia'))
                        $(this).attr('name', `Materiales[${contador}].ArchivoReferencia`);
                });

                contador++;
            });

            matIndex = contador;
        }

        function escapeHtml(valor) {
            return String(valor ?? '')
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function mostrarNombreArchivo(input) {
            const contenedor = $(input).closest('td');
            const etiquetaNombre = contenedor.find('.nombre-archivo-ref');

            if (!input.files || input.files.length === 0) {
                etiquetaNombre.text('Sin archivo seleccionado');
                return;
            }

            const archivo = input.files[0];
            const nombre = archivo.name || '';
            const punto = nombre.lastIndexOf('.');
            const extension = punto >= 0
                ? nombre.substring(punto).toLowerCase()
                : '';

            const extensionesPermitidas = [
                '.pdf', '.jpg', '.jpeg', '.png', '.webp', '.xlsx', '.xls'
            ];

            if (!extensionesPermitidas.includes(extension)) {
                input.value = '';
                etiquetaNombre.text('Sin archivo seleccionado');

                Swal.fire(
                    'Archivo no permitido',
                    'El archivo de referencia debe ser PDF, imagen JPG, PNG o WEBP, o Excel XLS/XLSX. Los productos capturados permanecerán en la lista.',
                    'warning'
                );

                return;
            }

            etiquetaNombre.text(nombre);
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const chkFueraPresupuesto = document.getElementById('chkFueraPresupuesto');
            const bloqueDesviacion = document.getElementById('bloqueDesviacion');
            const inputArchivoDesviacion = document.getElementById('ArchivoDesviacion');
            const chkRequiereTransporte = document.getElementById('chkRequiereTransporte');
            const selectTransporte = document.getElementById('TransporteID');
            const selectUrgencia = document.getElementById('UrgenciaID');
            const tipoActual = document.getElementById('hfTipoCompra').value || 'Nacional';

            function toggleDesviacion() {
                const fuera = chkFueraPresupuesto.checked;

                bloqueDesviacion.style.display = fuera ? 'block' : 'none';

                if (inputArchivoDesviacion) {
                    inputArchivoDesviacion.required = fuera;

                    if (!fuera) {
                        inputArchivoDesviacion.value = '';
                    }
                }
            }

            if (chkRequiereTransporte && selectTransporte && selectTransporte.value) {
                chkRequiereTransporte.checked = true;
            }

            if (chkRequiereTransporte) {
                chkRequiereTransporte.addEventListener('change', actualizarEstadoTransporte);
            }

            if (selectUrgencia) {
                selectUrgencia.addEventListener('change', actualizarAutorizacionUrgente);
            }

            actualizarAutorizacionUrgente();
            toggleDesviacion();
            chkFueraPresupuesto.addEventListener('change', toggleDesviacion);

            aplicarEstadoTipoCompra(tipoActual);
        });
    </script>

    <script>
        function normalizarTexto(valor) {
            return (valor || '')
                .toString()
                .trim()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '');
        }

        function obtenerValorFila(fila, posiblesNombres) {
            const llaves = Object.keys(fila);

            for (const nombre of posiblesNombres) {
                const nombreNormalizado = normalizarTexto(nombre);

                const llaveEncontrada = llaves.find(k =>
                    normalizarTexto(k) === nombreNormalizado
                );

                if (llaveEncontrada) {
                    return fila[llaveEncontrada];
                }
            }

            return '';
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const inputArchivo = document.getElementById('archivoCargaMasiva');
            const btnCargar = document.getElementById('btnCargarProductosArchivo');

            if (!inputArchivo || !btnCargar) return;

            btnCargar.addEventListener('click', function() {
                const archivo = inputArchivo.files[0];

                if (!archivo) {
                    Swal.fire('Atención', 'Selecciona un archivo Excel o CSV.', 'warning');
                    return;
                }

                const extension = archivo.name.split('.').pop().toLowerCase();

                if (!["xlsx", "xls", "csv"].includes(extension)) {
                    Swal.fire('Atención', 'Solo se permiten archivos Excel o CSV.', 'warning');
                    return;
                }

                const lector = new FileReader();

                lector.onload = function(e) {
                    let workbook;

                    if (extension === 'csv') {
                        workbook = XLSX.read(e.target.result, { type: 'string' });
                    } else {
                        const datos = new Uint8Array(e.target.result);
                        workbook = XLSX.read(datos, { type: 'array' });
                    }

                    const primeraHoja = workbook.SheetNames[0];
                    const hoja = workbook.Sheets[primeraHoja];

                    const filas = XLSX.utils.sheet_to_json(hoja, {
                        defval: ''
                    });

                    if (!filas || filas.length === 0) {
                        Swal.fire('Atención', 'El archivo no contiene productos.', 'warning');
                        return;
                    }

                    let agregados = 0;
                    let omitidos = 0;

                    filas.forEach(function(fila) {
                        const nombre = obtenerValorFila(fila, [
                            'Nombre',
                            'NombreMaterial',
                            'Material',
                            'Producto'
                        ]);

                        const descripcion = obtenerValorFila(fila, [
                            'Descripción',
                            'Descripcion',
                            'DescripcionMaterial',
                            'Detalle'
                        ]);

                        const cantidad = obtenerValorFila(fila, [
                            'Cantidad',
                            'Qty'
                        ]);

                        const unidad = obtenerValorFila(fila, [
                            'Unidad',
                            'UnidadMedida',
                            'Unidad de Medida',
                            'UM'
                        ]);

                        const ok = agregarMaterialDesdeArchivo(
                            nombre,
                            descripcion,
                            cantidad,
                            unidad
                        );

                        if (ok) {
                            agregados++;
                        } else {
                            omitidos++;
                        }
                    });

                    Swal.fire(
                        'Carga completada',
                        `Productos cargados: ${agregados}. Omitidos: ${omitidos}.`,
                        agregados > 0 ? 'success' : 'warning'
                    );

                    inputArchivo.value = '';
                };

                if (extension === 'csv') {
                    lector.readAsText(archivo, 'UTF-8');
                } else {
                    lector.readAsArrayBuffer(archivo);
                }
            });
        });
    </script>
}

