@model SistemaNutri.Models.DetalleCompraVm

@{
    ViewData["Title"] = "Detalle de Solicitud";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";

    bool esRechazada = Model.EstatusID == 11;
    bool esCancelada = Model.EstatusID == 12;
    bool cerradaAdministrativamente = Model.EstatusID == 10;

    bool puedeRegistrarOC = Model.EsCompras && Model.EstatusID == 5 && Model.CotizacionSeleccionadaID.HasValue && !Model.TieneOC && !esRechazada && !esCancelada;

    bool puedeEnviarProveedor = Model.EsCompras && Model.EstatusID == 6 && Model.TieneOC && !Model.OCEnviadaProveedor && !esRechazada && !esCancelada;

    bool puedeEntregarUsuario =
        Model.EsCompras
        && !Model.EsRequisicion
        && (Model.EstatusID == 9 || Model.EstatusID == 13)
        && !Model.EntregadaUsuario
        && !esRechazada
        && !esCancelada;

    bool puedeConfirmarDocumentacion =
        Model.EsSolicitante
        && Model.EstatusID == 3
        && Model.CotizacionSeleccionadaID.HasValue
        && Model.CotizacionAutorizadaPorSolicitante;

    bool puedeDictaminarCotizacion =
        Model.EsCompras
        && (Model.EstatusID == 2 || Model.EstatusID == 14);

    bool puedeAutorizarCotizacion =
        Model.EsSolicitante
        && Model.EstatusID == 14
        && Model.CotizacionSeleccionadaID.HasValue;

    bool requiereDesviacionFirmada =
        Model.FueraPresupuestoUsuario || Model.TieneDesviacionParaFirma;

    bool puedeCancelarSolicitud =
        (Model.EsSolicitante || Model.EsCompras)
        && !esRechazada
        && !esCancelada
        && !cerradaAdministrativamente;

    string badgeEstatus = Model.EstatusID switch
    {
        1 => "badge-secondary",
        2 => "badge-info",
        3 => "badge-warning",
        4 => "badge-primary",
        5 => "badge-primary",
        6 => "badge-info",
        7 => "badge-info",
        8 => "badge-warning",
        9 => "badge-warning",
        10 => "badge-success",
        11 => "badge-danger",
        12 => "badge-dark",
        13 => "badge-warning",
        14 => "badge-warning",
        _ => "badge-secondary"
    };

}

@{
    string returnUrl = Context.Request.Query["returnUrl"].ToString();

    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = Url.Action("Index", "Compras");
    }
}

<div class="container-fluid">

@if (TempData["Error"] != null)
{
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
}

@if (TempData["Mensaje"] != null)
{
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
}

    <div class="card shadow mb-4">
        <div class="card-body py-2">
            <div class="row no-gutters align-items-center">
                <div class="col mr-2">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Progreso del Proceso</div>
                    <div class="progress progress-sm mr-2">
                        <div class="progress-bar @Model.ColorProgreso" role="progressbar"
                             style="width: @Model.Porcentaje%"
                             aria-valuenow="@Model.Porcentaje"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Porcentaje%</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a href="@returnUrl" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>

            @if (puedeCancelarSolicitud)
            {
                <button type="button"
                        class="btn btn-cancelar-solicitud"
                        data-bs-toggle="modal"
                        data-bs-target="#modalCancelarSolicitud">
                    <span class="btn-cancelar-icon">
                        <i class="fas fa-times-circle"></i>
                    </span>
                    <span class="btn-cancelar-texto">
                        <strong>Cancelar solicitud</strong>
                        @*  <small>Ya no necesito continuar este proceso</small>*@
                    </span>
                </button>
            }
        </div>

        <div class="row">
            <div class="col-xl-7 col-lg-12">

                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">Folio: @Model.Folio</h6>
                        <span class="badge @badgeEstatus">
                            <i class="fas fa-info-circle mr-1"></i> @Model.EstatusActual
                        </span>
                    </div>

                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6 border-left-primary">
                                <label class="small font-weight-bold text-primary uppercase">Solicitante</label>
                                <p class="h6 font-weight-bold text-gray-800">@Model.NombreSolicitante</p>
                            </div>
                            <div class="col-md-6 border-left-info">
                                <label class="small font-weight-bold text-info uppercase">Empresa</label>
                                <p class="h6 font-weight-bold text-gray-800">@Model.Empresa</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="border rounded bg-light p-3 border-left-info">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                        <div>
                                            <label class="small font-weight-bold text-info uppercase mb-1">
                                                <i class="fas fa-layer-group mr-1"></i> Categoría de compra
                                            </label>
                                            <p class="h6 font-weight-bold text-gray-800 mb-1">
                                                @Model.UrgenciaDescripcion
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(Model.TiempoObjetivoCotizacion))
                                            {
                                                <small class="text-muted d-block">
                                                    <i class="fas fa-stopwatch mr-1"></i>
                                                    Tiempo objetivo de cotización: <strong>@Model.TiempoObjetivoCotizacion</strong>
                                                </small>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(Model.EjemplosCategoriaCompra))
                                            {
                                                <small class="text-muted d-block mt-1">
                                                    <i class="fas fa-lightbulb mr-1"></i>
                                                    Ejemplos: @Model.EjemplosCategoriaCompra
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info mb-3">
                            <div class="row">
                                <div class="col-md-4 mb-2"><strong>Clasificación:</strong><br />
                                    @(Model.ClasificacionSolicitud == "GASTO_MANTENIMIENTO" ? "Gasto de mantenimiento" : "Compra")
                                </div>
                                <div class="col-md-4 mb-2"><strong>Destino:</strong><br />
                                    @Model.DestinoEntrega
                                    @if (!string.IsNullOrWhiteSpace(Model.GranjaDestino))
                                    { <span> — @Model.GranjaDestino</span> }
                                </div>
                                <div class="col-md-4 mb-2"><strong>Producto nuevo:</strong><br />
                                    @(Model.ProductoNuevo ? "Sí — revisión técnica requerida" : "No")
                                </div>
                                @if (Model.ProductoNuevo && !string.IsNullOrWhiteSpace(Model.DatosTecnicosProducto))
                                {
                                    <div class="col-12"><strong>Especificaciones declaradas:</strong><br />
                                        @Model.DatosTecnicosProducto
                                    </div>
                                }
                                @if (Model.ProductoNuevo)
                                {
                                    <div class="col-12 mt-2">
                                        @if (Model.FechaConfirmacionTecnica.HasValue)
                                        {
                                            <span class="badge badge-success">Datos técnicos confirmados el @Model.FechaConfirmacionTecnica.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                        else if (Model.EsSolicitante && Model.EstatusID == 1)
                                        {
                                            <form asp-controller="Compras" asp-action="ConfirmarDatosTecnicos" method="post" class="mt-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="solicitudId" value="@Model.SolicitudID" />
                                                <button type="submit" class="btn btn-success btn-sm">Confirmar datos técnicos para cotización</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">Pendiente de confirmación técnica del solicitante</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="border rounded bg-light p-3 border-left-success">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                        <div>
                                            <label class="small font-weight-bold text-success uppercase mb-1">
                                                <i class="fas fa-user-tie mr-1"></i>
                                                Comprador asignado
                                            </label>

                                            @if (!string.IsNullOrWhiteSpace(Model.CompradorAsignadoNombre))
                                            {
                                                <p class="h6 font-weight-bold text-gray-800 mb-0">
                                                    @Model.CompradorAsignadoNombre
                                                </p>

                                                @if (!string.IsNullOrWhiteSpace(Model.CompradorAsignadoPuesto))
                                                {
                                                    <small class="text-muted">@Model.CompradorAsignadoPuesto</small>
                                                }
                                            }
                                            else
                                            {
                                                <p class="h6 font-weight-bold text-muted mb-0">
                                                    Pendiente de asignación
                                                </p>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(Model.CompradorAsignadoNombre))
                                        {
                                            <span class="badge badge-success mt-2 mt-md-0">
                                                <i class="fas fa-check-circle mr-1"></i> Asignado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary mt-2 mt-md-0">
                                                <i class="fas fa-clock mr-1"></i> Sin asignar
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>


                        @if (Model.EsUrgente)
                        {
                            <div class="card border-left-danger mb-4 urgent-detail-card">
                                <div class="card-header py-2">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                                        <h6 class="m-0 font-weight-bold text-danger">
                                            <i class="fas fa-bolt mr-2"></i>
                                            Autorización de compra urgente
                                        </h6>

                                        <span class="badge badge-danger mt-2 mt-sm-0">
                                            @Model.UrgenciaDescripcion
                                        </span>
                                    </div>
                                </div>

                                <div class="card-body">
                                    @if (Model.TieneAutorizacionUrgente)
                                    {
                                        <div class="alert alert-success mb-3">
                                            <i class="fas fa-check-circle mr-1"></i>
                                            El solicitante adjuntó la autorización requerida para esta compra urgente.
                                        </div>

                                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center urgent-file-row">
                                            <div class="mb-3 mb-md-0 mr-md-3">
                                                <label class="small font-weight-bold text-muted text-uppercase d-block mb-1">
                                                    Archivo de autorización
                                                </label>
                                                <span class="font-weight-bold text-gray-800 urgent-file-name">
                                                    @Model.NombreArchivoAutorizacionUrgente
                                                </span>
                                            </div>

                                            <div class="urgent-file-actions">
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm btn-ver-archivo"
                                                        data-ruta="@Model.ArchivoAutorizacionUrgentePath"
                                                        data-titulo="Autorización de compra urgente - @Model.Folio">
                                                    <i class="fas fa-eye mr-1"></i>
                                                    Ver autorización
                                                </button>

                                                <a asp-action="DescargarArchivoNas"
                                                   asp-route-ruta="@Model.ArchivoAutorizacionUrgentePath"
                                                   asp-route-nombre="@Model.NombreArchivoAutorizacionUrgente"
                                                   class="btn btn-outline-secondary btn-sm ml-md-2 mt-2 mt-md-0">
                                                    <i class="fas fa-download mr-1"></i>
                                                    Descargar
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-danger mb-3">
                                            <i class="fas fa-exclamation-triangle mr-1"></i>
                                            Esta solicitud está marcada como urgente, pero no cuenta con un archivo de autorización vigente. Compras no debe continuar con la cotización hasta corregirlo.
                                        </div>

                                        @if (Model.EsSolicitante && Model.EstatusID == 1)
                                        {
                                            <form asp-action="SubirAutorizacionUrgente"
                                                  method="post"
                                                  enctype="multipart/form-data"
                                                  class="urgent-fallback-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="solicitudId" value="@Model.SolicitudID" />

                                                <div class="form-group mb-2">
                                                    <label class="small font-weight-bold">Adjuntar autorización urgente</label>
                                                    <input type="file"
                                                           name="archivoAutorizacionUrgente"
                                                           class="form-control-file"
                                                           accept=".pdf,.jpg,.jpeg,.png,.webp"
                                                           required />
                                                    <small class="form-text text-muted">PDF o imagen JPG, PNG o WEBP.</small>
                                                </div>

                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-upload mr-1"></i>
                                                    Cargar autorización
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </div>
                        }

                        <div class="card border-left-warning mb-4">
                            <div class="card-header py-2">
                                <h6 class="m-0 font-weight-bold text-warning">
                                    <i class="fas fa-coins mr-2"></i>
                                    Presupuesto declarado por el solicitante
                                </h6>
                            </div>

                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-6 border-right">
                                        <label class="small font-weight-bold text-muted uppercase d-block">
                                            Monto presupuesto solicitado
                                        </label>

                                        <span class="h5 font-weight-bold text-gray-800">
                                            @(Model.MontoPresupuestoSolicitado.HasValue
                                                                                        ? Model.MontoPresupuestoSolicitado.Value.ToString("C")
                                                                                        : "No capturado")
                                        </span>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="small font-weight-bold text-muted uppercase d-block">
                                            Estatus presupuestal inicial
                                        </label>

                                        @if (Model.FueraPresupuestoUsuario)
                                        {
                                            <span class="badge badge-warning">
                                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                                Fuera de presupuesto
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">
                                                <i class="fas fa-check-circle mr-1"></i>
                                                Dentro de presupuesto
                                            </span>
                                        }
                                    </div>
                                </div>

                                @if (Model.FueraPresupuestoUsuario)
                                {
                                    <hr />

                                    @if (Model.PuedeVerArchivoDesviacion)
                                    {
                                        <div class="alert alert-warning mb-3">
                                            <i class="fas fa-file-signature mr-1"></i>
                                            Esta solicitud fue marcada como fuera de presupuesto y cuenta con archivo de desviación.
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(Model.ArchivoDesviacionPath))
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-warning btn-sm btn-block btn-ver-archivo"
                                                    data-ruta="@Model.ArchivoDesviacionPath"
                                                    data-titulo="Desviación firmada - @Model.Folio">
                                                <i class="fas fa-eye mr-1"></i>
                                                Ver archivo de desviación
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="alert alert-danger mb-0">
                                                <i class="fas fa-exclamation-circle mr-1"></i>
                                                No se encontró archivo de desviación cargado.
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mb-0">
                                            <i class="fas fa-file-signature mr-1"></i>
                                            El usuario cargó una desviación para revisión de Control Presupuestal.
                                        </div>
                                    }
                                }
                            </div>
                        </div>



                        @if (!string.IsNullOrEmpty(Model.ArchivoReferenciaPath))
                        {
                            bool esImagenReferencia =
                            Model.ArchivoReferenciaPath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                            Model.ArchivoReferenciaPath.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                            Model.ArchivoReferenciaPath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                            Model.ArchivoReferenciaPath.EndsWith(".webp", StringComparison.OrdinalIgnoreCase);

                            <div class="card border-left-info mb-4">
                                <div class="card-header py-2">
                                    <h6 class="m-0 font-weight-bold text-info">
                                        <i class="fas fa-paperclip mr-2"></i>
                                        Archivo de Referencia
                                    </h6>
                                </div>

                                <div class="card-body">

                                    @if (esImagenReferencia)
                                    {
                                        <div class="text-center">
                                            <img src="@Url.Action("VerArchivoNas", new { ruta = Model.ArchivoReferenciaPath })"
                                                 class="img-fluid rounded border"
                                                 style="max-height:350px;" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="border rounded bg-light"
                                             style="height:400px; overflow:hidden;">

                                            <iframe src="@Url.Action("VerArchivoNas", new { ruta = Model.ArchivoReferenciaPath })#toolbar=0"
                                                    width="100%"
                                                    height="100%"
                                                    style="border:none;">
                                            </iframe>
                                        </div>
                                    }

                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm btn-block mt-3 btn-ver-archivo"
                                            data-ruta="@Model.ArchivoReferenciaPath"
                                            data-titulo="Archivo de referencia">
                                        <i class="fas fa-eye mr-1"></i>
                                        Ver archivo completo
                                    </button>

                                </div>
                            </div>
                        }


                        <h6 class="font-weight-bold mt-4 text-gray-800">
                            <i class="fas fa-list mr-2"></i>Artículos requeridos
                        </h6>

                        <div class="table-responsive">
                            <table class="table table-bordered table-sm tabla-seguimiento-materiales" width="100%">
                                <thead class="bg-gray-100">
                                    <tr>
                                        <th>Producto</th>
                                        <th>Descripción</th>
                                        <th class="text-center">Solicitado</th>
                                        <th class="text-center">
                                            @(Model.EsRequisicion ? "Recibido en almacén" : "Entregado al usuario")
                                        </th>
                                        <th class="text-center">Pendiente</th>
                                        <th class="text-center">Estatus</th>
                                        <th class="text-center">Referencia</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var mat in Model.Materiales)
                                    {
                                        decimal procesado = Model.EsRequisicion
                                        ? mat.CantidadRecibidaAlmacen
                                        : mat.CantidadEntregadaUsuario;

                                        decimal pendiente = Model.EsRequisicion
                                        ? mat.CantidadPendienteAlmacen
                                        : mat.CantidadPendienteUsuario;

                                        bool completa = pendiente <= 0;
                                        bool parcial = procesado > 0 && !completa;

                                        <tr>
                                            <td class="font-weight-bold text-gray-800">
                                                @mat.Nombre
                                                <small class="d-block text-muted">@mat.UnidadMedida</small>
                                            </td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(mat.Descripcion)
                                                                                            ? "Sin descripción"
                                                                                            : mat.Descripcion)
                                        </td>

                                            <td class="text-center">@mat.Cantidad.ToString("0.##")</td>
                                            <td class="text-center">@procesado.ToString("0.##")</td>
                                            <td class="text-center">
                                                <strong class="@(pendiente > 0 ? "text-warning" : "text-success")">
                                                    @pendiente.ToString("0.##")
                                                </strong>
                                            </td>
                                            <td class="text-center">
                                            @if (completa)
                                                {
                                                    <span class="badge badge-success">Completo</span>
                                                }
                                                else if (parcial)
                                                {
                                                    <span class="badge badge-warning">Parcial</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Pendiente</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrWhiteSpace(mat.ArchivoReferenciaPath))
                                                {
                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm btn-ver-archivo"
                                                            data-ruta="@mat.ArchivoReferenciaPath"
                                                            data-titulo="Referencia - @mat.Nombre">
                                                        <i class="fas fa-eye mr-1"></i>
                                                        Ver
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Sin archivo</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @if (
                                (Model.EstatusID >= 5 || Model.EstatusID == 11 || Model.EstatusID == 12)
                                && !string.IsNullOrWhiteSpace(Model.TipoGasto)
                                && Model.DentroPresupuesto.HasValue
                                )
                {
                    <div class="card shadow mb-4 border-left-info">
                        <div class="card-header py-3 bg-info text-white">
                            <h6 class="m-0 font-weight-bold text-white">
                                <i class="fas fa-gavel mr-2"></i>Veredicto Presupuestal
                            </h6>
                        </div>

                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 text-center border-right">
                                    <label class="small font-weight-bold text-muted uppercase d-block">Proceso</label>
                                    <span class="badge badge-pill badge-primary px-3">@Model.TipoGasto</span>
                                </div>

                                <div class="col-md-4 text-center border-right">
                                    <label class="small font-weight-bold text-muted uppercase d-block">Presupuesto</label>
                                    @if (Model.DentroPresupuesto == true)
                                    {
                                        <span class="text-success font-weight-bold">
                                            <i class="fas fa-check-circle"></i> Liberado
                                        </span>
                                    }
                                    else if (Model.DentroPresupuesto == false)
                                    {
                                        <span class="text-warning font-weight-bold">
                                            <i class="fas fa-exclamation-triangle"></i> Desviación
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted font-weight-bold">
                                            Pendiente
                                        </span>
                                    }
                                </div>

                                <div class="col-md-4 text-center">
                                    <label class="small font-weight-bold text-muted uppercase d-block">ID Requisición</label>
                                    <span class="h6 font-weight-bold text-dark">
                                        @(string.IsNullOrEmpty(Model.NumeroRequisicion) ? "N/A" : Model.NumeroRequisicion)
                                    </span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.ObservacionesPresupuesto))
                            {
                                <div class="mt-3 p-2 bg-light border-left-info rounded text-sm">
                                    <small class="font-weight-bold text-info">Notas de Control Presupuestal:</small>
                                    <p class="mb-0 italic">"@Model.ObservacionesPresupuesto"</p>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ArchivoFormatoRequisicionPath))
                        {
                            <div class="alert alert-light border mt-2">
                                <strong>Formato de requisición:</strong><br />

                                <a class="btn btn-sm btn-outline-primary mt-2"
                                   asp-action="VerArchivoNas"
                                   asp-route-ruta="@Model.ArchivoFormatoRequisicionPath"
                                   target="_blank">
                                    Ver archivo
                                </a>

                                <span class="text-muted ms-2">
                                    @Model.NombreArchivoFormatoRequisicion
                                </span>
                            </div>
                        }
                    </div>
                }

                @if (esRechazada)
                {
                    <div class="card shadow mb-4 border-left-danger">
                        <div class="card-body text-center">
                            <h5 class="text-danger font-weight-bold">
                                <i class="fas fa-ban mr-2"></i>
                                SOLICITUD RECHAZADA POR CONTROL PRESUPUESTAL
                            </h5>
                            <p class="text-muted italic mb-0">Motivo: @Model.ObservacionesPresupuesto</p>
                        </div>
                    </div>
                }
                @if (esCancelada)
                {
                    <div class="card shadow mb-4 border-left-secondary">
                        <div class="card-body text-center">
                            <h5 class="text-muted font-weight-bold">
                                <i class="fas fa-times-circle mr-2"></i>
                                SOLICITUD CANCELADA
                            </h5>
                        </div>
                    </div>
                }

                @if (!esRechazada && !esCancelada)
                {
                    <div class="card shadow mb-4 border-left-primary">
                        <div class="card-header py-3 bg-info text-white">
                            <h6 class="m-0 font-weight-bold text-white">
                                <i class="fas fa-route mr-2"></i>Seguimiento Operativo de Compra
                            </h6>
                        </div>

                        <div class="card-body">

                            <div class="workflow-step @(Model.TieneOC ? "step-done" : puedeRegistrarOC ? "step-active" : "step-disabled")">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="font-weight-bold mb-0">
                                        <i class="fas fa-file-invoice mr-2"></i>1. Orden de Compra
                                    </h6>
                                    <span class="badge @(Model.TieneOC ? "badge-success" : puedeRegistrarOC ? "badge-warning" : "badge-secondary")">
                                        @(Model.TieneOC ? "Completado" : puedeRegistrarOC ? "Disponible" : "Bloqueado")
                                    </span>
                                </div>

                                @if (Model.TieneOC)
                                {
                                    <div class="alert alert-success mb-0">
                                        <strong>O.C. registrada:</strong> @Model.NumeroOC<br />
                                        <strong>Proveedor:</strong> @(string.IsNullOrEmpty(Model.ProveedorOC) ? "No capturado" : Model.ProveedorOC)<br />
                                        <strong>Fecha:</strong> @(Model.FechaOC.HasValue? Model.FechaOC.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")

                                        @if (!string.IsNullOrEmpty(Model.ComentariosOC))
                                        {
                                            <br />
                                            <strong>Comentarios:</strong>

                                            @Model.ComentariosOC
                                        }
                                    </div>
                                }
                                else if (Model.EsCompras)
                                {
                                    <form asp-action="RegistrarOC" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="solicitudId" value="@Model.SolicitudID" />

                                        <div class="form-group">
                                            <label class="small font-weight-bold">Número de O.C.</label>
                                            <input type="text" name="numeroOC" class="form-control" required @(puedeRegistrarOC ? "" : "disabled") />
                                        </div>

                                        <div class="alert alert-light border">
                                            <i class="fas fa-info-circle mr-1"></i>
                                            El proveedor se tomará automáticamente de la cotización dictaminada.
                                        </div>

                                        <div class="form-group">
                                            <label class="small font-weight-bold">Comentarios</label>
                                            <textarea name="comentarios" class="form-control" rows="2" @(puedeRegistrarOC ? "" : "disabled")></textarea>
                                        </div>

                                        <button type="submit" class="btn btn-success btn-block shadow" @(puedeRegistrarOC ? "" : "disabled")>
                                            <i class="fas fa-save mr-2"></i>Registrar O.C.
                                        </button>

                                        @if (!puedeRegistrarOC)
                                        {
                                            <small class="text-muted d-block mt-2">
                                                Se habilitará cuando Control Presupuestal apruebe el gasto.
                                            </small>
                                        }
                                    </form>


                                }
                                else
                                {
                                    <div class="alert alert-light border mb-0">
                                        <i class="fas fa-clock mr-1"></i>
                                        La Orden de Compra aún no ha sido registrada por Compras.
                                    </div>
                                }
                            </div>

                            <hr />

                            <div class="workflow-step @(Model.OCEnviadaProveedor ? "step-done" : puedeEnviarProveedor ? "step-active" : "step-disabled")">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="font-weight-bold mb-0">
                                        <i class="fas fa-paper-plane mr-2"></i>2. Envío a Proveedor
                                    </h6>
                                    <span class="badge @(Model.OCEnviadaProveedor ? "badge-success" : puedeEnviarProveedor ? "badge-warning" : "badge-secondary")">
                                        @(Model.OCEnviadaProveedor ? "Completado" : puedeEnviarProveedor ? "Disponible" : "Bloqueado")
                                    </span>
                                </div>

                                @if (Model.OCEnviadaProveedor)
                                {
                                    <div class="alert alert-warning mb-0">
                                        <strong>O.C. enviada al proveedor</strong><br />
                                        <strong>Fecha envío:</strong> @Model.FechaEnvioProveedor?.ToString("dd/MM/yyyy HH:mm")<br />
                                        <strong>Entrega estimada:</strong> @Model.FechaEstimadaEntrega?.ToString("dd/MM/yyyy")
                                    </div>
                                }
                                else if (Model.EsCompras)
                                {
                                    <form asp-action="EnviarOCProveedor" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="solicitudId" value="@Model.SolicitudID" />

                                        <div class="form-group">
                                            <label class="small font-weight-bold">Fecha estimada de entrega</label>
                                            <input type="date" name="fechaEstimadaEntrega" class="form-control" required @(puedeEnviarProveedor ? "" : "disabled") />
                                        </div>

                                        <div class="form-group">
                                            <label class="small font-weight-bold">Comentarios del envío</label>
                                            <textarea name="comentarios" class="form-control" rows="2" @(puedeEnviarProveedor ? "" : "disabled")></textarea>
                                        </div>

                                        <button type="submit" class="btn btn-warning btn-block shadow" @(puedeEnviarProveedor ? "" : "disabled")>
                                            <i class="fas fa-paper-plane mr-2"></i>Registrar envío a proveedor
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-light border mb-0">
                                        <i class="fas fa-clock mr-1"></i>
                                        La Orden de Compra aún no ha sido enviada al proveedor.
                                    </div>
                                }
                            </div>

                            <hr />

                            @if (Model.EsRequisicion)
                            {
                                <div class="workflow-step @(Model.RecibidaEnAlmacen ? "step-done" : Model.RecepcionAlmacenParcial ? "step-partial" : "step-disabled")">
                                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                        <h6 class="font-weight-bold mb-0">
                                            <i class="fas fa-warehouse mr-2"></i>3. Recepción en almacén
                                        </h6>

                                        <span class="badge @(Model.RecibidaEnAlmacen ? "badge-success" : Model.RecepcionAlmacenParcial ? "badge-warning" : "badge-secondary")">
                                            @(Model.RecibidaEnAlmacen
                                                                                ? "Completado"
                                                                                : Model.RecepcionAlmacenParcial
                                                                                ? "Pedido parcial"
                                                                                : "Pendiente en almacén")
                                </span>
                            </div>

                                    <div class="avance-entrega-grid mb-3">
                                        <div>
                                            <span>Solicitado</span>
                                            <strong>@Model.TotalCantidadSolicitada.ToString("0.##")</strong>
                                        </div>
                                        <div>
                                            <span>Recibido</span>
                                            <strong>@Model.TotalCantidadRecibidaAlmacen.ToString("0.##")</strong>
                                        </div>
                                        <div>
                                            <span>Pendiente</span>
                                            <strong>@Model.TotalPendienteAlmacen.ToString("0.##")</strong>
                                        </div>
                                    </div>

                            @if (Model.TieneRecepcionesAlmacen)
                                    {
                                        <div class="alert @(Model.RecibidaEnAlmacen ? "alert-success" : "alert-warning") mb-3">
                                            <strong>
                                                @(Model.RecibidaEnAlmacen
                                                                                    ? "Todos los artículos fueron recibidos en almacén."
                                                                                    : "El pedido tiene una recepción parcial.")
                                                                                                                           </strong><br />
                                                                                                                           <span>
                                                                                                                               Última recepción:
                                                @(Model.FechaRecepcionAlmacen.HasValue
                                                                                    ? Model.FechaRecepcionAlmacen.Value.ToString("dd/MM/yyyy HH:mm")
                                                                                    : "Sin fecha")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(Model.ComentariosRecepcionAlmacen))
                                            {
                                                <br />
                                                <span>Comentarios: @Model.ComentariosRecepcionAlmacen</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(Model.EvidenciaRecepcionPath))
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-success btn-sm btn-block btn-ver-archivo"
                                                    data-ruta="@Model.EvidenciaRecepcionPath"
                                                    data-titulo="Última evidencia de recepción - @Model.Folio">
                                                <i class="fas fa-eye mr-1"></i>
                                                Ver última evidencia de recepción
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-light border mb-0">
                                            La recepción se registra por artículo desde la Bandeja de Almacén.
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="workflow-step step-disabled">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="font-weight-bold mb-0">
                                            <i class="fas fa-warehouse mr-2"></i>3. Recepción en almacén
                                        </h6>
                                        <span class="badge badge-secondary">No aplica</span>
                                    </div>
                                    <small class="text-muted d-block mt-2">
                                        Esta compra tiene entrega directa al usuario.
                                    </small>
                                </div>
                            }

                            <hr />

                            @if (!Model.EsRequisicion)
                            {
                                <div class="workflow-step @(Model.EntregadaUsuario ? "step-done" : Model.EntregaUsuarioParcial ? "step-partial" : puedeEntregarUsuario ? "step-active" : "step-disabled")">
                                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                        <h6 class="font-weight-bold mb-0">
                                            <i class="fas fa-handshake mr-2"></i>4. Entrega al usuario
                                        </h6>

                                        <span class="badge @(Model.EntregadaUsuario ? "badge-success" : Model.EntregaUsuarioParcial ? "badge-warning" : puedeEntregarUsuario ? "badge-primary" : "badge-secondary")">
                                            @(Model.EntregadaUsuario
                                                                                ? "Completado"
                                                                                : Model.EntregaUsuarioParcial
                                                                                ? "Pedido parcial"
                                                                                : puedeEntregarUsuario
                                                                                ? "Disponible"
                                                                                : "Bloqueado")
                                </span>
                            </div>

                                    <div class="avance-entrega-grid mb-3">
                                        <div>
                                            <span>Solicitado</span>
                                            <strong>@Model.TotalCantidadSolicitada.ToString("0.##")</strong>
                                        </div>
                                        <div>
                                            <span>Entregado</span>
                                            <strong>@Model.TotalCantidadEntregadaUsuario.ToString("0.##")</strong>
                                        </div>
                                        <div>
                                            <span>Pendiente</span>
                                            <strong>@Model.TotalPendienteUsuario.ToString("0.##")</strong>
                                        </div>
                                    </div>

                            @if (Model.TieneEntregasUsuario)
                                    {
                                        <div class="alert @(Model.EntregadaUsuario ? "alert-success" : "alert-warning")">
                                            <strong>
                                                @(Model.EntregadaUsuario
                                                                                    ? "Todos los artículos fueron entregados al usuario."
                                                                                    : "La solicitud tiene una entrega parcial.")
                                                                                                                            </strong><br />
                                                                                                                            <span>
                                                                                                                                Última entrega:
                                                @(Model.FechaEntregaUsuario.HasValue
                                                                                    ? Model.FechaEntregaUsuario.Value.ToString("dd/MM/yyyy HH:mm")
                                                                                    : "Sin fecha")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(Model.NombreRecibeUsuario))
                                            {
                                                <br />
                                                <span>Recibió: @Model.NombreRecibeUsuario</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(Model.EvidenciaEntregaPath))
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-success btn-sm btn-block btn-ver-archivo mb-3"
                                                    data-ruta="@Model.EvidenciaEntregaPath"
                                                    data-titulo="Última evidencia de entrega - @Model.Folio">
                                                <i class="fas fa-eye mr-1"></i>
                                                Ver última evidencia de entrega
                                            </button>
                                        }
                                    }

                                    @if (!Model.EntregadaUsuario && Model.EsCompras)
                                    {
                                        <form asp-action="RegistrarEntregaUsuario"
                                              method="post"
                                              enctype="multipart/form-data"
                                              class="form-entrega-parcial">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="solicitudId" value="@Model.SolicitudID" />

                                            <div class="table-responsive mb-3">
                                                <table class="table table-sm tabla-captura-entrega">
                                                    <thead>
                                                        <tr>
                                                            <th>Artículo</th>
                                                            <th class="text-center">Solicitado</th>
                                                            <th class="text-center">Entregado</th>
                                                            <th class="text-center">Pendiente</th>
                                                            <th>Entregar ahora</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int i = 0; i < Model.Materiales.Count; i++)
                                                        {
                                                            var material = Model.Materiales[i];
                                                            var pendiente = material.CantidadPendienteUsuario;

                                                            <tr class="@(pendiente <= 0 ? "partida-completa" : "")">
                                                                <td>
                                                                    <input type="hidden"
                                                                           name="materiales[@i].DetalleID"
                                                                           value="@material.DetalleID" />
                                                                    <strong>@material.Nombre</strong>
                                                                </td>
                                                                <td class="text-center">@material.Cantidad.ToString("0.##")</td>
                                                                <td class="text-center">@material.CantidadEntregadaUsuario.ToString("0.##")</td>
                                                                <td class="text-center">@pendiente.ToString("0.##")</td>
                                                                <td>
                                                                    <input type="number"
                                                                           name="materiales[@i].Cantidad"
                                                                           class="form-control form-control-sm cantidad-entrega"
                                                                           min="0"
                                                                           max="@pendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                           step="0.01"
                                                                           data-pendiente="@pendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                           placeholder="0"
                                                                           @(pendiente <= 0 || !puedeEntregarUsuario ? "disabled" : "") />
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (puedeEntregarUsuario)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-primary btn-sm btn-block mb-3"
                                                        id="btnEntregarTodoPendiente">
                                                    <i class="fas fa-check-double mr-1"></i>
                                                    Capturar todo lo pendiente
                                                </button>
                                            }

                                            <div class="form-group">
                                                <label class="small font-weight-bold">Nombre de quien recibe</label>
                                                <input type="text"
                                                       name="nombreRecibe"
                                                       class="form-control"
                                                       required
                                                       @(puedeEntregarUsuario ? "" : "disabled") />
                                            </div>

                                            <div class="form-group">
                                                <label class="small font-weight-bold">Comentarios de entrega</label>
                                                <textarea name="comentarios"
                                              class="form-control"
                                              rows="2"
                                              @(puedeEntregarUsuario ? "" : "disabled")></textarea>
                                            </div>

                                            <div class="form-group">
                                                <label class="small font-weight-bold">Evidencia de esta entrega</label>
                                                <input type="file"
                                                       name="evidenciaEntrega"
                                                       class="form-control-file"
                                                       accept=".pdf,.jpg,.jpeg,.png,.webp"
                                                       required
                                                       @(puedeEntregarUsuario ? "" : "disabled") />
                                                <small class="form-text text-muted">
                                                    La evidencia quedará asociada a los artículos y cantidades capturados en este movimiento.
                                                </small>
                                            </div>

                                            <button type="submit"
                                                    class="btn btn-success btn-block shadow"
                                                    @(puedeEntregarUsuario ? "" : "disabled")>
                                                <i class="fas fa-check-circle mr-2"></i>
                                                Registrar entrega
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="workflow-step step-disabled">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="font-weight-bold mb-0">
                                            <i class="fas fa-handshake mr-2"></i>4. Entrega al usuario
                                        </h6>
                                        <span class="badge badge-secondary">No aplica</span>
                                    </div>
                                    <small class="text-muted d-block mt-2">
                                        En este flujo, la solicitud se completa con la recepción total en almacén.
                                    </small>
                                </div>
                            }

                        </div>

                    </div>
                }
            </div>

            <div class="col-xl-5 col-lg-12">
                <div class="card shadow mb-4 border-left-primary">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-file-invoice-dollar mr-2"></i>Cotizaciones registradas
                        </h6>
                    </div>

                    <div class="card-body">
                        @if (Model.EsSolicitante && Model.EstatusID == 2)
                        {
                            <div class="alert alert-info seleccion-cotizacion-ayuda">
                                <i class="fas fa-search-dollar mr-2"></i>
                                <strong>Compras está evaluando las cotizaciones.</strong>
                                Por el momento no necesitas realizar ninguna acción. Recibirás una notificación cuando exista una cotización dictaminada.
                            </div>
                        }

                        @if (puedeAutorizarCotizacion)
                        {
                            <div class="alert alert-warning seleccion-cotizacion-ayuda">
                                <i class="fas fa-user-check mr-2"></i>
                                <strong>Tu autorización es requerida.</strong>
                                Revisa la cotización dictaminada por Compras y autorízala para continuar con la documentación presupuestal.
                            </div>
                        }

                        @if (Model.Cotizaciones != null && Model.Cotizaciones.Any())
                        {
                            foreach (var cot in Model.Cotizaciones)
                            {
                                bool esImagen =
                                cot.Extension == ".jpg" ||
                                cot.Extension == ".jpeg" ||
                                cot.Extension == ".png" ||
                                cot.Extension == ".webp";

                                <div class="card border mb-3 @(cot.FueSeleccionadaPorUsuario ? "border-success shadow" : "")">



                                    <div class="card-body">

                                        <div class="d-flex justify-content-between align-items-center mb-2">


                                            <h6 class="font-weight-bold text-primary mb-0">
                                                @cot.Proveedor
                                            </h6>




                                            @if (cot.FueSeleccionadaPorUsuario)
                                            {
                                                <div class="d-flex flex-wrap justify-content-end badges-dictamen">
                                                    <span class="badge badge-primary">
                                                        <i class="fas fa-gavel mr-1"></i>
                                                        Dictaminada por Compras
                                                    </span>

                                                    @if (Model.CotizacionAutorizadaPorSolicitante)
                                                    {
                                                        <span class="badge badge-success ml-1">
                                                            <i class="fas fa-user-check mr-1"></i>
                                                            Autorizada por el solicitante
                                                        </span>
                                                    }
                                                    else if (Model.EstatusID == 14)
                                                    {
                                                        <span class="badge badge-warning ml-1">
                                                            <i class="fas fa-clock mr-1"></i>
                                                            Pendiente de autorización
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <p class="mb-1">
                                            <strong>Monto:</strong>
                                            @cot.MontoTotal.ToString("C")
                                        </p>


                                        @if (cot.FueSeleccionadaPorUsuario)
                                        {
                                            <div class="alert alert-primary mt-2 mb-2">
                                                <i class="fas fa-gavel mr-1"></i>
                                                Esta es la cotización dictaminada por Compras para continuar el proceso.

                                                @if (!string.IsNullOrWhiteSpace(Model.NombreSelectorCotizacion))
                                                {
                                                    <div class="small mt-1">
                                                        Dictaminó: <strong>@Model.NombreSelectorCotizacion</strong>
                                                        @if (Model.FechaSeleccionCotizacion.HasValue)
                                                        {
                                                            <span>· @Model.FechaSeleccionCotizacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(Model.ComentariosSeleccionUsuario))
                                            {
                                                <div class="alert alert-light border mt-2 mb-2 comentario-seleccion-cotizacion">
                                                    <small class="font-weight-bold text-muted d-block mb-1">
                                                        Comentario del dictamen de Compras
                                                    </small>
                                                    <div>@Model.ComentariosSeleccionUsuario</div>
                                                </div>
                                            }

                                            @if (Model.CotizacionAutorizadaPorSolicitante)
                                            {
                                                <div class="alert alert-success mt-2 mb-2">
                                                    <i class="fas fa-check-circle mr-1"></i>
                                                    Cotización autorizada por el solicitante.

                                                    @if (!string.IsNullOrWhiteSpace(Model.NombreAutorizadorCotizacion))
                                                    {
                                                        <div class="small mt-1">
                                                            Autorizó: <strong>@Model.NombreAutorizadorCotizacion</strong>
                                                            @if (Model.FechaAutorizacionCotizacion.HasValue)
                                                            {
                                                                <span>· @Model.FechaAutorizacionCotizacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(Model.ComentariosAutorizacionCotizacion))
                                                {
                                                    <div class="alert alert-light border mt-2 mb-2 comentario-seleccion-cotizacion">
                                                        <small class="font-weight-bold text-muted d-block mb-1">
                                                            Comentario de autorización
                                                        </small>
                                                        <div>@Model.ComentariosAutorizacionCotizacion</div>
                                                    </div>
                                                }
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(cot.ComentariosCompras))
                                        {
                                            <div class="alert alert-light border mt-2 mb-2">
                                                <small class="font-weight-bold text-muted">
