@section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const contenedorCotizaciones = document.getElementById("contenedorCotizaciones");
                const btnAgregarCotizacion = document.getElementById("btnAgregarCotizacion");

                function crearCotizacionItem() {
                    const item = document.createElement("div");
                    item.className = "border rounded p-3 mb-3 cotizacion-item";
                    item.innerHTML = `
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="font-weight-bold text-primary mb-0 cotizacion-titulo"></h6>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-eliminar-cotizacion"
                                                    aria-label="Eliminar cotización">
                                                <i class="fas fa-trash-alt mr-1"></i>
                                                Eliminar
                                            </button>
                                        </div>

                                        <div class="form-group">
                                            <label class="small font-weight-bold text-muted cotizacion-label-proveedor"></label>
                                            <input type="text"
                                                   data-field="Proveedor"
                                                   class="form-control"
                                                   placeholder="Ej. Proveedor ABC"
                                                   required />
                                        </div>

                                        <div class="form-group">
                                            <label class="small font-weight-bold text-muted cotizacion-label-monto"></label>
                                            <input type="number"
                                                   step="0.01"
                                                   min="0.01"
                                                   data-field="Monto"
                                                   class="form-control"
                                                   placeholder="Ej. 12500.00"
                                                   required />
                                        </div>

                                        <div class="form-group mb-0">
                                            <label class="small font-weight-bold text-muted cotizacion-label-archivo"></label>
                                            <input type="file"
                                                   data-field="Archivo"
                                                   class="form-control-file"
                                                   accept=".pdf,.jpg,.jpeg,.png,.webp"
                                                   required />
                                        </div>`;

                    return item;
                }

                function reindexarCotizaciones() {
                    if (!contenedorCotizaciones) return;

                    const items = contenedorCotizaciones.querySelectorAll(".cotizacion-item");

                    items.forEach(function(item, index) {
                        const numero = index + 1;
                        item.dataset.index = index;

                        item.querySelector(".cotizacion-titulo").textContent = `Cotización ${numero}`;
                        item.querySelector(".cotizacion-label-proveedor").textContent =
                            `Proveedor de la cotización ${numero}`;
                        item.querySelector(".cotizacion-label-monto").textContent =
                            `Monto total de la cotización ${numero}`;
                        item.querySelector(".cotizacion-label-archivo").textContent =
                            `Archivo de la cotización ${numero}`;

                        item.querySelectorAll("[data-field]").forEach(function(input) {
                            input.name = `Cotizaciones[${index}].${input.dataset.field}`;
                        });

                        const btnEliminar = item.querySelector(".btn-eliminar-cotizacion");
                        btnEliminar.disabled = items.length === 1;
                    });
                }

                if (contenedorCotizaciones && btnAgregarCotizacion) {
                    btnAgregarCotizacion.addEventListener("click", function() {
                        contenedorCotizaciones.appendChild(crearCotizacionItem());
                        reindexarCotizaciones();
                    });

                    contenedorCotizaciones.addEventListener("click", function(event) {
                        const btnEliminar = event.target.closest(".btn-eliminar-cotizacion");
                        if (!btnEliminar) return;

                        const item = btnEliminar.closest(".cotizacion-item");
                        if (!item) return;

                        item.remove();
                        reindexarCotizaciones();
                    });

                    reindexarCotizaciones();
                }

                document.querySelectorAll(".btn-ver-archivo").forEach(function(btn) {
                    btn.addEventListener("click", function() {
                        const ruta = this.dataset.ruta;
                        const titulo = this.dataset.titulo || "Archivo";

                        const url = '@Url.Action("VerArchivoNas", "Compras")' + '?ruta=' + encodeURIComponent(ruta);
                        const body = document.getElementById("modalArchivoBody");

                        document.getElementById("modalArchivoTitulo").innerText = titulo;

                        const rutaLower = ruta.toLowerCase();

                        const esImagen =
                            rutaLower.endsWith(".jpg") ||
                            rutaLower.endsWith(".jpeg") ||
                            rutaLower.endsWith(".png") ||
                            rutaLower.endsWith(".webp");

                        const esExcel =
                            rutaLower.endsWith(".xlsx") ||
                            rutaLower.endsWith(".xls");

                        if (esImagen) {
                            body.innerHTML = `
                                    <div class="d-flex justify-content-center align-items-center h-100 bg-light">
                                        <img src="${url}"
                                             class="img-fluid"
                                             style="max-height:100%; max-width:100%; object-fit:contain;" />
                                    </div>`;
                        }
                        else if (esExcel) {
                            body.innerHTML = `
                                    <div class="d-flex flex-column justify-content-center align-items-center h-100 bg-light text-center p-4">
                                        <i class="fas fa-file-excel fa-4x text-success mb-3"></i>
                                        <h5>El archivo de Excel no se puede previsualizar aquí.</h5>
                                        <p class="text-muted mb-3">
                                            Descárgalo para revisarlo.
                                        </p>
                                        <a href="${url}"
                                           class="btn btn-success"
                                           target="_blank">
                                            Descargar Excel
                                        </a>
                                    </div>`;
                        }
                        else {
                            body.innerHTML = `
                                    <iframe src="${url}#toolbar=0"
                                            width="100%"
                                            height="100%"
                                            style="border:none;">
                                    </iframe>`;
                        }

                        const modal = new bootstrap.Modal(document.getElementById("modalArchivo"));
                        modal.show();
                    });
                });
            });
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const btnEntregarTodo = document.getElementById("btnEntregarTodoPendiente");

                if (btnEntregarTodo) {
                    btnEntregarTodo.addEventListener("click", function() {
                        document.querySelectorAll(".cantidad-entrega:not(:disabled)").forEach(function(input) {
                            input.value = input.dataset.pendiente || "";
                        });
                    });
                }
            });
        </script>

