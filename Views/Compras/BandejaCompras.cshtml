@model SistemaNutri.Models.BandejaComprasDashboardVm
@{
    ViewData["Title"] = "Bandeja de Compras";
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";

    Func<int, string> claseEstatus = estatusId => estatusId switch
    {
        2 => "badge-cotizado",
        3 => "badge-documentacion",
        4 => "badge-presupuesto",
        5 => "badge-autorizada",
        6 => "badge-oc",
        7 => "badge-proveedor",
        8 => "badge-almacen",
        9 => "badge-entrega",
        10 => "badge-cerrada",
        11 => "badge-rechazada",
        12 => "badge-cancelada",
        13 => "badge-parcial",
        14 => "badge-autorizacion-usuario",
        _ => "badge-default"
    };

    Func<int, string> iconoEstatus = estatusId => estatusId switch
    {
        2 => "fas fa-file-invoice-dollar",
        3 => "fas fa-folder-open",
        4 => "fas fa-wallet",
        5 => "fas fa-check-circle",
        6 => "fas fa-file-invoice",
        7 => "fas fa-paper-plane",
        8 => "fas fa-warehouse",
        9 => "fas fa-handshake",
        10 => "fas fa-flag-checkered",
        11 => "fas fa-ban",
        12 => "fas fa-times-circle",
        13 => "fas fa-box-open",
        14 => "fas fa-user-check",
        _ => "fas fa-info-circle"
    };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i> Volver
    </a>
</div>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Bandeja de Gestión de Compras</h1>
    </div>

    <div class="row mb-4 resumen-bandeja">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="resumen-card resumen-pendientes">
                <span class="resumen-icon"><i class="fas fa-file-signature"></i></span>
                <div>
                    <small>Pendientes por cotizar</small>
                    <strong>@Model.TotalPendientes</strong>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="resumen-card resumen-seguimiento">
                <span class="resumen-icon"><i class="fas fa-route"></i></span>
                <div>
                    <small>En seguimiento</small>
                    <strong>@Model.TotalEnSeguimiento</strong>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="resumen-card resumen-autorizacion">
                <span class="resumen-icon"><i class="fas fa-user-check"></i></span>
                <div>
                    <small>Esperando autorización</small>
                    <strong>@Model.TotalPendientesAutorizacionUsuario</strong>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="resumen-card resumen-parcial">
                <span class="resumen-icon"><i class="fas fa-box-open"></i></span>
                <div>
                    <small>Entregas parciales</small>
                    <strong>@Model.TotalEntregasParciales</strong>
                </div>
            </div>
        </div>
    </div>


    @if (Model.EsDireccionCompras)
    {
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary">
                    Carga de Trabajo por Comprador
                </h6>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th>Comprador</th>
                                <th>Puesto</th>
                                <th>Pendientes por cotizar</th>
                                <th>En seguimiento</th>
                                <th>Finalizadas</th>
                                <th>Total asignadas</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.CargaCompradores)
                            {
                                <tr>
                                    <td><strong>@item.NombreCompleto</strong></td>
                                    <td>@item.Puesto</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">@item.Pendientes</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-white">@item.EnSeguimiento</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success text-white">@item.Finalizadas</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary text-white">@item.TotalAsignadas</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


    <div class="card shadow mb-4">

        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">
                Solicitudes Pendientes por Cotizar
            </h6>
        </div>

        <div class="card-body">

            

            <div class="table-responsive">

                <table class="table table-hover" id="tablaBandeja">

                    <thead class="thead-light">
                        <tr>
                            <th>Folio</th>
                            <th>Solicitante</th>
                            <th>Departamento</th>
                            <th>Tipo</th>
                            <th>Categoría / objetivo</th>
                            <th>Fecha</th>
                            @if (Model.EsDireccionCompras)
                            {
                                <th>Asignado a</th>
                            }
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Pendientes)
                        {
                            <tr>

                                <td>
                                    <strong>@item.Folio</strong>
                                </td>

                                <td>@item.Solicitante</td>

                                <td>@item.Departamento</td>

                                <td>
                                    <span class="badge @(item.TipoCompra == "Internacional"
                                                                                                                      ? "bg-warning text-dark"
                                                                                                                      : "bg-info text-white")">

                                        @item.TipoCompra
                                    </span>
                                </td>

                                <td>

                                    @{
                                        bool esUrgente = !string.IsNullOrWhiteSpace(item.Urgencia) &&
                                            item.Urgencia.Contains("URGENT", StringComparison.OrdinalIgnoreCase);
                                    }
                                    <div>
                                        <span class="@(esUrgente ? "text-danger font-weight-bold" : "font-weight-bold")">
                                            @if (esUrgente)
                                            {
                                                <i class="fas fa-bolt mr-1"></i>
                                            }
                                            @item.Urgencia
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(item.TiempoObjetivoCotizacion))
                                        {
                                            <small class="d-block text-muted mt-1">
                                                <i class="fas fa-clock mr-1"></i>@item.TiempoObjetivoCotizacion
                                            </small>
                                        }
                                    </div>

                                </td>

                                <td>
                                    @item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                @if (Model.EsDireccionCompras)
                                {
                                    <td>
                                        <form asp-action="AsignarComprador"
                                              asp-controller="Compras"
                                              method="post"
                                              class="d-flex align-items-center gap-2">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="solicitudId" value="@item.SolicitudID" />

                                            <select name="compradorUsuarioId"
                                                    class="form-control form-control-sm"
                                                    style="min-width:220px;">
                                                @foreach (var comprador in Model.CompradoresDisponibles)
                                                {
                                                    <option value="@comprador.UsuarioID"
                                                            selected="@(item.CompradorAsignadoUsuarioID == comprador.UsuarioID ? "selected" : null)">
                                                        @comprador.NombreCompleto - @comprador.Puesto
                                                    </option>
                                                }
                                            </select>

                                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                                Guardar
                                            </button>
                                        </form>
                                    </td>
                                }

                                <td class="text-center">

                                    <a asp-action="Detalle"
                                       asp-route-id="@item.SolicitudID"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       class="btn btn-primary btn-sm shadow-sm">
                                        Gestionar
                                    </a>

                                </td>

                            </tr>
                        }

                        @if (!Model.Pendientes.Any())
                        {
                            <tr>
                                <td colspan="@(Model.EsDireccionCompras ? 8 : 7)" class="text-center text-muted py-4">
                                    <i class="fas fa-check-circle d-block mb-2 text-success"></i>
                                    No hay solicitudes pendientes por cotizar.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    
    @{
        var seguimiento = Model.Historico
        .Where(x => new[] { 2, 3, 4, 5, 6, 7, 8, 9, 13, 14 }.Contains(x.EstatusID))
        .ToList();

        var finalizadas = Model.Historico
        .Where(x => new[] { 10, 11, 12 }.Contains(x.EstatusID))
        .ToList();
    }

    <div class="card shadow mb-4">

        <div class="card-header py-3 bg-secondary">
            <h6 class="m-0 font-weight-bold text-white">
                Seguimiento e Histórico
            </h6>
        </div>

        <div class="card-body">

            <ul class="nav nav-tabs mb-4" id="tabsCompras">

                <li class="nav-item">
                    <button class="nav-link active"
                            data-bs-toggle="tab"
                            data-bs-target="#tabSeguimiento">

                        En Seguimiento
                        <span class="badge bg-warning text-dark ms-1">
                            @seguimiento.Count
                        </span>

                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#tabFinalizadas">

                        Finalizadas
                        <span class="badge bg-success ms-1">
                            @finalizadas.Count
                        </span>

                    </button>
                </li>

            </ul>

            <div class="tab-content">

                <!-- SEGUIMIENTO -->

                <div class="tab-pane fade show active" id="tabSeguimiento">

                    <div class="table-responsive">

                        <table class="table table-hover">

                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Solicitante</th>
                                    <th>Departamento</th>
                                    <th>Tipo</th>
                                    <th>Monto</th>
                                    <th>Estatus</th>
                                    <th>Detalle</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in seguimiento)
                                {
                                    <tr>
                                        <td><strong>@item.Folio</strong></td>
                                        <td>@item.Solicitante</td>
                                        <td>@item.Departamento</td>
                                        <td>@item.TipoCompra</td>
                                        <td>@item.MontoTotal.ToString("C")</td>

                                        <td>
                                            <span class="badge-estatus @claseEstatus(item.EstatusID)">
                                                <i class="@iconoEstatus(item.EstatusID) mr-1"></i>
                                                @item.Estatus
                                            </span>
                                        </td>

                                        <td>
                                            <a asp-action="Detalle"
                                               asp-route-id="@item.SolicitudID"
                                               asp-route-returnUrl="@Context.Request.Path"
                                               class="btn btn-outline-primary btn-sm">
                                                Ver
                                            </a>
                                        </td>
                                    </tr>
                                }

                                @if (!seguimiento.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            No hay solicitudes activas en seguimiento.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <!-- FINALIZADAS -->

                <div class="tab-pane fade" id="tabFinalizadas">

                    <div class="table-responsive">

                        <table class="table table-hover">

                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Solicitante</th>
                                    <th>Departamento</th>
                                    <th>Tipo</th>
                                    <th>Monto</th>
                                    <th>Estatus</th>
                                    <th>Detalle</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in finalizadas)
                                {
                                    <tr>
                                        <td><strong>@item.Folio</strong></td>
                                        <td>@item.Solicitante</td>
                                        <td>@item.Departamento</td>
                                        <td>@item.TipoCompra</td>
                                        <td>@item.MontoTotal.ToString("C")</td>

                                        <td>
                                            <span class="badge-estatus @claseEstatus(item.EstatusID)">
                                                <i class="@iconoEstatus(item.EstatusID) mr-1"></i>
                                                @item.Estatus
                                            </span>
                                        </td>

                                        <td>
                                            <a asp-action="Detalle"
                                               asp-route-id="@item.SolicitudID"
                                               class="btn btn-outline-primary btn-sm">
                                                Ver
                                            </a>
                                        </td>
                                    </tr>
                                }


                                @if (!finalizadas.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            No hay solicitudes finalizadas.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>
</div>



<style>

    body {
        background: #f5f7fb;
    }

    

    .h3.text-gray-800 {
        color: #0f172a !important;
        font-weight: 800;
        letter-spacing: -0.5px;
        text-transform: none;
    }

    .btn {
        border-radius: 10px;
        font-weight: 700;
        transition: .25s;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .btn-outline-secondary {
        border-color: #cbd5e1;
        color: #475569;
    }

        .btn-outline-secondary:hover {
            background: #475569;
            color: #fff;
        }



    .card {
        border: 1px solid #e2e8f0 !important;
        border-radius: 18px !important;
        overflow: hidden;
        box-shadow: 0 12px 28px rgba(15,23,42,.08) !important;
    }

    .card-header {
        background: white !important;
        border-bottom: 1px solid #e2e8f0 !important;
    }

        .card-header h6 {
            font-weight: 800;
            margin: 0;
        }

        .card-header.bg-secondary {
            background: linear-gradient( 135deg, #475569, #334155 ) !important;
        }

    

    #tablaBandeja {
        border-collapse: separate;
        border-spacing: 0 .6rem;
    }

        #tablaBandeja thead th {
            background: #f8fafc;
            color: #334155;
            text-transform: uppercase;
            font-size: .72rem;
            letter-spacing: .5px;
            border: none;
            padding: 14px;
            font-weight: 800;
        }

        #tablaBandeja tbody tr {
            background: white;
            transition: .2s;
        }

            #tablaBandeja tbody tr:hover {
                background: #fff7ed !important;
                transform: translateY(-1px);
            }

        #tablaBandeja td {
            vertical-align: middle;
            padding: 14px;
            border-top: 1px solid #e2e8f0;
            border-bottom: 1px solid #e2e8f0;
        }

            #tablaBandeja td:first-child {
                border-left: 1px solid #e2e8f0;
                border-radius: 12px 0 0 12px;
            }

            #tablaBandeja td:last-child {
                border-right: 1px solid #e2e8f0;
                border-radius: 0 12px 12px 0;
            }

        #tablaBandeja strong {
            color: #2563eb;
            font-weight: 800;
        }

   

    .table-hover tbody tr:hover {
        background: #fff7ed;
    }

    .table thead th {
        background: #f8fafc;
        color: #334155;
        border-bottom: 2px solid #e2e8f0;
        text-transform: uppercase;
        font-size: .72rem;
    }

  

    .badge {
        padding: .5rem .75rem;
        border-radius: 999px;
        font-weight: 700;
    }

    /* Nacional */

    .bg-info.text-white {
        background: #2563eb !important;
        color: white !important;
    }

    /* Internacional */

    .bg-warning.text-dark {
        background: #f97316 !important;
        color: white !important;
    }

    /* Presupuesto */

    .bg-warning {
        background: #f59e0b !important;
    }

    /* Rechazada */

    .bg-danger {
        background: #dc2626 !important;
    }

    /* Cerrada */

    .bg-success {
        background: #16a34a !important;
    }

    /* Solicitada */

    .bg-secondary {
        background: #64748b !important;
    }

    

    .text-danger.font-weight-bold {
        color: #dc2626 !important;
        font-weight: 800 !important;
    }

        .text-danger.font-weight-bold i {
            margin-right: 4px;
        }


    select.form-control-sm {
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        min-height: 38px;
    }

        select.form-control-sm:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .15rem rgba(37,99,235,.15);
        }

    

    .btn-outline-primary {
        border-color: #2563eb;
        color: #2563eb;
        font-weight: 700;
    }

        .btn-outline-primary:hover {
            background: #2563eb;
            color: white;
        }

   

    .btn-primary.btn-sm {
        background: #2563eb !important;
        border: none;
        padding: .5rem .9rem;
        border-radius: 10px;
        font-weight: 700;
    }

        .btn-primary.btn-sm:hover {
            background: #f97316 !important;
            box-shadow: 0 8px 18px rgba(249,115,22,.25);
        }

  

    .table-responsive table tbody tr td {
        vertical-align: middle;
    }

    .table-responsive table strong {
        color: #0f172a;
    }


    .resumen-card {
        min-height: 105px;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.15rem;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .07);
    }

        .resumen-card .resumen-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            font-size: 1.1rem;
        }

        .resumen-card small {
            display: block;
            color: #64748b;
            font-weight: 700;
            margin-bottom: .15rem;
        }

        .resumen-card strong {
            display: block;
            color: #0f172a;
            font-size: 1.5rem;
            line-height: 1;
        }

    .resumen-pendientes .resumen-icon {
        background: #fff7ed;
        color: #ea580c;
    }

    .resumen-seguimiento .resumen-icon {
        background: #eff6ff;
        color: #2563eb;
    }

    .resumen-autorizacion .resumen-icon {
        background: #faf5ff;
        color: #9333ea;
    }

    .resumen-parcial .resumen-icon {
        background: #fff7ed;
        color: #f97316;
    }

    .badge-estatus {
        display: inline-flex;
        align-items: center;
        max-width: 100%;
        padding: .48rem .7rem;
        border-radius: 999px;
        font-size: .74rem;
        font-weight: 800;
        line-height: 1.2;
        white-space: normal;
    }

    .badge-cotizado {
        background: #ecfeff;
        color: #0e7490;
    }

    .badge-documentacion {
        background: #e0f2fe;
        color: #0369a1;
    }

    .badge-presupuesto {
        background: #f3e8ff;
        color: #7e22ce;
    }

    .badge-autorizada {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .badge-oc {
        background: #fce7f3;
        color: #be185d;
    }

    .badge-proveedor {
        background: #e0f2fe;
        color: #0369a1;
    }

    .badge-almacen {
        background: #f1f5f9;
        color: #475569;
    }

    .badge-entrega {
        background: #ccfbf1;
        color: #0f766e;
    }

    .badge-cerrada {
        background: #dcfce7;
        color: #15803d;
    }

    .badge-rechazada {
        background: #fee2e2;
        color: #b91c1c;
    }

    .badge-cancelada {
        background: #e2e8f0;
        color: #334155;
    }

    .badge-parcial {
        background: #ffedd5;
        color: #c2410c;
    }

    .badge-autorizacion-usuario {
        background: #f3e8ff;
        color: #7e22ce;
    }

    .badge-default {
        background: #f1f5f9;
        color: #475569;
    }

    @@media (max-width: 768px) {
        .btn {
            width: 100%;
            margin-bottom: 6px;
        }

        .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 10px;
        }

        select.form-control-sm {
            min-width: 100% !important;
        }
    }
</style>

 