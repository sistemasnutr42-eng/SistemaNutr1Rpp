            mostrarLoading();
            try {
                let result;
                if (subMenuId > 0) {
                    result = await postForm('/AdministracionMenus/EditarSubMenu', {
                        SubMenuID: subMenuId,
                        MenuID: menuId,
                        Nombre: nombre,
                        UrlEnlace: url,
                        Descripcion: descripcion
