@section Scripts
{
    <script>

        let modalGrupo;
        let modalMenu;
        let modalSubMenu;
        let modalAcciones;
        let modalPermisosRol;


        document.addEventListener(
            'DOMContentLoaded',
            function () {

                modalGrupo =
                    bootstrap.Modal.getOrCreateInstance(
                        document.getElementById('modalGrupo')
                    );

                modalMenu =
                    bootstrap.Modal.getOrCreateInstance(
                        document.getElementById('modalMenu')
                    );

                modalSubMenu =
                    bootstrap.Modal.getOrCreateInstance(
                        document.getElementById('modalSubMenu')
                    );

                modalAcciones =
                    bootstrap.Modal.getOrCreateInstance(
                        document.getElementById('modalAcciones')
                    );

                modalPermisosRol =
                    bootstrap.Modal.getOrCreateInstance(
                        document.getElementById('modalPermisosRol')
                    );

                configurarDependenciasPermisos();


                document
                    .querySelectorAll('.icon-picker-button')
                    .forEach(
                        function (button) {

                            button.addEventListener(
                                'click',
                                function () {

                                    const icono =
                                        button.dataset.icon;

                                    document
                                        .getElementById('grupoIcono')
                                        .value = icono;

                                    marcarIconoSeleccionado(icono);

                                }
                            );

                        }
                    );


                document
                    .getElementById('txtBuscarMenu')
                    ?.addEventListener(
                        'input',
                        filtrarArbol
                    );

            }
        );


        function obtenerToken() {

            return document
                .querySelector(
                    'input[name="__RequestVerificationToken"]'
                )
