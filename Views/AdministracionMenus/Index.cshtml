        async function obtenerRolesAdministracion() {
            const response = await fetch('/AdministracionMenus/ObtenerRoles', {
                method: 'GET',
                credentials: 'same-origin'
            });
            let result = {};
            try { result = await response.json(); } catch { }
            if (!response.ok || !result.ok)
                throw new Error(result?.mensaje ?? 'No fue posible obtener los roles.');
            return result.roles ?? [];
        }

        async function cargarRolesCreacionSubMenu() {
            const contenedor = document.getElementById('subRolesLista');
            try {
                const roles = await obtenerRolesAdministracion();
                if (!roles.length) {
                    contenedor.innerHTML = '<div class="role-loading">No existen roles disponibles.</div>';
                    return;
                }
                contenedor.innerHTML = '';
                roles.forEach(function (rol) {
                    const rolId = Number(rol.rolId ?? rol.RolID ?? 0);
                    const nombre = rol.nombre ?? rol.Nombre ?? '';
                    const esAdministrador = rol.esAdministrador === true || rol.EsAdministrador === true;
                    const label = document.createElement('label');
                    label.className = `role-option${esAdministrador ? ' admin-role' : ''}`;
                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.className = 'sub-role-checkbox';
                    checkbox.value = rolId;
                    checkbox.checked = esAdministrador;
                    checkbox.disabled = esAdministrador;
                    const texto = document.createElement('div');
                    texto.className = 'role-option-text';
                    const nombreDiv = document.createElement('div');
                    nombreDiv.className = 'role-option-name';
                    nombreDiv.textContent = nombre;
                    const nota = document.createElement('div');
                    nota.className = 'role-option-note';
                    nota.textContent = esAdministrador ? 'Acceso administrativo obligatorio' : 'Seleccionar para otorgar acceso';
                    texto.appendChild(nombreDiv);
                    texto.appendChild(nota);
                    label.appendChild(checkbox);
                    label.appendChild(texto);
                    contenedor.appendChild(label);
                });
            }
            catch (error) {
                contenedor.innerHTML = '<div class="role-loading">No fue posible cargar los roles.</div>';
                mostrarMensaje('mensajeSubMenu', error.message);
            }
        }

        function configurarDependenciasPermisos() {
            const grupos = [
                ['subAccionVer', 'subAccionCrear', 'subAccionEditar', 'subAccionEliminar'],
                ['accionVer', 'accionCrear', 'accionEditar', 'accionEliminar'],
                ['rolPermisoVer', 'rolPermisoCrear', 'rolPermisoEditar', 'rolPermisoEliminar']
            ];
            grupos.forEach(function (ids) {
                const ver = document.getElementById(ids[0]);
                const otros = ids.slice(1).map(id => document.getElementById(id)).filter(Boolean);
                if (!ver) return;
                otros.forEach(function (check) {
                    check.addEventListener('change', function () {
                        if (check.checked) ver.checked = true;
                    });
                });
                ver.addEventListener('change', function () {
                    if (!ver.checked && otros.some(x => x.checked)) ver.checked = true;
                });
            });
        }

        async function abrirPermisosRol(subMenuId, nombre) {
            limpiarMensaje('mensajePermisosRol');
            document.getElementById('permisosRolSubMenuId').value = subMenuId;
            document.getElementById('permisosRolSubMenuNombre').value = nombre ?? '';
            document.getElementById('permisosRolSelect').innerHTML = '<option value="">Cargando roles...</option>';
            document.getElementById('resumenRolesSubMenu').innerHTML = '<span class="role-summary-chip">Cargando...</span>';
            establecerEstadoPermisosRol(false, false, false, false, false, false, false, false, true);
            modalPermisosRol.show();
            mostrarLoading();
            try {
                const roles = await obtenerRolesAdministracion();
                const select = document.getElementById('permisosRolSelect');
                select.innerHTML = '<option value="">Selecciona un rol</option>';
                roles.forEach(function (rol) {
                    const option = document.createElement('option');
                    option.value = Number(rol.rolId ?? rol.RolID ?? 0);
                    option.textContent = rol.nombre ?? rol.Nombre ?? '';
                    option.dataset.esAdministrador = (rol.esAdministrador === true || rol.EsAdministrador === true) ? 'true' : 'false';
                    select.appendChild(option);
                });
                const primerNoAdmin = Array.from(select.options).find(x => x.value && x.dataset.esAdministrador !== 'true');
                const primero = primerNoAdmin ?? Array.from(select.options).find(x => x.value);
                if (primero) select.value = primero.value;
                await Promise.all([
                    cargarPermisosRolSeleccionado(),
                    cargarResumenRolesSubMenu()
                ]);
            }
            catch (error) {
                mostrarMensaje('mensajePermisosRol', error.message);
            }
            finally {
                ocultarLoading();
            }
        }

        function establecerEstadoPermisosRol(ver, crear, editar, eliminar, disponibleVer, disponibleCrear, disponibleEditar, disponibleEliminar, bloquearTodo) {
            const configuracion = [
                ['rolPermisoVer', ver, disponibleVer],
                ['rolPermisoCrear', crear, disponibleCrear],
                ['rolPermisoEditar', editar, disponibleEditar],
                ['rolPermisoEliminar', eliminar, disponibleEliminar]
            ];
            configuracion.forEach(function (item) {
                const input = document.getElementById(item[0]);
                input.checked = item[1] === true;
                input.disabled = bloquearTodo === true || item[2] !== true;
            });
            document.getElementById('btnGuardarPermisosRol').disabled = bloquearTodo === true;
        }

        async function cargarPermisosRolSeleccionado() {
            limpiarMensaje('mensajePermisosRol');
            const subMenuId = Number(document.getElementById('permisosRolSubMenuId').value) || 0;
            const select = document.getElementById('permisosRolSelect');
            const rolId = Number(select.value) || 0;
            if (!subMenuId || !rolId) {
                establecerEstadoPermisosRol(false, false, false, false, false, false, false, false, true);
                document.getElementById('ayudaPermisosRol').textContent = 'Selecciona un rol para consultar y modificar sus permisos.';
                return;
            }
            const opcion = select.options[select.selectedIndex];
            const esAdministrador = opcion?.dataset?.esAdministrador === 'true';
            try {
                const response = await fetch(`/AdministracionMenus/ObtenerPermisosSubMenuRol?subMenuId=${encodeURIComponent(subMenuId)}&rolId=${encodeURIComponent(rolId)}`, {
                    method: 'GET',
                    credentials: 'same-origin'
                });
                let result = {};
                try { result = await response.json(); } catch { }
                if (!response.ok || !result.ok)
                    throw new Error(result?.mensaje ?? 'No fue posible consultar los permisos del rol.');
                const p = result.permisos ?? {};
                const d = result.disponibles ?? {};
                establecerEstadoPermisosRol(
                    p.ver === true,
                    p.crear === true,
                    p.editar === true,
                    p.eliminar === true,
                    d.ver === true,
                    d.crear === true,
                    d.editar === true,
                    d.eliminar === true,
                    esAdministrador
                );
                document.getElementById('ayudaPermisosRol').textContent = esAdministrador
                    ? 'El Administrador conserva automáticamente todas las acciones disponibles.'
                    : 'Activa únicamente las acciones que este rol podrá ejecutar. Para Crear, Editar o Eliminar también se requiere Ver.';
            }
            catch (error) {
                establecerEstadoPermisosRol(false, false, false, false, false, false, false, false, true);
                mostrarMensaje('mensajePermisosRol', error.message);
            }
        }

        async function cargarResumenRolesSubMenu() {
            const subMenuId = Number(document.getElementById('permisosRolSubMenuId').value) || 0;
            const contenedor = document.getElementById('resumenRolesSubMenu');
            if (!subMenuId) return;
            try {
                const response = await fetch(`/AdministracionMenus/ObtenerResumenRolesSubMenu?subMenuId=${encodeURIComponent(subMenuId)}`, {
                    method: 'GET',
                    credentials: 'same-origin'
                });
                let result = {};
                try { result = await response.json(); } catch { }
                if (!response.ok || !result.ok)
                    throw new Error(result?.mensaje ?? 'No fue posible obtener el resumen de roles.');
                const roles = result.roles ?? [];
                contenedor.innerHTML = '';
                if (!roles.length) {
                    contenedor.innerHTML = '<span class="role-summary-chip">Sin roles</span>';
                    return;
                }
                roles.forEach(function (rol) {
                    const chip = document.createElement('span');
                    chip.className = `role-summary-chip${rol.tieneAcceso === true ? ' enabled' : ''}`;
                    const acciones = [];
                    if (rol.ver === true) acciones.push('Ver');
                    if (rol.crear === true) acciones.push('Crear');
                    if (rol.editar === true) acciones.push('Editar');
                    if (rol.eliminar === true) acciones.push('Eliminar');
                    chip.textContent = `${rol.nombre}: ${acciones.length ? acciones.join(', ') : 'Sin acceso'}`;
                    contenedor.appendChild(chip);
                });
            }
            catch (error) {
                contenedor.innerHTML = '<span class="role-summary-chip">No disponible</span>';
            }
        }

        async function guardarPermisosRol() {
            limpiarMensaje('mensajePermisosRol');
            const subMenuId = Number(document.getElementById('permisosRolSubMenuId').value) || 0;
            const select = document.getElementById('permisosRolSelect');
            const rolId = Number(select.value) || 0;
            if (!subMenuId || !rolId) {
                mostrarMensaje('mensajePermisosRol', 'Selecciona un rol.');
                return;
            }
            const opcion = select.options[select.selectedIndex];
            if (opcion?.dataset?.esAdministrador === 'true') {
                mostrarMensaje('mensajePermisosRol', 'Los permisos del Administrador se mantienen automáticamente activos.');
                return;
            }
            const crear = document.getElementById('rolPermisoCrear').checked;
            const editar = document.getElementById('rolPermisoEditar').checked;
            const eliminar = document.getElementById('rolPermisoEliminar').checked;
            const ver = document.getElementById('rolPermisoVer').checked || crear || editar || eliminar;
            document.getElementById('rolPermisoVer').checked = ver;
            mostrarLoading();
            try {
                const result = await postForm('/AdministracionMenus/GuardarPermisosSubMenuRol', {
                    subMenuId: subMenuId,
                    rolId: rolId,
                    ver: ver,
                    crear: crear,
                    editar: editar,
                    eliminar: eliminar
                });
                if (!result.ok) {
                    mostrarMensaje('mensajePermisosRol', result.mensaje);
                    return;
                }
                mostrarMensaje('mensajePermisosRol', result.mensaje, 'success');
                await cargarResumenRolesSubMenu();
                await cargarPermisosRolSeleccionado();
            }
            catch (error) {
                mostrarMensaje('mensajePermisosRol', error.message);
            }
            finally {
                ocultarLoading();
            }
        }

        /* =========================================================
           ACCIONES
           ========================================================= */

        function abrirAcciones(
            subMenuId,
            nombre,
            ver,
            crear,
            editar,
            eliminar
        ) {

            limpiarMensaje(
                'mensajeAcciones'
            );

            document
                .getElementById('accionesSubMenuId')
                .value =
                subMenuId;

            document
                .getElementById('accionesSubMenuNombre')
                .value =
                nombre ?? '';

            document
                .getElementById('accionVer')
                .checked =
                ver === true;

            document
                .getElementById('accionCrear')
                .checked =
                crear === true;

            document
                .getElementById('accionEditar')
                .checked =
                editar === true;

            document
                .getElementById('accionEliminar')
                .checked =
                eliminar === true;

            modalAcciones.show();

        }


        async function guardarAcciones() {

            limpiarMensaje(
                'mensajeAcciones'
            );

            const subMenuId =
                Number(
                    document
                        .getElementById('accionesSubMenuId')
                        .value
                ) || 0;


            mostrarLoading();


            try {

                const result =
                    await postForm(
                        '/AdministracionMenus/GuardarAccionesSubMenu',
                        {
                            SubMenuID:
                                subMenuId,

                            Ver:
                                document
                                    .getElementById('accionVer')
                                    .checked,

                            Crear:
                                document
                                    .getElementById('accionCrear')
                                    .checked,

                            Editar:
                                document
                                    .getElementById('accionEditar')
                                    .checked,

                            Eliminar:
                                document
                                    .getElementById('accionEliminar')
                                    .checked
                        }
                    );


                if (!result.ok) {

                    mostrarMensaje(
                        'mensajeAcciones',
                        result.mensaje
                    );

                    return;

                }


                mostrarMensaje(
                    'mensajeAcciones',
                    result.mensaje,
                    'success'
                );


                setTimeout(
                    recargarPagina,
                    600
                );

            }
            catch (error) {

                mostrarMensaje(
                    'mensajeAcciones',
                    error.message
                );

            }
            finally {

                ocultarLoading();

            }

        }

    </script>
}