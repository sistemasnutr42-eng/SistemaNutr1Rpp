@using System.Text.Encodings.Web
@model SistemaNutri.Models.AdministracionMenusVm

@{
    Layout = "~/Views/Shared/_LayoutSistema.cshtml";
    ViewData["Title"] = "Administración de menús";
}

@Html.AntiForgeryToken()

@section Estilos
{
    <style>
        .menu-admin-page {
            width: 100%;
        }

        .menu-admin-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 20px;
        }

        .menu-admin-title-area {
            min-width: 0;
        }

        .menu-admin-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #58A83F;
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            margin-bottom: 5px;
        }

        .menu-admin-title {
            margin: 0;
            color: #062F55;
            font-size: 1.55rem;
            font-weight: 800;
        }

        .menu-admin-description {
            margin: 5px 0 0;
            color: #667085;
            font-size: .82rem;
            line-height: 1.5;
        }

        .btn-menu-primary {
            border: 0;
            border-radius: 11px;
            padding: 10px 15px;
            background: #084F83;
            color: #fff;
            font-size: .78rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: .18s ease;
        }

            .btn-menu-primary:hover {
                background: #063D69;
                color: #fff;
                transform: translateY(-1px);
            }

        .admin-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            padding: 14px 16px;
            margin-bottom: 16px;
            border: 1px solid #E4E9EF;
            border-radius: 14px;
            background: #fff;
            box-shadow: 0 6px 18px rgba(15, 23, 42, .04);
        }

        .toolbar-search {
            position: relative;
            flex: 1;
            min-width: 220px;
            max-width: 420px;
        }

            .toolbar-search i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: #98A2B3;
                font-size: .8rem;
            }

            .toolbar-search input {
                width: 100%;
                height: 40px;
                padding: 0 13px 0 36px;
                border: 1px solid #DCE2E8;
                border-radius: 10px;
                outline: none;
                color: #344054;
                font-size: .78rem;
            }

                .toolbar-search input:focus {
                    border-color: #0B6FAF;
                    box-shadow: 0 0 0 3px rgba(11, 111, 175, .08);
                }

        .toolbar-help {
            color: #667085;
            font-size: .72rem;
        }

        .menu-tree {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .group-card {
            overflow: hidden;
            border: 1px solid #DEE5EB;
            border-radius: 17px;
            background: #fff;
            box-shadow: 0 7px 20px rgba(15, 23, 42, .045);
            transition: .18s ease;
        }

            .group-card.inactive {
                opacity: .63;
            }

        .group-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 15px 17px;
            background: linear-gradient(90deg, #F8FBFD 0%, #FFFFFF 100%);
            border-bottom: 1px solid #EDF1F4;
        }

        .group-card-main {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
            cursor: pointer;
            flex: 1;
        }

        .group-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            color: #084F83;
            background: #EBF4FA;
            font-size: 1rem;
        }

        .group-card.inactive .group-icon {
            color: #98A2B3;
            background: #F2F4F7;
        }

        .group-info {
            min-width: 0;
        }

        .group-name-row {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .group-name {
            color: #17324A;
            font-size: .9rem;
            font-weight: 800;
        }

        .group-description {
            margin-top: 2px;
            color: #84909C;
            font-size: .7rem;
        }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 7px;
            border-radius: 999px;
            font-size: .6rem;
            font-weight: 700;
        }

        .badge-active {
            color: #347526;
            background: #EDF7E9;
        }

        .badge-inactive {
            color: #8B5E00;
            background: #FFF6DC;
        }

        .badge-order {
            color: #475467;
            background: #F2F4F7;
        }

        .group-actions,
        .menu-actions,
        .submenu-actions-buttons {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .tree-action {
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            color: #667085;
            transition: .15s ease;
        }

            .tree-action:hover {
                background: #EEF4F8;
                color: #084F83;
            }

            .tree-action.success:hover {
                background: #EDF7E9;
                color: #58A83F;
            }

            .tree-action.danger:hover {
                background: #FFF0F0;
                color: #D92D20;
            }

            .tree-action:disabled {
                opacity: .35;
                cursor: not-allowed;
                pointer-events: none;
            }

        .group-toggle {
            color: #98A2B3;
            transition: transform .2s ease;
        }

        .group-card.open .group-toggle {
            transform: rotate(180deg);
        }

        .group-content {
            display: none;
            padding: 13px;
            background: #FBFCFD;
        }

        .group-card.open .group-content {
            display: block;
        }

        .empty-group {
            padding: 22px;
            text-align: center;
            border: 1px dashed #D8E0E7;
            border-radius: 12px;
            color: #98A2B3;
            background: #fff;
            font-size: .73rem;
        }

            .empty-group i {
                display: block;
                font-size: 1.4rem;
                margin-bottom: 7px;
                color: #B7C0C9;
            }

        .menu-node {
            border: 1px solid #E5E9EE;
            border-radius: 13px;
            overflow: hidden;
            background: #fff;
        }

            .menu-node + .menu-node {
                margin-top: 9px;
            }

        .menu-node-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 13px;
            background: #fff;
        }

        .menu-node-main {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            flex: 1;
            cursor: pointer;
        }

        .menu-node-icon {
            width: 31px;
            height: 31px;
            min-width: 31px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #F2F6F9;
            color: #52677A;
            font-size: .78rem;
        }

        .menu-node-name {
            color: #344054;
            font-size: .78rem;
            font-weight: 750;
        }

        .menu-node-count {
            color: #98A2B3;
            font-size: .63rem;
            margin-top: 2px;
        }

        .menu-toggle {
            color: #A5ADB6;
            transition: transform .2s ease;
        }

        .menu-node.open .menu-toggle {
            transform: rotate(180deg);
        }

        .menu-node-content {
            display: none;
            padding: 0 12px 12px 53px;
            background: #fff;
        }

        .menu-node.open .menu-node-content {
            display: block;
        }

        .submenu-row {
            display: grid;
            grid-template-columns: minmax(180px, 1fr) minmax(210px, 1.25fr) auto;
            gap: 12px;
            align-items: center;
            padding: 10px 11px;
            border-radius: 10px;
            background: #F8FAFC;
            border: 1px solid #EEF1F4;
        }

            .submenu-row + .submenu-row {
                margin-top: 7px;
            }

            .submenu-row.inactive {
                opacity: .58;
            }

        .submenu-info {
            min-width: 0;
        }

        .submenu-name {
            color: #344054;
            font-size: .73rem;
            font-weight: 700;
        }

        .submenu-description {
            color: #98A2B3;
            font-size: .62rem;
            margin-top: 2px;
        }

        .submenu-url {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: .66rem;
            color: #667085;
            font-family: Consolas, monospace;
        }

        .action-chips {
            display: flex;
            align-items: center;
            gap: 5px;
            flex-wrap: wrap;
            margin-top: 6px;
        }

        .action-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 6px;
            border-radius: 999px;
            font-size: .56rem;
            font-weight: 700;
            background: #F2F4F7;
            color: #667085;
        }

            .action-chip.enabled {
                background: #EDF7E9;
                color: #408130;
            }

            .action-chip i {
                font-size: .52rem;
            }

        .modal-menu .modal-content {
            border: 0;
            border-radius: 17px;
            box-shadow: 0 24px 70px rgba(15, 23, 42, .18);
        }

        .modal-menu .modal-header {
            padding: 16px 19px;
            border-bottom: 1px solid #EEF1F4;
        }

        .modal-menu .modal-title {
            color: #17324A;
            font-size: .96rem;
            font-weight: 800;
        }

        .modal-menu .modal-body {
            padding: 18px 19px;
        }

        .modal-menu .modal-footer {
            padding: 13px 19px;
            border-top: 1px solid #EEF1F4;
        }

        .form-label-menu {
            display: block;
            margin-bottom: 5px;
            color: #475467;
            font-size: .7rem;
            font-weight: 700;
        }

        .form-control-menu,
        .form-select-menu {
            width: 100%;
            min-height: 40px;
            padding: 8px 11px;
            border: 1px solid #DCE2E8;
            border-radius: 9px;
            color: #344054;
            font-size: .76rem;
            outline: none;
            background: #fff;
        }

        textarea.form-control-menu {
            resize: vertical;
            min-height: 80px;
        }

        .form-control-menu:focus,
        .form-select-menu:focus {
            border-color: #0B6FAF;
            box-shadow: 0 0 0 3px rgba(11, 111, 175, .08);
        }

        .form-help {
            margin-top: 4px;
            color: #98A2B3;
            font-size: .61rem;
        }

        .icon-picker {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 7px;
            margin-top: 7px;
        }

        .icon-picker-button {
            height: 39px;
            border: 1px solid #E2E7EC;
            border-radius: 9px;
            background: #fff;
            color: #667085;
            transition: .14s ease;
        }

            .icon-picker-button:hover,
            .icon-picker-button.selected {
                border-color: #0B6FAF;
                background: #EDF6FC;
                color: #084F83;
            }

        .permissions-box {
            padding: 12px;
            border-radius: 11px;
            background: #F8FAFC;
            border: 1px solid #E8ECF0;
        }

        .permissions-title {
            margin-bottom: 8px;
            color: #344054;
            font-size: .71rem;
            font-weight: 750;
        }

        .permissions-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .permission-option {
            min-height: 40px;
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 8px;
            border: 1px solid #E3E7EC;
            border-radius: 9px;
            background: #fff;
            font-size: .67rem;
            color: #475467;
        }

            .permission-option input {
                accent-color: #58A83F;
            }

        .roles-selector {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .role-option {
            min-height: 46px;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 10px;
            border: 1px solid #E3E7EC;
            border-radius: 10px;
            background: #fff;
            color: #475467;
            font-size: .68rem;
            cursor: pointer;
        }

            .role-option:hover {
                border-color: #B9D4E6;
                background: #F8FBFD;
            }

            .role-option input {
                accent-color: #58A83F;
            }

            .role-option.admin-role {
                border-color: #CFE4F2;
                background: #F2F8FC;
            }

        .role-option-text {
            min-width: 0;
            flex: 1;
        }

        .role-option-name {
            color: #344054;
            font-weight: 750;
        }

        .role-option-note {
            margin-top: 1px;
            color: #98A2B3;
            font-size: .58rem;
        }

        .role-summary-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 9px;
        }

        .role-summary-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 8px;
            border-radius: 999px;
            background: #F2F4F7;
            color: #667085;
            font-size: .6rem;
            font-weight: 700;
        }

            .role-summary-chip.enabled {
                background: #EDF7E9;
                color: #347526;
            }

        .role-loading {
            padding: 14px;
            border: 1px dashed #D8E0E7;
            border-radius: 10px;
            color: #98A2B3;
            text-align: center;
            font-size: .68rem;
        }

        .menu-role-note {
            display: flex;
            gap: 9px;
            padding: 10px 11px;
            margin-top: 12px;
            border: 1px solid #DCEAF4;
            border-radius: 10px;
            background: #F5FAFD;
            color: #52677A;
            font-size: .66rem;
            line-height: 1.45;
        }

            .menu-role-note i {
                margin-top: 2px;
                color: #0B6FAF;
            }

        .modal-message {
            display: none;
            margin-bottom: 13px;
            padding: 9px 11px;
            border-radius: 9px;
            font-size: .7rem;
        }

            .modal-message.error {
                display: block;
                background: #FFF1F1;
                color: #B42318;
            }

            .modal-message.success {
                display: block;
                background: #EDF7E9;
                color: #347526;
            }

        .loading-overlay-admin {
            position: fixed;
            inset: 0;
            z-index: 4000;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(15, 23, 42, .18);
            backdrop-filter: blur(2px);
        }

            .loading-overlay-admin.show {
                display: flex;
            }

        .loading-box-admin {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 17px;
            border-radius: 12px;
            background: #fff;
            color: #344054;
            box-shadow: 0 18px 55px rgba(15, 23, 42, .18);
            font-size: .76rem;
            font-weight: 700;
        }

        @@media (max-width: 950px) {
            .submenu-row {
                grid-template-columns: 1fr;
            }

            .submenu-actions-buttons {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 700px) {
            .menu-admin-header {
                flex-direction: column;
            }

                .menu-admin-header .btn-menu-primary {
                    width: 100%;
                    justify-content: center;
                }

            .group-card-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .group-actions {
                width: 100%;
                justify-content: flex-end;
            }

            .menu-node-header {
                align-items: flex-start;
            }

            .menu-node-content {
                padding-left: 12px;
            }

            .permissions-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .roles-selector {
                grid-template-columns: 1fr;
            }

            .icon-picker {
                grid-template-columns: repeat(5, 1fr);
            }
        }
    </style>
}

<div class="menu-admin-page">

    <div class="menu-admin-header">
        <div class="menu-admin-title-area">
            <div class="menu-admin-eyebrow">
                <i class="fa-solid fa-sitemap"></i>
                Configuración
            </div>

            <h1 class="menu-admin-title">
                Administración de menús
            </h1>

            <p class="menu-admin-description">
                Crea y organiza grupos, menús, submenús, acciones y permisos sin modificar directamente la base de datos.
            </p>
        </div>

        <button type="button"
                class="btn-menu-primary"
                onclick="abrirCrearGrupo()">
            <i class="fa-solid fa-plus"></i>
            Nuevo grupo
        </button>
    </div>

    <div class="admin-toolbar">
        <div class="toolbar-search">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   id="txtBuscarMenu"
                   placeholder="Buscar grupo, menú o submenú..." />
        </div>

        <div class="toolbar-help">
            <i class="fa-solid fa-circle-info me-1"></i>
            Los grupos inactivos permanecen visibles aquí para poder reactivarlos, pero se ocultan del menú lateral.
        </div>
    </div>

    <div class="menu-tree"
         id="menuTree">

        @if (Model?.Grupos != null &&
                Model.Grupos.Any())
        {
            foreach (var grupo in Model.Grupos.OrderBy(x => x.Orden))
            {
                var claseGrupo =
                grupo.Activo
                ? ""
                : "inactive";

                <section class="group-card @claseGrupo"
                         data-search="@($"{grupo.Nombre} {grupo.Descripcion}".ToLowerInvariant())"
                         data-grupo-id="@grupo.MenuGrupoID">

                    <div class="group-card-header">

                        <div class="group-card-main"
                             onclick="toggleGrupo(this)">

                            <div class="group-icon">

                                @if (!string.IsNullOrWhiteSpace(grupo.IconoCss))
                                {
                                    <i class="@grupo.IconoCss"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-layer-group"></i>
                                }

                            </div>

                            <div class="group-info">

                                <div class="group-name-row">

                                    <span class="group-name">
                                        @grupo.Nombre
                                    </span>

                                    @if (grupo.Activo)
                                    {
                                        <span class="badge-status badge-active">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-inactive">
                                            <i class="fa-solid fa-circle-pause"></i>
                                            Inactivo
                                        </span>
                                    }

                                    <span class="badge-status badge-order">
                                        Orden @grupo.Orden
                                    </span>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(grupo.Descripcion))
                                {
                                    <div class="group-description">
                                        @grupo.Descripcion
                                    </div>
                                }

                            </div>

                            <i class="fa-solid fa-chevron-down group-toggle ms-auto"></i>

                        </div>

                        <div class="group-actions">

                            <button type="button"
                                    class="tree-action success"
                                    title="@(grupo.Activo ? "Agregar menú" : "Activa el grupo para agregar menús")"
                                    disabled="@(!grupo.Activo)"
                                    onclick="abrirCrearMenu(@grupo.MenuGrupoID, '@Html.Raw(JavaScriptEncoder.Default.Encode(grupo.Nombre))')">
                                <i class="fa-solid fa-plus"></i>
                            </button>

                            <button type="button"
                                    class="tree-action"
                                    title="Editar grupo"
                                    onclick="abrirEditarGrupo(
                                                                @grupo.MenuGrupoID,
                                                                '@Html.Raw(JavaScriptEncoder.Default.Encode(grupo.Nombre))',
                                                                '@Html.Raw(JavaScriptEncoder.Default.Encode(grupo.Descripcion ?? ""))',
                                                                '@Html.Raw(JavaScriptEncoder.Default.Encode(grupo.IconoCss ?? ""))',
                                                                @grupo.Orden)">
                                <i class="fa-solid fa-pen"></i>
                            </button>

                            <button type="button"
                                    class="tree-action @(grupo.Activo ? "danger" : "success")"
                                    title="@(grupo.Activo ? "Desactivar" : "Activar")"
                                    onclick="cambiarEstadoGrupo(@grupo.MenuGrupoID, @(grupo.Activo ? "false" : "true"))">

                                <i class="fa-solid @(grupo.Activo ? "fa-toggle-on" : "fa-toggle-off")"></i>

                            </button>

                        </div>

                    </div>

                    <div class="group-content">

                        @if (grupo.Menus != null &&
                                        grupo.Menus.Any())
                        {
                            foreach (var menu in grupo.Menus.OrderBy(x => x.MenuID))
                            {
                                <div class="menu-node"
                                     data-search="@($"{menu.Nombre} {string.Join(" ", menu.SubMenus.Select(x => x.Nombre))}".ToLowerInvariant())"
                                     data-menu-id="@menu.MenuID">

                                    <div class="menu-node-header">

                                        <div class="menu-node-main"
                                             onclick="toggleMenu(this)">

                                            <div class="menu-node-icon">
                                                <i class="fa-solid fa-folder"></i>
                                            </div>

                                            <div>

                                                <div class="menu-node-name">
                                                    @menu.Nombre
                                                </div>

                                                <div class="menu-node-count">
                                                    @(menu.SubMenus?.Count ?? 0)
                                                    submenú(s)
                                                </div>

                                            </div>

                                            <i class="fa-solid fa-chevron-down menu-toggle ms-auto"></i>

                                        </div>

                                        <div class="menu-actions">

                                            <button type="button"
                                                    class="tree-action success"
                                                    title="Agregar submenú"
                                                    onclick="abrirCrearSubMenu(@menu.MenuID, '@Html.Raw(JavaScriptEncoder.Default.Encode(menu.Nombre))')">
                                                <i class="fa-solid fa-plus"></i>
                                            </button>

                                            <button type="button"
                                                    class="tree-action"
                                                    title="Editar menú"
                                                    onclick="abrirEditarMenu(
                                                                                                        @menu.MenuID,
                                                                                                        @grupo.MenuGrupoID,
                                                                                                        '@Html.Raw(JavaScriptEncoder.Default.Encode(menu.Nombre))')">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <button type="button"
                                                    class="tree-action danger"
                                                    title="Eliminar menú"
                                                    onclick="eliminarMenu(@menu.MenuID, '@Html.Raw(JavaScriptEncoder.Default.Encode(menu.Nombre))')">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>

                                        </div>

                                    </div>

                                    <div class="menu-node-content">

                                        @if (menu.SubMenus != null &&
                                                                menu.SubMenus.Any())
                                        {
                                            foreach (var subMenu in menu.SubMenus.OrderBy(x => x.SubMenuID))
                                            {
                                                var claseSubMenu =
                                                subMenu.Activo
                                                ? ""
                                                : "inactive";

                                                var accionVer =
                                                subMenu.Acciones?.Any(
                                                x => x.Nombre.Equals(
                                                "Ver",
                                                StringComparison.OrdinalIgnoreCase)
                                                && x.PermisoAdministrador) == true;

                                                var accionCrear =
                                                subMenu.Acciones?.Any(
                                                x => x.Nombre.Equals(
                                                "Crear",
                                                StringComparison.OrdinalIgnoreCase)
                                                && x.PermisoAdministrador) == true;

                                                var accionEditar =
                                                subMenu.Acciones?.Any(
                                                x => x.Nombre.Equals(
                                                "Editar",
                                                StringComparison.OrdinalIgnoreCase)
                                                && x.PermisoAdministrador) == true;

                                                var accionEliminar =
                                                subMenu.Acciones?.Any(
                                                x => x.Nombre.Equals(
                                                "Eliminar",
                                                StringComparison.OrdinalIgnoreCase)
                                                && x.PermisoAdministrador) == true;

                                                <div class="submenu-row @claseSubMenu"
                                                     data-search="@($"{subMenu.Nombre} {subMenu.UrlEnlace} {subMenu.Descripcion}".ToLowerInvariant())">

                                                    <div class="submenu-info">

                                                        <div class="submenu-name">
                                                            @subMenu.Nombre

                                                            @if (!subMenu.Activo)
                                                            {
                                                                <span class="badge-status badge-inactive ms-1">
                                                                    Inactivo
                                                                </span>
                                                            }
                                                        </div>

                                                        @if (!string.IsNullOrWhiteSpace(subMenu.Descripcion))
                                                        {
                                                            <div class="submenu-description">
                                                                @subMenu.Descripcion
                                                            </div>
                                                        }

                                <div class="action-chips">

                                    <span class="action-chip @(accionVer ? "enabled" : "")">
                                        <i class="fa-solid @(accionVer ? "fa-check" : "fa-minus")"></i>
                                        Ver
                                    </span>

                                    <span class="action-chip @(accionCrear ? "enabled" : "")">
                                        <i class="fa-solid @(accionCrear ? "fa-check" : "fa-minus")"></i>
                                        Crear
                                    </span>

                                    <span class="action-chip @(accionEditar ? "enabled" : "")">
                                        <i class="fa-solid @(accionEditar ? "fa-check" : "fa-minus")"></i>
                                        Editar
                                    </span>

                                    <span class="action-chip @(accionEliminar ? "enabled" : "")">
                                        <i class="fa-solid @(accionEliminar ? "fa-check" : "fa-minus")"></i>
                                        Eliminar
                                    </span>

                                </div>

                            </div>

                            <div class="submenu-url"
                                 title="@subMenu.UrlEnlace">
                                @(string.IsNullOrWhiteSpace(subMenu.UrlEnlace)
                                                                ? "Sin URL"
                                                                : subMenu.UrlEnlace)
                            </div>

                                                    <div class="submenu-actions-buttons">

                                                        <button type="button"
                                                                class="tree-action"
                                                                title="Editar submenú"
                                                                onclick="abrirEditarSubMenu(
                                                                                                                                            @subMenu.SubMenuID,
                                                                                                                                            @menu.MenuID,
                                                                                                                                            '@Html.Raw(JavaScriptEncoder.Default.Encode(subMenu.Nombre))',
                                                                                                                                            '@Html.Raw(JavaScriptEncoder.Default.Encode(subMenu.UrlEnlace ?? ""))',
                                                                                                                                            '@Html.Raw(JavaScriptEncoder.Default.Encode(subMenu.Descripcion ?? ""))')">
                                                            <i class="fa-solid fa-pen"></i>
                                                        </button>

                                                        <button type="button"
                                                                class="tree-action"
                                                                title="Configurar acciones"
                                                                onclick="abrirAcciones(
                                                                                                                                            @subMenu.SubMenuID,
                                                                                                                                            '@Html.Raw(JavaScriptEncoder.Default.Encode(subMenu.Nombre))',
                                                                                                                                            @(accionVer ? "true" : "false"),
                                                                                                                                            @(accionCrear ? "true" : "false"),
                                                                                                                                            @(accionEditar ? "true" : "false"),
                                                                                                                                            @(accionEliminar ? "true" : "false"))">
                                                            <i class="fa-solid fa-key"></i>
                                                        </button>

                                                        <button type="button"
                                                                class="tree-action"
                                                                title="Configurar permisos por rol"
                                                                onclick="abrirPermisosRol(
                                                                                                                                            @subMenu.SubMenuID,
                                                                                                                                            '@Html.Raw(JavaScriptEncoder.Default.Encode(subMenu.Nombre))')">
                                                            <i class="fa-solid fa-user-shield"></i>
                                                        </button>

                                                        <button type="button"
                                                                class="tree-action @(subMenu.Activo ? "danger" : "success")"
                                                                title="@(subMenu.Activo ? "Desactivar" : "Activar")"
                                                                onclick="cambiarEstadoSubMenu(
                                                                                                                                            @subMenu.SubMenuID,
                                                                                                                                            @(subMenu.Activo ? "false" : "true"))">

                                                            <i class="fa-solid @(subMenu.Activo ? "fa-toggle-on" : "fa-toggle-off")"></i>

                                                        </button>

                                                    </div>

                                                </div>
                                                }
                                        }
                                        else
                                        {
                                            <div class="empty-group">
                                                <i class="fa-regular fa-folder-open"></i>
                                                Este menú todavía no tiene submenús.
                                            </div>
                                        }

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-group">
                                <i class="fa-regular fa-folder-open"></i>
                                Este grupo todavía no tiene menús.
                            </div>
                        }

                    </div>

                </section>
            }
        }
        else
        {
            <div class="empty-group">
                <i class="fa-solid fa-sitemap"></i>
                Todavía no existen grupos de menú.
            </div>
        }

    </div>

</div>


