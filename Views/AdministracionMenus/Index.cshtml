        function filtrarArbol() {

            const termino =
                (
                    document
                        .getElementById('txtBuscarMenu')
                        ?.value
                    ?? ''
                )
                .trim()
                .toLowerCase();


            document
                .querySelectorAll('.group-card')
                .forEach(
                    function (grupo) {

                        if (!termino) {

                            grupo.style.display = '';

                            grupo
                                .querySelectorAll('.menu-node')
                                .forEach(
                                    m =>
                                        m.style.display = ''
                                );

                            grupo
                                .querySelectorAll('.submenu-row')
                                .forEach(
                                    s =>
                                        s.style.display = ''
                                );

                            return;

                        }


                        const textoGrupo =
                            grupo.dataset.search
                            ?? '';


                        let grupoCoincide =
                            textoGrupo.includes(
                                termino
                            );


                        let tieneCoincidencias =
                            grupoCoincide;


                        grupo
                            .querySelectorAll('.menu-node')
                            .forEach(
                                function (menu) {

                                    const textoMenu =
                                        menu.dataset.search
                                        ?? '';

                                    let menuCoincide =
                                        textoMenu.includes(
                                            termino
                                        );

                                    let subCoincide =
                                        false;


                                    menu
                                        .querySelectorAll('.submenu-row')
                                        .forEach(
                                            function (sub) {

                                                const textoSub =
                                                    sub.dataset.search
                                                    ?? '';

                                                const coincide =
                                                    textoSub.includes(
                                                        termino
                                                    );

                                                sub.style.display =
                                                    coincide ||
                                                    menuCoincide ||
                                                    grupoCoincide
                                                        ? ''
                                                        : 'none';

                                                if (coincide)
                                                    subCoincide = true;

                                            }
                                        );


                                    const mostrarMenu =
                                        menuCoincide ||
                                        subCoincide ||
                                        grupoCoincide;


                                    menu.style.display =
                                        mostrarMenu
                                            ? ''
                                            : 'none';


                                    if (mostrarMenu) {

                                        tieneCoincidencias =
                                            true;

                                        grupo
                                            .classList
                                            .add('open');

                                        menu
                                            .classList
                                            .add('open');

                                    }

                                }
                            );


                        grupo.style.display =
                            tieneCoincidencias
                                ? ''
                                : 'none';

                    }
                );

        }


