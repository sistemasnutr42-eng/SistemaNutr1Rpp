                        MenuID: menuId,
                        Nombre: nombre,
                        UrlEnlace: url,
                        Descripcion: descripcion,
                        RolIDs: rolIds,
                        Ver: ver,
                        Crear: crear,
                        Editar: editar,
                        Eliminar: eliminar
                    });
